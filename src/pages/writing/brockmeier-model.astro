---
// The Brockmeier Model: a lifecycle portfolio model priced off November 2026 yields.
// Text lives in src/data/model2026.ts, figures in src/data/model2026-figures.ts, and
// every model number in src/data/model2026-data.json (written by scripts/model/build.mjs).
// The PDF at /writing/brockmeier-model.pdf is printed from this page.
import Base from '../../layouts/Base.astro';
import BarChart from '../../components/charts/BarChart.astro';
import Table from '../../components/charts/Table.astro';
import Lines from '../../components/charts/model/Lines.astro';
import Heatmap from '../../components/charts/model/Heatmap.astro';
import Stack from '../../components/charts/model/Stack.astro';
import StackBars from '../../components/charts/model/StackBars.astro';
import NotedTable from '../../components/charts/model/NotedTable.astro';
import ModelCalculator from '../../components/charts/model/ModelCalculator.astro';
import { model2026 as paper, type Block } from '../../data/model2026';
import { figures } from '../../data/model2026-figures';
import { cite } from '../../components/charts/lib';
import { site } from '../../data/profile';

// Number charts and tables separately, in reading order.
const isTable = (id: string) => figures[id].kind === 'table' || figures[id].kind === 'noted';
const numbers: Record<string, number> = {};
let nFig = 0;
let nTab = 0;
for (const s of paper.sections)
  for (const b of s.blocks)
    if ('fig' in b) numbers[b.fig] = isTable(b.fig) ? ++nTab : ++nFig;

// {fig:id} and {tab:id} in the text and in figure notes become "Figure 3" or "Table 2".
const refs = (text: string) =>
  text.replace(/\{(?:fig|tab):(\w+)\}/g, (_m, id: string) => {
    if (!(id in numbers)) throw new Error(`Unknown figure reference: ${id}`);
    return `${isTable(id) ? 'Table' : 'Figure'} ${numbers[id]}`;
  });
const deep = (v: unknown): unknown =>
  typeof v === 'string' ? refs(v) : Array.isArray(v) ? v.map(deep) : v && typeof v === 'object' ? Object.fromEntries(Object.entries(v).map(([k, x]) => [k, deep(x)])) : v;
const html = (text: string) => cite(refs(text));

const strip = (h: string) => h.replace(/<[^>]+>/g, ' ').replace(/\[[\d,\s–-]+\]/g, ' ');
const blockText = (b: Block) =>
  'p' in b ? b.p : 'h3' in b ? b.h3 : 'list' in b ? b.list.join(' ') : 'eq' in b ? `${b.eq} ${b.caption ?? ''}` : '';
const allText = [...paper.keyPoints, paper.take, ...paper.sections.flatMap((s) => [s.heading, ...s.blocks.map(blockText)])].map(strip).join(' ');
const words = allText.split(/\s+/).filter(Boolean).length;
const minutes = Math.round(words / 230);
const host = (u: string) => u.replace(/^https?:\/\//, '').replace(/\/$/, '').split(/[/?]/)[0];
---

<Base title={`${paper.title} | ${site.name}`} description={paper.description} theme="paper" serif>
  <div class="toolbar">
    <a href="/" class="back">Back to the game</a>
    <span class="actions">
      <a class="btn" href={paper.pdf}>PDF</a>
      <a class="btn ghost" href={paper.companion}>Companion paper</a>
    </span>
  </div>

  <main class="paper">
    <header>
      <p class="kicker">Paper · {paper.published}</p>
      <h1>{paper.title}</h1>
      <p class="dek">{paper.subtitle}</p>
      <p class="byline">{site.name} · {minutes} min read · {nFig} charts, {nTab} tables</p>
      <p class="versions">
        Prices as of November 9, 2026 · Companion: <a href={paper.companion}>{paper.companionTitle}</a>
      </p>
      <p class="disclaimer">{paper.disclaimer}</p>
    </header>

    <section class="abstract" aria-labelledby="summary">
      <h2 id="summary">Summary</h2>
      <ul class="keypoints">
        {paper.keyPoints.map((k) => <li set:html={html(k)} />)}
      </ul>
      <p class="take" set:html={html(paper.take)} />
    </section>

    <nav class="toc" aria-label="Contents">
      <ol>
        {
          paper.sections.map((s) => (
            <li>
              <a href={`#${s.id}`}>{s.heading}</a>
            </li>
          ))
        }
        <li class="unnumbered">
          <a href="#sources">Sources</a>
        </li>
      </ol>
    </nav>

    <article class="body">
      {
        paper.sections.map((s, si) => (
          <section aria-labelledby={s.id}>
            <h2 id={s.id}>
              <span class="num">{si + 1}.</span> {s.heading}
            </h2>
            {s.blocks.map((b) => {
              if ('p' in b) return <p set:html={html(b.p)} />;
              if ('h3' in b) return <h3>{b.h3}</h3>;
              if ('eq' in b)
                return (
                  <div class="eq">
                    <p class="eq-line" set:html={b.eq} />
                    {b.caption && <p class="eq-caption" set:html={html(b.caption)} />}
                  </div>
                );
              if ('list' in b)
                return b.ordered ? (
                  <ol class="steps">
                    {b.list.map((i) => (
                      <li set:html={html(i)} />
                    ))}
                  </ol>
                ) : (
                  <ul class="bullets">
                    {b.list.map((i) => (
                      <li set:html={html(i)} />
                    ))}
                  </ul>
                );
              if ('calc' in b) return <ModelCalculator id="calculator" />;
              const f = figures[b.fig];
              const p = { id: `fig-${b.fig}`, n: numbers[b.fig], ...(deep(f.props) as object) } as any;
              if (f.kind === 'bar') return <BarChart {...p} />;
              if (f.kind === 'lines') return <Lines {...p} />;
              if (f.kind === 'heat') return <Heatmap {...p} />;
              if (f.kind === 'stack') return <Stack {...p} />;
              if (f.kind === 'stackbars') return <StackBars {...p} />;
              if (f.kind === 'noted') return <NotedTable {...p} />;
              return <Table {...p} />;
            })}
          </section>
        ))
      }

      <section class="sources" aria-labelledby="sources">
        <h2 id="sources">Sources</h2>
        <p class="sources-note">
          Public sources only. Where I could not read a provider’s own page and used a republished copy, the entry says so. Figures labeled as my
          arithmetic, calculation or simulation come from <code>scripts/model</code> in this site’s repository, which downloads the cited data and
          re-runs the model.
        </p>
        <ol>
          {
            paper.sources.map((s) => (
              <li id={`src-${s.n}`}>
                <span class="n">{s.n}.</span>
                <span>
                  {s.text}
                  {s.url && (
                    <>
                      {' '}
                      <a href={s.url}>{host(s.url)}</a>
                    </>
                  )}
                </span>
              </li>
            ))
          }
        </ol>
      </section>
    </article>
  </main>
</Base>

<style is:global>
  body.paper {
    --bg: #fbf7ee;
    --ink: #1b1533;
    --ink-soft: #4f4868;
    --rule: #e2dccd;
    --accent: #7a3460;
    background: var(--bg);
    color: var(--ink);
  }

  body.paper a {
    color: var(--accent);
  }

  body.paper :focus-visible {
    outline-color: var(--accent);
  }
</style>

<style>
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-xs);
    max-width: 760px;
    margin: 0 auto;
    padding: var(--space-m) var(--gutter) 0;
  }

  .back {
    font-family: var(--font-pixel);
    font-size: var(--step-1);
    font-size-adjust: cap-height 0.7;
  }

  .actions {
    display: flex;
    gap: var(--space-xs);
  }

  .btn {
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--accent);
    border-radius: 4px;
    background: var(--accent);
    color: #fff !important;
    font-size: var(--label);
    font-weight: 600;
    text-decoration: none;
  }

  .btn.ghost {
    border-color: var(--rule);
    background: #fff;
    color: var(--ink) !important;
  }

  .paper {
    max-width: 760px;
    margin: var(--space-m) auto var(--space-2xl);
    padding: clamp(1.5rem, 5vw, 3.5rem) var(--gutter);
    background: #fff;
    border: 1px solid var(--rule);
    border-radius: 6px;
  }

  .kicker {
    color: var(--accent);
    font-size: var(--label);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin-top: 6px;
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(1.9rem, 1.3rem + 2.4vw, 2.75rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .dek {
    margin-top: 0.5rem;
    color: var(--ink-soft);
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(1.1rem, 1rem + 0.5vw, 1.3rem);
    font-style: italic;
    line-height: 1.35;
    text-wrap: balance;
  }

  .byline,
  .versions {
    margin-top: var(--space-xs);
    color: var(--ink-soft);
    font-size: var(--label);
  }

  .versions {
    margin-top: 2px;
  }

  .disclaimer {
    margin-top: var(--space-s);
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--rule);
    border-radius: 4px;
    color: var(--ink-soft);
    font-size: 0.75rem;
    line-height: 1.45;
  }

  .abstract {
    margin-top: var(--space-m);
    padding: var(--space-s) var(--space-m) var(--space-m);
    background: #f6f1e4;
    border-left: 4px solid var(--accent);
  }

  .abstract h2,
  .toc::before {
    color: var(--accent);
    font-size: var(--label);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .keypoints {
    display: grid;
    gap: 0.7rem;
    margin-top: 0.6rem;
    padding: 0;
    list-style: none;
    counter-reset: kp;
  }

  .keypoints li {
    position: relative;
    padding-left: 1.9rem;
    font-size: 0.9375rem;
    line-height: 1.5;
    counter-increment: kp;
  }

  .keypoints li::before {
    content: counter(kp);
    position: absolute;
    top: 0.1em;
    left: 0;
    display: grid;
    place-items: center;
    width: 1.35rem;
    height: 1.35rem;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .take {
    margin-top: var(--space-s);
    padding-top: var(--space-s);
    border-top: 1px solid #e4dcc8;
    font-family: var(--font-serif, Georgia, serif);
    font-size: 1.0625rem;
    line-height: 1.55;
  }

  .toc {
    margin-top: var(--space-m);
  }

  .toc::before {
    content: 'Contents';
    display: block;
  }

  .toc ol {
    columns: 2 16rem;
    margin-top: 6px;
    padding-left: 1.4em;
    list-style: decimal;
    font-size: var(--label);
    line-height: 1.7;
  }

  .toc li.unnumbered {
    list-style: none;
  }

  .body {
    margin-top: var(--space-l);
    font-family: var(--font-serif, Georgia, serif);
    font-size: 1.0625rem;
    line-height: 1.65;
  }

  .body > section + section {
    margin-top: var(--space-xl);
  }

  .body h2 {
    font-family: var(--font-sans);
    font-size: var(--step-2);
    font-weight: 700;
    line-height: 1.2;
    scroll-margin-top: var(--space-m);
  }

  .body h2 .num {
    color: var(--accent);
  }

  .body h3 {
    margin-top: 1.6em;
    font-family: var(--font-sans);
    font-size: var(--step-1);
    font-weight: 700;
    line-height: 1.25;
  }

  .body p {
    margin-top: 0.75em;
    text-wrap: pretty;
  }

  .body h3 + p {
    margin-top: 0.4em;
  }

  .eq {
    margin: 1em 0;
    padding: 0.8rem 1rem;
    background: #faf7f0;
    border-radius: 4px;
  }

  .body .eq-line {
    margin: 0;
    font-size: 1.05rem;
    font-style: italic;
    line-height: 1.6;
    text-align: center;
    text-wrap: balance;
  }

  .body .eq-caption {
    margin-top: 0.5rem;
    color: var(--ink-soft);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    line-height: 1.45;
  }

  .eq sub,
  .eq sup {
    font-size: 0.72em;
    line-height: 0;
  }

  .bullets,
  .steps {
    margin-top: 0.75em;
    padding-left: 1.3em;
  }

  .bullets {
    list-style: disc;
  }

  .steps {
    list-style: decimal;
  }

  .bullets li + li,
  .steps li + li {
    margin-top: 0.45em;
  }

  .bullets li::marker,
  .steps li::marker {
    color: var(--accent);
  }

  .sources-note {
    color: var(--ink-soft);
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .sources ol {
    margin-top: 0.75em;
    padding: 0;
    list-style: none;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .sources li {
    display: grid;
    grid-template-columns: 2em 1fr;
    gap: 0.25em;
    overflow-wrap: anywhere;
    scroll-margin-top: var(--space-m);
  }

  .sources li + li {
    margin-top: 0.45em;
  }

  .sources li:target {
    background: #f7eef3;
  }

  .sources .n {
    color: var(--ink-soft);
    font-variant-numeric: lining-nums;
    text-align: right;
  }

  .body p a,
  .body li a {
    text-underline-offset: 2px;
  }

  .eq sub sup,
  .eq sup sub {
    font-size: 1em;
  }

  @media print {
    @page {
      size: Letter;
      margin: 0.7in 0.75in;
    }

    .toolbar,
    .toc {
      display: none;
    }

    .paper {
      margin: 0;
      padding: 0;
      border: 0;
    }

    .keypoints li,
    .take,
    .eq,
    .disclaimer {
      break-inside: avoid;
    }

    .body {
      font-size: 10.5pt;
      line-height: 1.5;
    }

    .body h2,
    .body h3 {
      break-after: avoid;
    }

    .body > section + section {
      margin-top: 1.4rem;
    }

    .sources ol {
      font-size: 7.5pt;
    }

    a {
      color: inherit;
    }

    /* Legend keys are CSS backgrounds, which a printer drops unless told otherwise. */
    .body :global(.chart-legend .key) {
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
  }

  /* Row labels in the liquidity table stay on one line where there is room, so it fits a printed page. */
  @media (min-width: 700px), print {
    .body :global(#fig-liq tbody th) {
      white-space: nowrap;
    }
  }
</style>
