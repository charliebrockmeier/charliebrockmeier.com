---
// The Brockmeier Model: a lifecycle portfolio model priced off November 2026 yields.
// Text lives in src/data/model2026.ts, figures in src/data/model2026-figures.ts, and
// every model number in src/data/model2026-data.json (written by scripts/model/build.mjs).
// Laid out as a research paper: title block, abstract, numbered sections and subsections,
// numbered equations, lettered appendices and references. A side contents column (wide
// screens) or a running head (narrow ones) shows where the reader is.
// The PDF at /writing/brockmeier-model.pdf is printed from this page.
import Base from '../../layouts/Base.astro';
import BarChart from '../../components/charts/BarChart.astro';
import Table from '../../components/charts/Table.astro';
import Lines from '../../components/charts/model/Lines.astro';
import Heatmap from '../../components/charts/model/Heatmap.astro';
import Stack from '../../components/charts/model/Stack.astro';
import StackBars from '../../components/charts/model/StackBars.astro';
import NotedTable from '../../components/charts/model/NotedTable.astro';
import ModelCalculator from '../../components/charts/model/ModelCalculator.astro';
import { model2026 as paper, type Block } from '../../data/model2026';
import { figures } from '../../data/model2026-figures';
import { cite } from '../../components/charts/lib';
import { site } from '../../data/profile';

// Sections are numbered 1..N; appendices are lettered A, B, C.
const body = paper.sections.filter((s) => !s.appendix);
const appendices = paper.sections.filter((s) => s.appendix);
const label: Record<string, string> = {};
body.forEach((s, i) => (label[s.id] = String(i + 1)));
appendices.forEach((s, i) => (label[s.id] = String.fromCharCode(65 + i)));
const isAppendix = (id: string) => appendices.some((s) => s.id === id);

// Subsections are numbered within their section (2.1, 2.2; A.1) and get ids for the contents.
type Sub = { id: string; num: string; title: string };
const subs: Record<string, Sub[]> = {};
for (const s of paper.sections) {
  let k = 0;
  subs[s.id] = s.blocks.flatMap((b) => ('h3' in b ? [{ id: `${s.id}-${++k}`, num: `${label[s.id]}.${k}`, title: b.h3 }] : []));
}

// Charts and tables are numbered separately, and equations in one series, all in reading order.
const isTable = (id: string) => figures[id].kind === 'table' || figures[id].kind === 'noted';
const numbers: Record<string, number> = {};
let nFig = 0;
let nTab = 0;
let nEq = 0;
const eqNo = new Map<Block, number>();
for (const s of paper.sections)
  for (const b of s.blocks) {
    if ('fig' in b) numbers[b.fig] = isTable(b.fig) ? ++nTab : ++nFig;
    if ('eq' in b) eqNo.set(b, ++nEq);
  }

// {fig:id}, {tab:id} and {sec:id} in any text become "Figure 3", "Table 2", "Section 4" or "Appendix A".
const refs = (text: string) =>
  text.replace(/\{(fig|tab|sec):([\w-]+)\}/g, (_m, kind: string, id: string) => {
    if (kind === 'sec') {
      if (!(id in label)) throw new Error(`Unknown section reference: ${id}`);
      return `<a href="#${id}">${isAppendix(id) ? 'Appendix' : 'Section'} ${label[id]}</a>`;
    }
    if (!(id in numbers)) throw new Error(`Unknown figure reference: ${id}`);
    return `${isTable(id) ? 'Table' : 'Figure'} ${numbers[id]}`;
  });
// Figure props are plain text, so section references there become plain words.
const plainRefs = (text: string) => refs(text).replace(/<a href="#[\w-]+">([^<]+)<\/a>/g, '$1');
const deep = (v: unknown): unknown =>
  typeof v === 'string'
    ? plainRefs(v)
    : Array.isArray(v)
      ? v.map(deep)
      : v && typeof v === 'object'
        ? Object.fromEntries(Object.entries(v).map(([k, x]) => [k, deep(x)]))
        : v;
const html = (text: string) => cite(refs(text));

const strip = (h: string) => h.replace(/<[^>]+>/g, ' ').replace(/\[[\d,\s–-]+\]/g, ' ');
const blockText = (b: Block) =>
  'p' in b ? b.p : 'h3' in b ? b.h3 : 'list' in b ? b.list.join(' ') : 'eq' in b ? `${b.eq} ${b.caption ?? ''}` : '';
const allText = [paper.abstract, ...paper.sections.flatMap((s) => [s.heading, ...s.blocks.map(blockText)])].map(strip).join(' ');
const minutes = Math.round(allText.split(/\s+/).filter(Boolean).length / 230);
const host = (u: string) => u.replace(/^https?:\/\//, '').replace(/\/$/, '').split(/[/?]/)[0];

// What the contents column and the running head can point at, in order.
const outline = [
  ...paper.sections.flatMap((s) => [
    { id: s.id, num: label[s.id], title: s.heading, level: 2, section: s.id },
    ...subs[s.id].map((x) => ({ id: x.id, num: x.num, title: x.title, level: 3, section: s.id })),
  ]),
  { id: 'references', num: '', title: 'References', level: 2, section: 'references' },
];

const renderSection = (s: (typeof paper.sections)[number]) => {
  let k = 0;
  return { s, blocks: s.blocks.map((b) => ({ b, sub: 'h3' in b ? subs[s.id][k++] : undefined })) };
};
---

<Base title={`${paper.title} | ${site.name}`} description={paper.description} theme="paper" serif>
  <nav class="topbar" aria-label="Site">
    <a href="/">← {site.name}</a>
    <span>
      <a href={paper.pdf}>PDF</a>
      <span aria-hidden="true">·</span>
      <a href={paper.companion}>Companion paper</a>
    </span>
  </nav>

  <p class="running" aria-hidden="true" data-running>
    <a href="#contents"><span class="r-sec" data-r-sec></span><span class="r-sub" data-r-sub></span></a>
  </p>

  <nav class="side" aria-label="Paper sections" data-side>
    <p class="side-title">{paper.title}</p>
    <ol>
      {
        outline.map((o) => (
          <li class:list={[`l${o.level}`]} data-for={o.id} data-section={o.section}>
            <a href={`#${o.id}`}>
              {o.num && <span class="n">{o.num}</span>}
              {o.title}
            </a>
          </li>
        ))
      }
    </ol>
  </nav>

  <main class="paper">
    <header class="titleblock">
      <h1>{paper.title}</h1>
      <p class="subtitle">{paper.subtitle}</p>
      <p class="author">{site.name}</p>
      <p class="date">{paper.published} · Prices as of November 9, 2026</p>
      <p class="companion">
        Companion paper: <a href={paper.companion}>{paper.companionTitle}</a> · <a href={paper.pdf}>PDF</a> · {minutes} min read
      </p>
    </header>

    <section class="abstract" aria-labelledby="abstract">
      <h2 id="abstract">Abstract</h2>
      <p set:html={html(paper.abstract)} />
      <p class="meta"><em>Keywords:</em> {paper.keywords}</p>
      <p class="meta"><em>JEL classification:</em> {paper.jel}</p>
    </section>

    <p class="disclaimer">{paper.disclaimer}</p>

    <nav class="toc" id="contents" aria-labelledby="contents-title">
      <h2 id="contents-title">Contents</h2>
      <ol>
        {
          body.map((s) => (
            <li>
              <a href={`#${s.id}`}>
                <span class="n">{label[s.id]}</span>
                {s.heading}
              </a>
            </li>
          ))
        }
        {
          appendices.map((s) => (
            <li>
              <a href={`#${s.id}`}>
                <span class="n">{label[s.id]}</span>
                Appendix: {s.heading}
              </a>
            </li>
          ))
        }
        <li>
          <a href="#references"><span class="n"></span>References</a>
        </li>
      </ol>
    </nav>

    <article class="body">
      {
        paper.sections.map((section, si) => {
          const { s, blocks } = renderSection(section);
          return (
            <section aria-labelledby={s.id} class:list={{ appendix: s.appendix, 'first-appendix': s.appendix && appendices[0].id === s.id }}>
              {s.appendix && appendices[0].id === s.id && <p class="appendix-divider">Appendices</p>}
              <h2 id={s.id} data-h>
                <span class="num">{label[s.id]}</span>{' '}
                {s.heading}
              </h2>
              {blocks.map(({ b, sub }) => {
                if ('p' in b) return <p set:html={html(b.p)} />;
                if ('h3' in b)
                  return (
                    <h3 id={sub!.id} data-h>
                      <span class="num">{sub!.num}</span>{' '}
                      {b.h3}
                    </h3>
                  );
                if ('eq' in b)
                  return (
                    <div class="eq">
                      <p class="eq-line" set:html={b.eq} />
                      <p class="eq-no">({eqNo.get(b)})</p>
                      {b.caption && <p class="eq-caption" set:html={`<em>where</em> ${html(b.caption)}`} />}
                    </div>
                  );
                if ('list' in b)
                  return b.ordered ? (
                    <ol class="steps">
                      {b.list.map((i) => (
                        <li set:html={html(i)} />
                      ))}
                    </ol>
                  ) : (
                    <ul class="bullets">
                      {b.list.map((i) => (
                        <li set:html={html(i)} />
                      ))}
                    </ul>
                  );
                if ('calc' in b) return <ModelCalculator id="calculator" />;
                const f = figures[b.fig];
                const p = { id: `fig-${b.fig}`, n: numbers[b.fig], ...(deep(f.props) as object) } as any;
                if (f.kind === 'bar') return <BarChart {...p} />;
                if (f.kind === 'lines') return <Lines {...p} />;
                if (f.kind === 'heat') return <Heatmap {...p} />;
                if (f.kind === 'stack') return <Stack {...p} />;
                if (f.kind === 'stackbars') return <StackBars {...p} />;
                if (f.kind === 'noted') return <NotedTable {...p} />;
                return <Table {...p} />;
              })}
            </section>
          );
        })
      }

      <section class="references" aria-labelledby="references">
        <h2 id="references" data-h>References</h2>
        <p class="references-note">
          Public sources only, numbered in order of first citation. Where I could not read a provider’s own page and used a republished copy, the entry
          says so. Figures labeled as my arithmetic, calculation or simulation come from <code>scripts/model</code> in this site’s repository.
        </p>
        <ol>
          {
            paper.sources.map((s) => (
              <li id={`src-${s.n}`}>
                <span class="n">[{s.n}]</span>
                <span>
                  {s.text}
                  {s.url && (
                    <>
                      {' '}
                      <a href={s.url}>{host(s.url)}</a>
                    </>
                  )}
                </span>
              </li>
            ))
          }
        </ol>
      </section>
    </article>
  </main>
</Base>

<script>
  // Where am I: the last heading above the top of the screen lights up in the side
  // contents (wide screens) and names itself in the running head (narrow ones).
  const heads = [...document.querySelectorAll<HTMLElement>('.body [data-h]')];
  const side = document.querySelector<HTMLElement>('[data-side]');
  const running = document.querySelector<HTMLElement>('[data-running]');
  const rSec = document.querySelector<HTMLElement>('[data-r-sec]');
  const rSub = document.querySelector<HTMLElement>('[data-r-sub]');
  const contents = document.getElementById('contents');
  const items = new Map([...(side?.querySelectorAll<HTMLElement>('li[data-for]') ?? [])].map((li) => [li.dataset.for!, li]));
  const textOf = (el: HTMLElement) => el.textContent!.replace(/^Appendix\s*/, '').replace(/\s+/g, ' ').trim();
  let current = '';
  let ticking = false;

  const update = () => {
    ticking = false;
    const line = 90;
    let at: HTMLElement | undefined;
    for (const h of heads) {
      if (h.getBoundingClientRect().top - line > 0) break;
      at = h;
    }
    const past = contents ? contents.getBoundingClientRect().bottom < 0 : false;
    running?.classList.toggle('show', past && !!at);
    side?.classList.toggle('show', past);
    const id = at?.id ?? '';
    if (id === current) return;
    current = id;
    // The section is the nearest h2 at or above this heading.
    const idx = at ? heads.indexOf(at) : -1;
    const sec = idx >= 0 ? heads.slice(0, idx + 1).reverse().find((h) => h.tagName === 'H2') : undefined;
    if (rSec) rSec.textContent = sec ? textOf(sec) : '';
    if (rSub) rSub.textContent = at && at.tagName === 'H3' ? textOf(at) : '';
    for (const [key, li] of items) {
      li.classList.toggle('active', key === id || (!!sec && key === sec.id && at?.tagName === 'H2'));
      li.classList.toggle('open', !!sec && li.dataset.section === sec.id);
      li.classList.toggle('in', !!sec && key === sec.id);
    }
    items.get(id)?.scrollIntoView({ block: 'nearest' });
  };

  addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    },
    { passive: true },
  );
  update();
</script>

<style is:global>
  body.paper {
    --bg: #fff;
    --ink: #161616;
    --ink-soft: #555;
    --rule: #d6d6d6;
    --accent: #1d4477;
    background: #fff;
    color: var(--ink);
  }

  body.paper a {
    color: var(--accent);
  }

  body.paper :focus-visible {
    outline-color: var(--accent);
  }

  /* Figures and tables in a plain academic frame: black rules, no color in the labels. */
  .paper .chart {
    margin: 2.2rem 0;
    padding: 0.9rem 0 0.8rem;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
  }

  .paper .chart-n {
    color: var(--ink);
  }

  .paper .chart-title {
    font-size: 0.95rem;
  }

  .paper .chart-sub,
  .paper .chart-note,
  .paper .chart-source {
    color: var(--ink-soft);
  }

  .paper .chart-data summary {
    color: var(--ink-soft);
  }
</style>

<style>
  /* ---- Top line: plain links, like a preprint server's header */
  .topbar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.4rem 1rem;
    max-width: 800px;
    margin: 0 auto;
    padding: 1rem var(--gutter) 0.8rem;
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-sans);
    font-size: 0.8125rem;
  }

  .topbar span {
    display: flex;
    gap: 0.5rem;
    color: var(--ink-soft);
  }

  .topbar a {
    text-decoration: none;
  }

  .topbar a:hover {
    text-decoration: underline;
  }

  /* ---- The page */
  .paper {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 var(--gutter) 5rem;
    font-family: var(--font-serif, Georgia, serif);
  }

  .titleblock {
    margin-top: clamp(2rem, 6vw, 3.5rem);
    text-align: center;
  }

  h1 {
    font-size: clamp(1.9rem, 1.4rem + 2vw, 2.5rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .subtitle {
    max-width: 34em;
    margin: 0.5rem auto 0;
    font-size: clamp(1.05rem, 1rem + 0.4vw, 1.2rem);
    line-height: 1.4;
    text-wrap: balance;
  }

  .author {
    margin-top: 1.4rem;
    font-size: 1.1rem;
    font-variant: small-caps;
    letter-spacing: 0.03em;
  }

  .date,
  .companion {
    margin-top: 0.25rem;
    color: var(--ink-soft);
    font-size: 0.9rem;
  }

  .abstract {
    max-width: 36rem;
    margin: 2.2rem auto 0;
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .abstract h2 {
    margin-bottom: 0.5rem;
    font-size: 0.95rem;
    font-variant: small-caps;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-align: center;
  }

  .abstract p {
    hyphens: auto;
  }

  .abstract .meta {
    margin-top: 0.45rem;
    font-size: 0.85rem;
    hyphens: manual;
    text-align: left;
  }

  .disclaimer {
    max-width: 36rem;
    margin: 1.6rem auto 0;
    padding-top: 0.6rem;
    border-top: 1px solid var(--rule);
    color: var(--ink-soft);
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .toc {
    margin-top: 2.4rem;
    padding: 1rem 0;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
  }

  .toc h2 {
    font-size: 0.95rem;
    font-variant: small-caps;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .toc ol {
    margin-top: 0.5rem;
    padding: 0;
    list-style: none;
    columns: 2 18rem;
    column-gap: 2rem;
    font-size: 0.92rem;
    line-height: 1.45;
  }

  .toc li {
    break-inside: avoid;
    padding: 0.12rem 0;
  }

  .toc a {
    display: grid;
    grid-template-columns: 1.6rem 1fr;
    color: var(--ink);
    text-decoration: none;
  }

  .toc a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .toc .n {
    font-variant-numeric: lining-nums tabular-nums;
  }

  /* ---- Body text */
  .body {
    font-size: 1.0625rem;
    line-height: 1.62;
  }

  .body h2 {
    display: flex;
    gap: 0.7em;
    margin-top: 2.8rem;
    font-size: 1.4rem;
    font-weight: 700;
    line-height: 1.25;
    scroll-margin-top: 3.5rem;
  }

  .body h3 {
    display: flex;
    gap: 0.6em;
    margin-top: 1.8rem;
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.3;
    scroll-margin-top: 3.5rem;
  }

  .body .num {
    flex: none;
    font-variant-numeric: lining-nums;
  }

  .body p {
    margin-top: 0.75em;
    text-wrap: pretty;
  }

  .body h2 + p,
  .body h3 + p {
    margin-top: 0.5em;
  }

  @media (min-width: 700px) {
    .body p,
    .body li,
    .abstract p:not(.meta) {
      text-align: justify;
      hyphens: auto;
    }
  }

  /* Numbered display equations, with the notation set as a "where" clause. */
  .eq {
    display: grid;
    grid-template-columns: 2.5rem 1fr 2.5rem;
    align-items: center;
    margin: 1.2em 0;
  }

  .body .eq-line {
    grid-column: 2;
    margin: 0;
    font-size: 1.05rem;
    font-style: italic;
    line-height: 1.6;
    text-align: center;
    text-wrap: balance;
  }

  .body .eq-no {
    grid-column: 3;
    margin: 0;
    font-style: normal;
    text-align: right;
  }

  .body .eq-caption {
    grid-column: 1 / -1;
    margin-top: 0.45rem;
    color: var(--ink-soft);
    font-size: 0.875rem;
    line-height: 1.5;
    text-align: left;
  }

  .eq sub,
  .eq sup {
    font-size: 0.72em;
    line-height: 0;
  }

  .eq sub sup,
  .eq sup sub {
    font-size: 1em;
  }

  .bullets,
  .steps {
    margin-top: 0.75em;
    padding-left: 1.5em;
  }

  .bullets {
    list-style: disc;
  }

  .steps {
    list-style: decimal;
  }

  .bullets li + li,
  .steps li + li {
    margin-top: 0.5em;
  }

  .body p a,
  .body li a {
    text-underline-offset: 2px;
  }

  /* ---- Appendices and references */
  .appendix-divider {
    margin-top: 3.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--ink);
    font-size: 0.95rem;
    font-variant: small-caps;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-align: center;
  }

  .body .appendix h2 .num::before {
    content: 'Appendix ';
  }

  .references h2 {
    margin-top: 3.2rem;
  }

  .references-note {
    color: var(--ink-soft);
    font-size: 0.85rem !important;
    line-height: 1.5;
    text-align: left !important;
  }

  .references ol {
    margin-top: 0.8em;
    padding: 0;
    list-style: none;
    font-size: 0.85rem;
    line-height: 1.45;
  }

  .references li {
    display: grid;
    grid-template-columns: 2.6em 1fr;
    gap: 0.2em;
    overflow-wrap: anywhere;
    text-align: left !important;
    scroll-margin-top: 3.5rem;
  }

  .references li + li {
    margin-top: 0.4em;
  }

  .references li:target {
    background: #fff6d6;
  }

  .references .n {
    color: var(--ink-soft);
    font-variant-numeric: lining-nums;
  }

  /* ---- The calculator, as a plain results table rather than cards */
  .body :global(.calc-out) {
    gap: 0;
    border-top: 1px solid var(--rule);
  }

  .body :global(.calc-out div),
  .body :global(.calc-out div.key) {
    border: 0;
    border-bottom: 1px solid var(--rule);
    border-radius: 0;
    background: none;
  }

  .body :global(.calc-out dd[data-out]:not(.hint)) {
    font-size: 1.25rem;
  }

  /* ---- Where am I: side contents on wide screens, a running head on narrow ones */
  .side,
  .running {
    display: none;
    font-family: var(--font-sans);
  }

  @media (min-width: 1300px) {
    .side {
      position: fixed;
      top: 1.5rem;
      left: max(1rem, calc(50% - 400px - 270px));
      display: block;
      width: 250px;
      max-height: calc(100vh - 3rem);
      overflow-y: auto;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.2s;
      font-size: 0.78rem;
      line-height: 1.35;
      scrollbar-width: thin;
    }

    .side:global(.show) {
      opacity: 1;
      visibility: visible;
    }

    .side-title {
      margin-bottom: 0.5rem;
      color: var(--ink-soft);
      font-weight: 600;
    }

    .side ol {
      padding: 0;
      list-style: none;
    }

    .side li a {
      display: grid;
      grid-template-columns: 2.1rem 1fr;
      padding: 0.18rem 0.5rem;
      border-left: 2px solid transparent;
      color: var(--ink-soft);
      text-decoration: none;
    }

    .side li a:hover {
      color: var(--ink);
    }

    .side li.l3 {
      display: none;
    }

    .side li.l3:global(.open) {
      display: block;
    }

    .side li.l3 a {
      padding-left: 1.4rem;
      grid-template-columns: 2.1rem 1fr;
