---
// Contact: the page to send someone who wants to reach Charlie (/recruiter redirects
// here). Email first, with a copy button; then the facts at a glance, the road so far
// as a row of logos, the other places to find him, and a draft-an-email form that
// opens the visitor's own mail app. Same pixel style as the main page.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import type { LogoName } from '../data/logos';
import photo from '../assets/photo/source.jpg';
import { character, email, links, quests, resumePdf, site } from '../data/profile';

const elsewhere = links.filter((l) => l.label !== 'Email');
const capstones = quests.flatMap((q) => q.highlights ?? []);
const facts: { title: string; line: string; logo?: LogoName; icon?: 'cap' | 'chip' | 'chart'; color?: string }[] = [
  { title: 'UNL, class of 2025', line: 'Finance and accounting, minors in CS and math. High Distinction.', logo: 'unl' },
  ...capstones.map((c, i) => ({ title: c.role, line: `${c.org}. ${c.what}`, icon: (i ? 'chart' : 'chip') as 'chart' | 'chip', color: i ? 'violet' : 'teal' })),
  { title: 'Now at MSCI', line: 'New York. Joined when MSCI acquired Vantager in March 2026.', logo: 'msci' },
];
const road: { logo: LogoName; year: string; now?: boolean }[] = [
  { logo: 'cashwa', year: '2021' },
  { logo: 'buckle', year: '2022' },
  { logo: 'covisum', year: '2023' },
  { logo: 'threebridge', year: '2024' },
  { logo: 'vantager', year: '2025' },
  { logo: 'msci', year: '2026', now: true },
];
const topics = [
  { label: 'Just saying hi', subject: 'Hello from charliebrockmeier.com' },
  { label: 'A project', subject: 'A project' },
  { label: 'Something else', subject: 'Hello' },
];
---

<Base title={`Contact | ${site.name}`} description={`How to reach ${site.name}: email, LinkedIn, GitHub and the resume.`}>
  <nav class="bar wrap" aria-label="Page">
    <a href="/" class="pixel">◀ Back to the game</a>
    <a href="/resume" class="pixel">Resume ▶</a>
  </nav>

  <main class="wrap page">
    <section class="card panel" aria-labelledby="contact-title">
      <div class="who">
        <div class="frame">
          <Image src={photo} alt="Charlie Brockmeier" width={128} height={170} widths={[128, 256]} sizes="128px" loading="eager" class="photo" />
          <span class="p1 pixel" aria-hidden="true">P1</span>
        </div>
        <div class="id">
          <p class="kicker pixel">Contact</p>
          <h1 id="contact-title" class="pixel">{site.name}</h1>
          <p class="where">{character.origin} <span aria-hidden="true">→</span><span class="sr">to</span> {character.base}</p>
          <p class="status">
            <Logo name="msci" scale={1.5} />
            <span>Now at <b>MSCI</b>, New York</span>
          </p>
        </div>
      </div>

      <div class="reach">
        <p class="label pixel">Best way to reach me</p>
        <div class="email-row">
          <span class="email" data-email>{email}</span>
          <button type="button" class="copy pixel" data-copy aria-describedby="copy-status">Copy</button>
        </div>
        <p class="copy-status" id="copy-status" role="status" aria-live="polite"></p>
        <div class="actions">
          <a class="btn" href={`mailto:${email}`}><Icon name="mail" color="ink" scale={2} /> Email me</a>
          <a class="btn ghost" href={resumePdf} download><Icon name="doc" color="cream" scale={2} /> Resume PDF</a>
        </div>
      </div>
    </section>

    <section class="block" aria-labelledby="glance-title">
      <h2 id="glance-title" class="pixel head">At a glance</h2>
      <ul class="facts" role="list">
        {
          facts.map((f) => (
            <li class="panel">
              <span class="mark">{f.logo ? <Logo name={f.logo} scale={1.5} /> : <Icon name={f.icon!} color={f.color} scale={2.5} />}</span>
              <h3 class="pixel">{f.title}</h3>
              <p>{f.line}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="block" aria-labelledby="road-title">
      <h2 id="road-title" class="pixel head">The road so far</h2>
      <ol class="road panel" role="list">
        {
          road.map((r) => (
            <li class:list={{ now: r.now }}>
              <Logo name={r.logo} scale={2} caption />
              <span class="year pixel">{r.now ? 'Now' : r.year}</span>
            </li>
          ))
        }
      </ol>
    </section>

    <div class="split">
      <section class="block" aria-labelledby="elsewhere-title">
        <h2 id="elsewhere-title" class="pixel head">Elsewhere</h2>
        <ul class="ways" role="list">
          {
            elsewhere.map((l) => (
              <li>
                <a href={l.url} class="panel">
                  <Icon name={l.icon} color={l.color} scale={2.5} />
                  <span>
                    <b class="pixel">{l.label}</b>
                    <span>{l.handle}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="block" aria-labelledby="draft-title">
        <h2 id="draft-title" class="pixel head">Write me a note</h2>
        <form class="draft panel" action={`mailto:${email}`} method="get" data-draft data-email={email}>
          <fieldset class="topics">
            <legend class="sr">About</legend>
            {
              topics.map((t, i) => (
                <label>
                  <input type="radio" name="subject" value={t.subject} checked={i === 0} />
                  <span class="pixel">{t.label}</span>
                </label>
              ))
            }
          </fieldset>
          <label class="field">
            <span>Your name</span>
            <input type="text" id="draft-name" autocomplete="name" />
          </label>
          <label class="field">
            <span>Message</span>
            <textarea id="draft-message" rows="4"></textarea>
          </label>
          <button type="submit" class="btn">Open in my email app ▶</button>
          <p class="fine">Nothing is sent from this page. It opens a draft in your own email app.</p>
        </form>
      </section>
    </div>
  </main>
</Base>

<script>
  // Copy the email address. The clipboard call stays inside the click handler; if it
  // isn't allowed, the address is selected so it can be copied by hand.
  const emailEl = document.querySelector<HTMLElement>('[data-email]');
  const copyBtn = document.querySelector<HTMLButtonElement>('[data-copy]');
  const status = document.getElementById('copy-status');
  let reset = 0;

  const say = (msg: string, label: string) => {
    if (status) status.textContent = msg;
    if (copyBtn) copyBtn.textContent = label;
    clearTimeout(reset);
    reset = window.setTimeout(() => {
      if (status) status.textContent = '';
      if (copyBtn) copyBtn.textContent = 'Copy';
    }, 4000);
  };

  const selectEmail = () => {
    if (!emailEl) return;
    const range = document.createRange();
    range.selectNodeContents(emailEl);
    const sel = getSelection();
    sel?.removeAllRanges();
    sel?.addRange(range);
    const keys = /Mac|iPhone|iPad/.test(navigator.userAgent) ? '⌘C' : 'Ctrl+C';
    say(`Selected. Press ${keys} to copy.`, 'Selected');
  };

  copyBtn?.addEventListener('click', () => {
    const text = emailEl?.textContent?.trim() ?? '';
    if (!navigator.clipboard?.writeText) return selectEmail();
    navigator.clipboard.writeText(text).then(() => {
      say(`Copied ${text}`, 'Copied!');
      document.dispatchEvent(new CustomEvent('achievement', { detail: 'copy-email' }));
    }, selectEmail);
  });

  // Draft an email: build a mailto: link from the form, entirely in the browser.
  const form = document.querySelector<HTMLFormElement>('[data-draft]');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const val = (id: string) => (document.getElementById(id) as HTMLInputElement | null)?.value.trim() ?? '';
    const subject = form.querySelector<HTMLInputElement>('input[name="subject"]:checked')?.value ?? 'Hello';
    const name = val('draft-name');
    const body = [val('draft-message') || 'Hi Charlie,', name && `\n${name}`].filter(Boolean).join('\n');
    location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>

<style>
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .bar {
    display: flex;
    justify-content: space-between;
    gap: var(--space-s);
    padding-top: var(--space-m);
    font-size: var(--step-1);
  }

  .bar a {
    color: var(--gold);
    text-decoration: none;
  }

  .bar a:hover {
    color: var(--ink);
  }

  .page {
    display: grid;
    gap: var(--space-l);
    padding-top: var(--space-m);
    padding-bottom: var(--space-2xl);
  }

  /* The card: who, and how to reach. */
  .card {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: var(--space-l);
    align-items: center;
    padding: clamp(1.25rem, 3vw, 2.25rem);
    background:
      radial-gradient(circle at 0 0, color-mix(in srgb, var(--gold) 10%, transparent), transparent 55%),
      var(--panel);
  }

  .who {
    display: flex;
    align-items: center;
    gap: var(--space-m);
  }

  .frame {
    position: relative;
    flex: none;
    padding: 6px;
    background: var(--bg);
    box-shadow:
      inset 0 0 0 var(--px) var(--gold),
      var(--px) var(--px) 0 0 var(--shadow);
  }

  .frame :global(.photo) {
    display: block;
    width: clamp(84px, 14vw, 128px);
    height: auto;
  }

  .p1 {
    position: absolute;
    top: -10px;
    left: -10px;
    padding: 2px 6px;
    background: var(--gold);
    color: var(--bg);
    font-size: var(--step-0);
    line-height: 1;
  }

  .kicker,
  .label {
    color: var(--gold);
    font-size: var(--step-0);
  }

  h1 {
    font-size: clamp(2.25rem, 1.5rem + 3vw, 3.75rem);
    line-height: 0.95;
  }

  .where {
    margin-top: var(--space-2xs);
    color: var(--ink-soft);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: var(--space-xs);
    padding: 4px 10px 4px 6px;
    background: var(--bg);
    box-shadow: inset 0 0 0 2px var(--line);
    font-size: var(--step--1);
  }

  .reach {
    display: grid;
    gap: 6px;
  }

  .email-row {
    display: flex;
    flex-wrap: wrap;
    box-shadow: var(--px) var(--px) 0 0 var(--shadow);
  }

  .email {
    flex: 1 1 15rem;
    min-width: 0;
    padding: 0.7rem 0.85rem;
    overflow-wrap: anywhere;
    background: var(--bg);
    box-shadow: inset 0 0 0 2px var(--line);
    font-weight: 600;
  }

  .copy {
    flex: 1 0 auto;
    padding: 0.4rem 1.1rem;
    border: 0;
    background: var(--ink);
    color: var(--bg);
    font-size: var(--step-1);
    cursor: pointer;
  }

  .copy:hover {
    background: var(--gold);
  }

  .copy-status {
    min-height: 1.2em;
    color: var(--green);
    font-size: 0.75rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  /* Section heads, smaller than the main page's. */
  .head {
    margin-bottom: var(--space-s);
    color: var(--gold);
    font-size: var(--step-2);
    line-height: 1;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-s);
  }

  .facts li {
    display: grid;
    align-content: start;
    gap: 6px;
    padding: 1rem;
  }

  .mark {
    display: flex;
    align-items: center;
    height: 2.5rem;
  }

  .facts h3 {
    font-size: var(--step-1);
    line-height: 1.05;
  }

  .facts p {
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  /* The road: logos on a dotted line, the current one lit. */
  .road {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--space-s);
    padding: 1.25rem 1rem 1rem;
    background-image: linear-gradient(90deg, var(--line) 50%, transparent 0);
    background-size: 10px 4px;
    background-repeat: repeat-x;
    background-position: 0 calc(1.25rem + 14px);
    background-color: var(--panel);
  }

  .road li {
    display: grid;
    justify-items: center;
    gap: 4px;
    text-align: center;
  }

  .road :global(.logo) {
    padding: 4px;
    background: var(--panel);
  }

  .road :global(figcaption) {
    margin-top: 4px;
    color: var(--ink);
    font-size: var(--step--1);
  }

  .year {
    color: var(--ink-soft);
    font-size: var(--step-0);
  }

  .road .now :global(.logo) {
    box-shadow: 0 0 0 2px var(--gold);
  }

  .road .now .year {
    padding: 0 6px;
    background: var(--gold);
    color: var(--bg);
  }

  @media (prefers-reduced-motion: no-preference) {
    .road .now .year {
      animation: contact-blink 1.2s steps(2) 3;
    }
  }

  @keyframes contact-blink {
    50% {
      opacity: 0.35;
    }
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: var(--space-l);
    align-items: start;
  }

  .ways {
    display: grid;
    gap: 10px;
  }

  .ways a {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.8rem 1rem;
    color: var(--ink);
    text-decoration: none;
    transition: transform 80ms steps(2);
  }

  .ways a:hover {
    transform: translate(-2px, -2px);
  }

  .ways a > span {
    display: grid;
    min-width: 0;
  }

  .ways b {
    font-size: var(--step-1);
    font-weight: 400;
    line-height: 1;
  }

  .ways a > span > span {
    overflow: hidden;
    color: var(--ink-soft);
    font-size: var(--step--1);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .draft {
    display: grid;
    gap: 10px;
    padding: clamp(1rem, 2vw, 1.4rem);
  }

  .topics {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .topics label {
    position: relative;
  }

  .topics input {
    position: absolute;
    opacity: 0;
  }

  .topics span {
    display: inline-block;
    padding: 6px 12px;
    background: var(--bg);
    box-shadow: inset 0 0 0 2px var(--line);
    font-size: var(--step-0);
    cursor: pointer;
  }

  .topics input:checked + span {
    background: var(--gold);
    box-shadow: none;
    color: var(--bg);
  }

  .topics input:focus-visible + span {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }

  .field {
    display: grid;
    gap: 4px;
    font-size: var(--step--1);
  }

  .field span {
    color: var(--ink-soft);
  }

  .field input,
  .field textarea {
    padding: 0.55rem 0.7rem;
    border: 0;
    background: var(--bg);
    box-shadow: inset 0 0 0 2px var(--line);
    color: var(--ink);
    font: inherit;
  }

  .field input:focus,
  .field textarea:focus {
    outline: none;
    box-shadow: inset 0 0 0 2px var(--gold);
  }

  .draft .btn {
    justify-self: start;
  }

  .fine {
    color: var(--ink-soft);
    font-size: 0.75rem;
  }

  @media (max-width: 959px) {
    .card,
    .split {
      grid-template-columns: minmax(0, 1fr);
    }

    .facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 559px) {
    .who {
      align-items: flex-start;
    }

    .facts {
      grid-template-columns: minmax(0, 1fr);
    }

    .road {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      background-image: none;
    }
  }
</style>
