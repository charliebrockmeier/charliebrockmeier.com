---
// ⌘K (or /) opens a command palette over any page: jump to a section or page, run an
// action, or search everything on the site (life moments, projects, skills, trips).
// The index is built at build time from the same data files the page uses and shipped
// as JSON; matching is a small fuzzy scorer that runs in the browser. Uses a native
// <dialog>, so focus trapping and Esc come for free.
import { achievements, builds, email, quests, resumePdf } from '../data/profile';
import { branches } from '../data/skills';
import { trips } from '../data/sidequests';
import { paper2026 } from '../data/paper2026';
import { model2026 } from '../data/model2026';

type Item = { g: string; t: string; h?: string; href?: string; act?: string; k?: string };

const sections: Item[] = [
  { t: 'Top', href: '/#top', k: 'home start hero' },
  { t: 'Character', href: '/#character', k: 'about bio attributes skill tree' },
  { t: 'The road so far', href: '/#journey', k: 'walk journey story life' },
  { t: 'Quest log', href: '/#quests', k: 'career experience jobs' },
  { t: 'World map', href: '/#map', k: 'travel flights trips' },
  { t: 'Stats', href: '/#stats', k: 'chess claude spotify numbers' },
  { t: 'Builds', href: '/#builds', k: 'projects code github' },
  { t: 'Achievements', href: '/#achievements', k: 'trophies badges' },
  { t: 'Side quests', href: '/#side-quests', k: 'trips travel log' },
  { t: 'Talk to Charlie', href: '/#talk', k: 'dialogue questions npc' },
].map((s) => ({ ...s, g: 'Go to' }));

const pages: Item[] = [
  { t: 'Contact', h: 'Email, links and a note', href: '/contact', k: 'recruiter reach hire email' },
  { t: 'Resume', h: 'One page', href: '/resume', k: 'cv experience' },
  { t: paper2026.title, h: 'Paper, 2026', href: '/writing/illiquidity-premium', k: 'research private markets writing illiquidity' },
  { t: model2026.title, h: 'Paper, 2026', href: '/writing/brockmeier-model', k: 'research portfolio model asset allocation risk retirement TIPS stocks writing' },
  { t: 'The illiquidity premium (2025 original)', h: 'Paper, 2025', href: '/writing/illiquidity-premium-2025', k: 'research capstone writing' },
  ...builds.map((b) => ({ t: b.name, h: 'Project', href: `/projects/${b.id}`, k: b.line })),
].map((p) => ({ ...p, g: 'Pages' }));

const actions: Item[] = [
  { t: 'Play the walk', h: 'Press start', act: 'play', k: 'game start play mode' },
  { t: 'Copy my email', h: email, act: 'copy-email', k: 'contact clipboard' },
  { t: 'Download the resume', h: 'PDF', href: resumePdf, k: 'cv pdf' },
  { t: 'Play my chess bot', href: '/#chessbot-title', k: 'game chess bot' },
].map((a) => ({ ...a, g: 'Actions' }));

const story: Item[] = quests.flatMap((q) => [
  ...(q.moments ?? []).map((m) => ({ g: 'Story', t: m.what, h: `${m.when} · ${q.title}`, href: '/#quests', k: q.chapter })),
  ...(q.highlights ?? []).map((h) => ({ g: 'Story', t: `${h.role}, ${h.org}`, h: h.when, href: '/#quests', k: h.what })),
]);
const skills: Item[] = branches.flatMap((b) => b.skills.map((s) => ({ g: 'Skills', t: s.name, h: `${b.name} · ${s.from}`, href: '/#character', k: s.note })));
const travel: Item[] = trips.map((t) => ({ g: 'Trips', t: `${t.place}, ${t.state}`, h: String(t.year), href: '/#side-quests', k: t.note }));
const paper: Item[] = paper2026.sections.map((x) => ({ g: 'Paper', t: x.heading, h: paper2026.title, href: `/writing/illiquidity-premium#${x.id}`, k: 'illiquidity premium private markets' }));
const model: Item[] = model2026.sections.map((x) => ({ g: 'Paper', t: x.heading, h: model2026.title, href: `/writing/brockmeier-model#${x.id}`, k: 'brockmeier model portfolio allocation' }));
const badges: Item[] = achievements.map((a) => ({ g: 'Achievements', t: a.name, h: a.note, href: '/#achievements' }));

const index = [...sections, ...pages, ...actions, ...story, ...skills, ...paper, ...model, ...travel, ...badges];
---

<dialog class="palette" aria-label="Search the site" data-palette>
  <div class="box">
    <div class="search">
      <span class="prompt pixel" aria-hidden="true">&gt;</span>
      <input
        type="text"
        role="combobox"
        aria-expanded="true"
        aria-controls="palette-list"
        aria-autocomplete="list"
        aria-label="Search the site"
        placeholder="Search, or jump anywhere…"
        autocomplete="off"
        spellcheck="false"
        data-palette-input
      />
      <kbd>Esc</kbd>
    </div>
    <ul id="palette-list" role="listbox" class="list" data-palette-list></ul>
    <p class="foot"><kbd>↑</kbd><kbd>↓</kbd> move <kbd>↵</kbd> open <span data-palette-count></span></p>
  </div>
</dialog>

<script type="application/json" data-palette-index set:html={JSON.stringify(index)} />

<script>
  import '../scripts/achievements';

  type Item = { g: string; t: string; h?: string; href?: string; act?: string; k?: string };
  type Hit = { item: Item; score: number; marks: number[] };

  const dialog = document.querySelector<HTMLDialogElement>('[data-palette]');
  const input = document.querySelector<HTMLInputElement>('[data-palette-input]');
  const list = document.querySelector<HTMLUListElement>('[data-palette-list]');
  const count = document.querySelector<HTMLElement>('[data-palette-count]');
  const items: Item[] = JSON.parse(document.querySelector('[data-palette-index]')?.textContent || '[]');
  const GROUPS = ['Actions', 'Go to', 'Pages', 'Story', 'Skills', 'Paper', 'Achievements', 'Trips'];

  // Fuzzy match: every query character must appear in order. Consecutive runs and
  // word starts score higher; matches in the title beat matches in the keywords.
  const match = (q: string, text: string) => {
    const s = text.toLowerCase();
    let at = 0;
    let score = 0;
    let run = 0;
    const marks: number[] = [];
    for (const ch of q) {
      const i = s.indexOf(ch, at);
      if (i < 0) return null;
      run = i === at && marks.length ? run + 1 : 0;
      score += 1 + run * 2 + (i === 0 || /[\s,.(·/–-]/.test(s[i - 1]) ? 3 : 0) - Math.min(i - at, 4) * 0.25;
      marks.push(i);
      at = i + 1;
    }
    return { score, marks };
  };

  const search = (raw: string): Hit[] => {
    const q = raw.trim().toLowerCase().replace(/\s+/g, ' ');
    if (!q) return items.filter((i) => i.g === 'Actions' || i.g === 'Go to' || i.g === 'Pages').map((item) => ({ item, score: 0, marks: [] }));
    const hits: Hit[] = [];
    for (const item of items) {
      // Titles match fuzzily, but a scattered match (letters strewn across words) is dropped.
      const title = match(q, item.t);
      if (title && title.score >= q.length * 2.2) {
        hits.push({ item, score: title.score * 2 + (item.t.toLowerCase().startsWith(q) ? 10 : 0), marks: title.marks });
        continue;
      }
      // Hints and keywords match only on whole query words, so they never outrank a title.
      const rest = `${item.h ?? ''} ${item.k ?? ''}`.toLowerCase();
      const words = q.split(' ');
      if (words.every((w) => rest.includes(w))) hits.push({ item, score: words.join('').length, marks: [] });
    }
    return hits.sort((a, b) => b.score - a.score).slice(0, 40);
  };

  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const mark = (text: string, marks: number[]) => {
    if (!marks.length) return esc(text);
    const set = new Set(marks);
    return [...text].map((c, i) => (set.has(i) ? `<mark>${esc(c)}</mark>` : esc(c))).join('');
  };

  let hits: Hit[] = [];
  let active = 0;

  const render = () => {
    if (!list) return;
    hits = search(input?.value ?? '');
    // Keep groups together, in a fixed order, best hit first within each.
    const order = (g: string) => GROUPS.indexOf(g);
    if (input?.value.trim()) {
      const best = new Map<string, number>();
      for (const h of hits) best.set(h.item.g, Math.max(best.get(h.item.g) ?? -Infinity, h.score));
      hits.sort((a, b) => (best.get(b.item.g)! - best.get(a.item.g)!) || b.score - a.score);
    } else hits.sort((a, b) => order(a.item.g) - order(b.item.g));
    active = Math.min(active, Math.max(0, hits.length - 1));
    let html = '';
    let group = '';
    hits.forEach((h, i) => {
      if (h.item.g !== group) {
        group = h.item.g;
        html += `<li role="presentation" class="group pixel">${esc(group)}</li>`;
      }
      html += `<li role="option" id="pal-${i}" data-i="${i}" aria-selected="${i === active}"><span class="t">${mark(h.item.t, h.marks)}</span>${h.item.h ? `<span class="h">${esc(h.item.h)}</span>` : ''}</li>`;
    });
    list.innerHTML = html || '<li class="empty" role="presentation">Nothing found. Try “chess”, “Lincoln” or “AI”.</li>';
    input?.setAttribute('aria-activedescendant', hits.length ? `pal-${active}` : '');
    if (count) count.textContent = hits.length ? `${hits.length} result${hits.length === 1 ? '' : 's'}` : '';
  };

  const move = (to: number) => {
    if (!hits.length || !list) return;
    active = (to + hits.length) % hits.length;
    list.querySelectorAll('[aria-selected="true"]').forEach((el) => el.setAttribute('aria-selected', 'false'));
    const el = list.querySelector(`#pal-${active}`);
    el?.setAttribute('aria-selected', 'true');
    el?.scrollIntoView({ block: 'nearest' });
    input?.setAttribute('aria-activedescendant', `pal-${active}`);
  };

  const run = (item: Item) => {
    dialog?.close();
    if (item.act === 'copy-email') {
      const addr = item.h ?? '';
      navigator.clipboard?.writeText(addr).then(
        () => document.dispatchEvent(new CustomEvent('achievement', { detail: 'copy-email' })),
        () => (location.href = `mailto:${addr}`),
      );
      return;
    }
    if (item.act === 'play') {
      // The walk's play mode listens for this; elsewhere, go to the walk first.
      if (document.getElementById('journey')) dispatchEvent(new CustomEvent('game:start'));
      else location.href = '/#journey';
      return;
    }
    if (item.href) {
      const url = new URL(item.href, location.href);
      if (url.pathname === location.pathname && url.hash) {
        document.querySelector(url.hash === '#top' ? 'body' : url.hash)?.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
        history.replaceState(null, '', url.hash);
      } else location.href = url.href;
    }
  };

  const open = () => {
    if (!dialog || dialog.open) return;
    if (input) input.value = '';
    active = 0;
    render();
    dialog.showModal();
    input?.focus();
    document.dispatchEvent(new CustomEvent('achievement', { detail: 'command-palette' }));
  };

  addEventListener('keydown', (e) => {
    const typing = (e.target as HTMLElement).closest('input, textarea, select, [contenteditable]');
    if ((e.key === 'k' || e.key === 'K') && (e.metaKey || e.ctrlKey)) {
      e.preventDefault();
      dialog?.open ? dialog.close() : open();
    } else if (e.key === '/' && !typing && !e.metaKey && !e.ctrlKey) {
      e.preventDefault();
      open();
    }
  });
  document.addEventListener('palette:open', open);
  document.querySelectorAll('[data-palette-open]').forEach((el) => el.addEventListener('click', open));

  input?.addEventListener('input', () => {
    active = 0;
    render();
  });
  input?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') (e.preventDefault(), move(active + 1));
    else if (e.key === 'ArrowUp') (e.preventDefault(), move(active - 1));
    else if (e.key === 'Enter' && hits[active]) (e.preventDefault(), run(hits[active].item));
    // Keep page shortcuts (E, R, C, play-mode keys) from firing while typing here.
    e.stopPropagation();
  });
  list?.addEventListener('click', (e) => {
    const li = (e.target as HTMLElement).closest<HTMLElement>('[data-i]');
    if (li) run(hits[Number(li.dataset.i)].item);
  });
  list?.addEventListener('mousemove', (e) => {
    const li = (e.target as HTMLElement).closest<HTMLElement>('[data-i]');
    if (li && Number(li.dataset.i) !== active) move(Number(li.dataset.i));
  });
  // Click on the backdrop closes it.
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
</script>

<style>
  .palette {
    width: min(640px, calc(100vw - 32px));
    max-height: min(72vh, 560px);
    margin: 12vh auto auto;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--ink, #fdf6e3);
    overflow: visible;
  }

  .palette::backdrop {
    background: rgb(10 8 21 / 0.72);
  }

  .box {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    max-height: min(72vh, 560px);
    background: #221b3f;
    box-shadow:
      inset 0 0 0 4px #43386f,
      6px 6px 0 0 #0a0815;
    font-family: var(--font-sans);
  }

  .search {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1rem;
    border-bottom: 2px solid #43386f;
  }

  .prompt {
    color: #ffcd75;
    font-size: 1.6rem;
    line-height: 1;
  }

  .search input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    color: #fdf6e3;
    font: inherit;
    font-size: 1.05rem;
  }

  .search input:focus {
    outline: none;
  }

  .search input::placeholder {
    color: #9aa3c7;
  }

  .list {
    margin: 0;
    padding: 6px;
    overflow-y: auto;
    list-style: none;
    overscroll-behavior: contain;
  }

  .list :global(.group) {
    padding: 10px 10px 4px;
    color: #ffcd75;
    font-size: 0.95rem;
  }

  .list :global([role='option']) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 8px 10px;
    cursor: pointer;
  }

  .list :global([aria-selected='true']) {
    background: #ffcd75;
    color: #141026;
  }

  .list :global(.t) {
    min-width: 0;
    font-size: 0.95rem;
  }

  .list :global(.h) {
    flex: none;
    max-width: 45%;
    overflow: hidden;
    color: #9aa3c7;
    font-size: 0.78rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .list :global([aria-selected='true'] .h) {
    color: #4f4868;
  }

  .list :global(mark) {
    background: none;
    color: #73eff7;
    font-weight: 700;
  }

  .list :global([aria-selected='true'] mark) {
    color: #a8304e;
  }

  .list :global(.empty) {
    padding: 1.25rem 10px;
    color: #9aa3c7;
  }

  .foot {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0;
    padding: 8px 12px;
    border-top: 2px solid #43386f;
    color: #9aa3c7;
    font-size: 0.75rem;
  }

  .foot span {
    margin-left: auto;
  }

  kbd {
    padding: 1px 6px;
    background: #141026;
    box-shadow: inset 0 0 0 1px #43386f;
    color: #fdf6e3;
    font-family: inherit;
    font-size: 0.72rem;
  }

  @media (max-width: 559px) {
    .palette {
      margin-top: 16px;
    }

    .list :global(.h) {
      display: none;
    }
  }
</style>
