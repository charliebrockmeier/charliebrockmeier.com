---
import { inventory, type Tier } from '../data/profile';

const tierColor: Record<Tier, string> = {
  legendary: 'var(--gold)',
  epic: 'var(--violet)',
  rare: 'var(--blue)',
  common: 'var(--gray)',
};
---

<section id="inventory" class="section wrap" aria-labelledby="inventory-title">
  <header class="section-head">
    <span class="num">08</span>
    <h2 id="inventory-title">Inventory</h2>
    <p>What I build with.</p>
  </header>

  <div class="gear">
    <div>
      <h3 class="pixel">Equipped</h3>
      <ul class="equipped" role="list">
        {
          inventory.equipped.map((it) => (
            <li class="slot big" style={`--tier: ${tierColor[it.tier]}`}>
              <span class="code pixel" aria-hidden="true">
                {it.code}
              </span>
              <span class="name pixel">{it.name}</span>
              <span class="tier pixel">{it.tier}</span>
              <span class="flavor">{it.note}</span>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="bag-wrap">
      <h3 class="pixel">In the bag</h3>
      <ul class="bag" role="list">
        {
          inventory.bag.map((it) => (
            <li class="slot" style={`--tier: ${tierColor[it.tier]}`} tabindex="0" aria-label={`${it.name}: ${it.note}`}>
              <span class="code pixel" aria-hidden="true">
                {it.code}
              </span>
              <span class="name pixel" aria-hidden="true">
                {it.name}
              </span>
              <span class="tip" aria-hidden="true">
                <strong>{it.name}</strong> · {it.note}
              </span>
            </li>
          ))
        }
      </ul>
      <p class="inspect">Hover or focus an item to inspect it.</p>
    </div>
  </div>

</section>

<style>
  h3 {
    margin-bottom: var(--space-s);
    color: var(--gold);
    font-size: var(--step-1);
  }

  .gear {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: clamp(1.5rem, 3vw, 3rem);
  }

  .equipped {
    display: grid;
    gap: var(--space-xs);
  }

  .slot {
    position: relative;
    display: grid;
    background: var(--panel);
    box-shadow:
      inset 0 0 0 3px var(--tier),
      var(--px) var(--px) 0 0 var(--shadow);
  }

  .slot.big {
    grid-template-columns: 64px 1fr auto;
    grid-template-areas: 'code name tier' 'code flavor flavor';
    align-items: center;
    column-gap: var(--space-s);
    padding: 10px 14px 10px 10px;
  }

  .code {
    grid-area: code;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    background: color-mix(in srgb, var(--tier) 18%, var(--bg));
    color: var(--tier);
    font-size: var(--step-1);
    font-weight: 700;
  }

  .big .name {
    grid-area: name;
    font-size: var(--step-1);
  }

  .tier {
    grid-area: tier;
    color: var(--tier);
    font-size: var(--step--1);
    text-transform: uppercase;
  }

  .flavor {
    grid-area: flavor;
    color: var(--ink-soft);
    font-size: var(--label);
  }

  .bag {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-xs);
  }

  .bag-wrap {
    position: relative;
  }

  .bag .slot {
    position: static;
    justify-items: center;
    gap: 6px;
    padding: 10px 8px;
    cursor: help;
  }

  .bag .code,
  .bag .name {
    grid-area: auto;
  }

  .bag .code {
    width: 52px;
  }

  .bag .name {
    font-size: var(--step--1);
  }

  /* The bag shows one description at a time, in the line under the grid. */
  .inspect,
  .tip {
    min-height: 3.5em;
    margin-top: var(--space-s);
    padding: 10px 12px;
    color: var(--ink-soft);
    font-size: var(--label);
  }

  .inspect {
    box-shadow: inset 0 0 0 2px var(--line);
  }

  .tip {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    background: var(--panel);
    color: var(--ink);
    box-shadow: inset 0 0 0 2px var(--tier);
  }

  .bag .slot:is(:hover, :focus-visible) .tip {
    display: block;
  }

  @media (max-width: 899px) {
    .gear {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 479px) {
    .slot.big {
      grid-template-columns: 52px 1fr;
      grid-template-areas: 'code name' 'code tier' 'flavor flavor';
    }

    .bag {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
