---
// Renders hand-drawn pixel art (rows of palette keys) as a crisp SVG.
// Horizontal runs of one color merge into a single rect to keep the markup small.
import type { PixelArt } from '../data/pixels';

interface Props {
  art: PixelArt;
  /** Rendered size of one art pixel, in CSS pixels. */
  scale?: number;
  label?: string;
  class?: string;
}

const { art, scale = 8, label, class: className } = Astro.props;
const width = art.rows[0].length;
const height = art.rows.length;

const runs: { x: number; y: number; w: number; fill: string; key: string }[] = [];
art.rows.forEach((row, y) => {
  let x = 0;
  while (x < row.length) {
    const key = row[x];
    let w = 1;
    while (row[x + w] === key) w++;
    if (key !== '.') runs.push({ x, y, w, fill: art.palette[key], key });
    x += w;
  }
});
---

<svg
  class={className}
  viewBox={`0 0 ${width} ${height}`}
  width={width * scale}
  height={height * scale}
  shape-rendering="crispEdges"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  {runs.map((r) => <rect x={r.x} y={r.y} width={r.w} height="1" fill={r.fill} data-k={r.key} />)}
</svg>
