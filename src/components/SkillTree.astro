---
// The skill tree: one row per branch, tiers left to right from fundamentals to the
// capstone. Pips show level out of 5; "Needs" chips show which skills in other
// branches came first. Off-the-clock skills sit underneath.
import Icon from './Icon.astro';
import { branches, hobbies, tiers, MAX_LEVEL } from '../data/skills';

const ROMAN = ['I', 'II', 'III', 'IV', 'V'];
const branchOf = Object.fromEntries(branches.flatMap((b) => b.skills.map((s) => [s.name, b])));
const total = branches.reduce((n, b) => n + b.skills.reduce((m, s) => m + s.level, 0), 0);
const maxed = branches.reduce((n, b) => n + b.skills.filter((s) => s.level === MAX_LEVEL).length, 0);
---

<div class="skilltree panel" data-skilltree>
  <header class="head">
    <div>
      <h3 class="pixel">Skill tree</h3>
      <p>Five branches, {branches.length * tiers.length} skills, from fundamentals to the capstone each one is building toward.</p>
    </div>
    <dl class="totals">
      <div><dt>Skill points</dt><dd class="pixel">{total}</dd></div>
      <div><dt>Maxed</dt><dd class="pixel">{maxed}</dd></div>
      <div><dt>Capstones in progress</dt><dd class="pixel">{branches.length}</dd></div>
    </dl>
  </header>

  <ol class="tier-labels" aria-hidden="true">
    <li />
    {tiers.map((t, i) => (
      <li class="pixel">
        {ROMAN[i]} · {t}
      </li>
    ))}
  </ol>

  <ol class="branches" role="list">
    {
      branches.map((b, bi) => (
        <li class="branch" style={`--c: var(--${b.color}); --b: ${bi}`}>
          <header class="branch-head">
            <Icon name={b.icon} color={b.color} scale={2} />
            <div>
              <h4 class="pixel">{b.name}</h4>
              <p>{b.tagline}</p>
            </div>
            <span class="lv pixel">Lv {b.skills.reduce((m, s) => m + s.level, 0)}</span>
          </header>
          <ol class="nodes" role="list">
            {b.skills.map((s, t) => (
              <li
                class:list={['node', { capstone: t === tiers.length - 1, maxed: s.level === MAX_LEVEL }]}
                style={`--t: ${t}`}
                tabindex="0"
                aria-label={`${b.name}, tier ${ROMAN[t]}: ${s.name}, level ${s.level} of ${MAX_LEVEL}. ${s.note}`}
              >
                <p class="top">
                  <span class="tier pixel">{ROMAN[t]}</span>
                  <span class="from">{s.from}</span>
                </p>
                <p class="name">{s.name}</p>
                <span class="pips" aria-hidden="true">
                  {Array.from({ length: MAX_LEVEL }, (_, k) => (
                    <i class:list={{ on: k < s.level }} style={`--k: ${k}`} />
                  ))}
                  {s.level === MAX_LEVEL && <b class="pixel">MAX</b>}
                </span>
                <p class="note">{s.note}</p>
                {s.needs && (
                  <p class="needs">
                    Needs
                    {s.needs.map((n) => (
                      <span style={`--nc: var(--${branchOf[n]?.color ?? 'line'})`}>{n}</span>
                    ))}
                  </p>
                )}
              </li>
            ))}
          </ol>
        </li>
      ))
    }
  </ol>

  <div class="off">
    <p class="pixel">Off the clock</p>
    <ul role="list">
      {hobbies.map((h, i) => (
        <li style={`--c: var(--${h.color}); --i: ${i}`}>
          <Icon name={h.icon} color={h.color} scale={2} />
          <span class="pixel value">{h.value}</span>
          <span class="label">
            <strong>{h.name}</strong> {h.label}
          </span>
        </li>
      ))}
    </ul>
  </div>
</div>

<script>
  // Light the tree up tier by tier when it scrolls into view. Without JS, or with
  // reduced motion, it's simply shown lit.
  const tree = document.querySelector<HTMLElement>('[data-skilltree]');
  if (tree && 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    tree.classList.add('animate');
    const io = new IntersectionObserver(
      ([e]) => {
        if (!e.isIntersecting) return;
        tree.classList.add('lit');
        io.disconnect();
      },
      { rootMargin: '0px 0px -15% 0px' },
    );
    io.observe(tree);
  }
</script>

<style>
  .skilltree {
    --node-w: minmax(0, 1fr);
    display: grid;
    gap: var(--space-s);
    margin-top: var(--space-m);
    padding: clamp(1rem, 2vw, 1.5rem);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-m);
  }

  .head h3 {
    color: var(--gold);
    font-size: var(--step-2);
    line-height: 1;
  }

  .head p {
    margin-top: 0.25rem;
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  .totals {
    display: flex;
    gap: var(--space-m);
  }

  .totals dt {
    color: var(--ink-soft);
    font-size: 0.75rem;
  }

  .totals dd {
    color: var(--gold);
    font-size: var(--step-2);
    line-height: 1;
  }

  /* Rows are branches, columns are tiers. */
  .tier-labels,
  .branch {
    display: grid;
    grid-template-columns: 9.5rem repeat(5, var(--node-w));
    gap: 10px;
  }

  .tier-labels li {
    color: var(--ink-soft);
    font-size: 0.75rem;
  }

  .branches {
    display: grid;
    gap: 10px;
  }

  .branch {
    align-items: stretch;
  }

  .nodes {
    display: contents;
  }

  .branch-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-content: center;
    gap: 2px 8px;
    padding-right: 4px;
    border-right: 3px solid var(--c);
  }

  .branch-head h4 {
    color: var(--c);
    font-size: var(--step-1);
    line-height: 1;
  }

  .branch-head p {
    color: var(--ink-soft);
    font-size: 0.6875rem;
    line-height: 1.25;
  }

  .lv {
    grid-column: 2;
    color: var(--ink);
    font-size: var(--label);
  }

  .node {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 0.5rem 0.6rem 0.55rem;
    background: color-mix(in srgb, var(--c) 7%, var(--bg));
    box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--c) 45%, var(--line));
    outline-offset: 2px;
    transition: transform 0.15s steps(2), box-shadow 0.15s steps(2);
  }

  .node:hover,
  .node:focus-visible {
    transform: translateY(-2px);
    box-shadow: inset 0 0 0 2px var(--c), 0 4px 0 color-mix(in srgb, var(--c) 30%, transparent);
  }

  /* The connector into each node from the one before it. */
  .node:not(:first-child)::before {
    content: '';
    position: absolute;
    top: 50%;
    right: 100%;
    width: 10px;
    height: 3px;
    background: var(--c);
  }

  .node.capstone {
    background: color-mix(in srgb, var(--c) 14%, var(--bg));
    box-shadow: inset 0 0 0 2px var(--c);
  }

  .top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px;
  }

  .tier {
    color: var(--c);
    font-size: var(--label);
    line-height: 1;
  }

  .from {
    overflow: hidden;
    color: var(--ink-soft);
    font-size: 0.6875rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .name {
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .pips {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .pips i {
    width: 10px;
    height: 7px;
    background: var(--bg);
    box-shadow: inset 0 0 0 2px var(--line);
  }

  .pips i.on {
    background: var(--c);
    box-shadow: none;
  }

  .pips b {
    margin-left: 4px;
    color: var(--c);
    font-size: 0.75rem;
    font-weight: 400;
    line-height: 1;
  }

  .note {
    color: var(--ink-soft);
    font-size: 0.6875rem;
    line-height: 1.35;
  }

  .needs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 3px;
    margin-top: auto;
    padding-top: 3px;
    color: var(--ink-soft);
    font-size: 0.625rem;
  }

  .needs span {
    padding: 0 4px;
    background: color-mix(in srgb, var(--nc) 16%, transparent);
    box-shadow: inset 0 0 0 1px var(--nc);
    color: var(--ink);
  }

  /* Off the clock */
  .off {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-m);
    padding-top: var(--space-s);
    border-top: 2px dashed var(--line);
  }

  .off > p {
    color: var(--gold);
    font-size: var(--label);
  }

  .off ul {
    display: flex;
    flex: 1;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-m);
  }

  .off li {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .off .value {
    color: var(--c);
    font-size: var(--step-2);
    line-height: 1;
  }

  .off .label {
    color: var(--ink-soft);
    font-size: 0.75rem;
    line-height: 1.2;
  }

  .off strong {
    display: block;
    color: var(--ink);
  }

  /* Motion, opted into by the script. */
  .animate:not(.lit) .node,
  .animate:not(.lit) .branch-head {
    opacity: 0;
  }

  .animate:not(.lit) .pips i.on {
    background: var(--bg);
  }

  .animate.lit .branch-head {
    animation: skill-in 0.3s steps(3) calc(var(--b) * 0.08s) both;
  }

  .animate.lit .node {
    animation: skill-in 0.35s steps(3) calc(0.2s + var(--t) * 0.18s + var(--b) * 0.06s) both;
  }

  .animate.lit .node:not(:first-child)::before {
    transform-origin: left;
    animation: skill-wire 0.3s steps(3) calc(0.1s + var(--t) * 0.18s + var(--b) * 0.06s) both;
  }

  .animate.lit .pips i.on {
    animation: skill-pip 0.2s steps(2) calc(0.45s + var(--t) * 0.18s + var(--b) * 0.06s + var(--k) * 0.06s) both;
  }

  .animate.lit .capstone {
    animation:
      skill-in 0.35s steps(3) calc(0.2s + var(--t) * 0.18s + var(--b) * 0.06s) both,
      skill-glow 2.4s steps(3) 2.2s infinite;
  }

  .animate.lit .pips b {
    animation: skill-blink 1.2s steps(2) 2s 3;
  }

  .animate.lit .off li {
    animation: skill-in 0.3s steps(3) calc(1.6s + var(--i) * 0.1s) both;
  }

  @keyframes skill-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes skill-wire {
    from {
      transform: scaleX(0);
    }
    to {
      transform: none;
    }
  }

  @keyframes skill-pip {
    from {
      background: var(--bg);
    }
    to {
      background: var(--c);
    }
  }

  @keyframes skill-glow {
    50% {
      box-shadow: inset 0 0 0 2px var(--c), 0 0 0 3px color-mix(in srgb, var(--c) 35%, transparent);
    }
  }

  @keyframes skill-blink {
    50% {
      opacity: 0;
    }
  }

  /* Tablets: each branch keeps its row, with the branch name above it. */
  @media (max-width: 1099px) {
    .tier-labels {
      display: none;
    }

    .branches {
      gap: var(--space-s);
    }

    .branch {
      grid-template-columns: repeat(5, minmax(8rem, 1fr));
      overflow-x: auto;
      padding-bottom: 2px;
    }

    .branch-head {
      grid-column: 1 / -1;
      grid-template-columns: auto auto 1fr;
      align-items: center;
      padding: 0 0 6px;
      border-right: 0;
      border-bottom: 3px solid var(--c);
    }

    .branch-head > div {
      display: flex;
      align-items: baseline;
      gap: 8px;
    }

    .lv {
      grid-column: auto;
      justify-self: end;
    }
  }

  /* Phones: each branch stacks its tiers top to bottom. */
  @media (max-width: 699px) {
    .branch {
      grid-template-columns: minmax(0, 1fr);
      overflow: visible;
    }

    .node:not(:first-child)::before {
      top: auto;
      right: auto;
      bottom: 100%;
      left: 1rem;
      width: 3px;
      height: 10px;
    }

    .animate.lit .node:not(:first-child)::before {
      transform-origin: top;
      animation-name: skill-wire-v;
    }

    @keyframes skill-wire-v {
      from {
        transform: scaleY(0);
      }
      to {
        transform: none;
      }
    }
  }
</style>
