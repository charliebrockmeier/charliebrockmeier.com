---
// The extra sections on the faceless engine's page: its three pages and its sources.
import { facelessPages, facelessSources } from '../data/projects';
---

<section class="block" aria-labelledby="pages">
  <h2 id="pages" class="label pixel">Three pages</h2>
  <p class="lede">Each page has its own voice and its own tagline. Nothing is posted yet.</p>
  <ul class="phones" role="list">
    {
      facelessPages.map((page) => (
        <li class="phone" style={`--c: ${page.color}`}>
          <p class="name pixel">{page.name}</p>
          <p class="tag pixel">{page.tag}</p>
          <p class="ratio pixel">
            <span class="dot" aria-hidden="true" /> 9:16 · not posted yet
          </p>
        </li>
      ))
    }
  </ul>
</section>

<section class="block" aria-labelledby="sources">
  <h2 id="sources" class="label pixel">Official sources</h2>
  <p class="lede">226 data series, and every number in a script is checked against the source rows.</p>
  <ul class="sources" role="list">
    {facelessSources.map((s) => <li class="pixel">{s}</li>)}
  </ul>
</section>

<style>
  .block {
    margin-top: var(--space-xl);
  }

  .label {
    margin-bottom: var(--space-s);
    color: var(--gold);
    font-size: var(--step-3);
    line-height: 1;
    text-transform: uppercase;
  }

  .lede {
    max-width: 60ch;
    margin-bottom: var(--space-s);
    color: var(--ink-soft);
  }

  .phones {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 200px));
    gap: var(--space-m);
  }

  .phone {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 0.6rem;
    aspect-ratio: 9 / 16;
    padding: 1rem;
    border-radius: 18px;
    background:
      linear-gradient(transparent 60%, color-mix(in srgb, var(--c) 22%, transparent)),
      linear-gradient(#1b1533, #110d22);
    box-shadow:
      0 0 0 4px var(--line),
      6px 6px 0 2px var(--shadow);
  }

  .name {
    color: var(--c);
    font-size: var(--step-2);
    line-height: 1;
  }

  .tag {
    align-self: center;
    color: var(--c);
    font-size: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
    line-height: 1;
    text-shadow: 0.08em 0.08em 0 var(--shadow);
  }

  .ratio {
    display: flex;
    align-items: center;
    gap: 0.4em;
    color: var(--ink-soft);
    font-size: var(--label);
  }

  .dot {
    width: 8px;
    height: 8px;
    background: var(--gold);
  }

  .sources {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .sources li {
    padding: 0.3rem 0.8rem;
    background: var(--panel);
    box-shadow:
      inset 0 0 0 2px var(--line),
      var(--px) var(--px) 0 0 var(--shadow);
    font-size: var(--step-1);
  }

  @media (max-width: 639px) {
    .phones {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-xs);
    }

    .phone {
      padding: 0.5rem;
      border-radius: 10px;
    }

    .name {
      font-size: var(--step-0);
    }

    .tag {
      font-size: var(--step-1);
    }

    .ratio {
      display: none;
    }
  }
</style>
