---
// How many tokens Claude has burned on Charlie's projects, from Claude Code's own
// per-session usage (src/data/claude.json). `npm run claude-stats` on his laptop
// adds local Claude Code usage under `local`.
import Icon from './Icon.astro';
import claude from '../data/claude.json';

type Usage = { input: number; output: number; cacheRead: number; cacheWrite: number; total: number; sessions?: number };
const local = claude.local as Usage | null;
const total = claude.totals.total + (local?.total ?? 0);
const output = claude.totals.output + (local?.output ?? 0);
const sessions = claude.sessions + (local?.sessions ?? 0);

const short = (n: number) =>
  n >= 1e9 ? `${(n / 1e9).toFixed(2)}B` : n >= 1e6 ? `${(n / 1e6).toFixed(1)}M` : n >= 1e3 ? `${Math.round(n / 1e3)}K` : String(n);
const projects = local ? [...claude.byProject, { name: 'On my laptop', sessions: local.sessions ?? 0, total: local.total, output: local.output }] : claude.byProject;
const max = Math.max(...projects.map((p) => p.total));
const since = new Date(`${claude.firstSession}T12:00:00Z`).toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const asOf = new Date(`${claude.asOf}T12:00:00Z`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const colors = ['var(--teal)', 'var(--violet)', 'var(--gold)', 'var(--coral)', 'var(--blue)'];
---

<article class="claude panel" aria-labelledby="claude-title" data-rise data-claude>
  <header class="head">
    <Icon name="chip" color="teal" scale={2.5} />
    <h3 id="claude-title" class="pixel">Claude</h3>
    <p class="source">Claude Code session usage, as of {asOf}</p>
  </header>

  <div class="body">
    <div class="lead">
      <p class="big pixel" data-count={total}>{short(total)}</p>
      <p class="label">tokens processed by Claude on my projects since {since}</p>
      <dl class="rows">
        <div><dt>Written by Claude</dt><dd class="pixel">{short(output)}</dd></div>
        <div><dt>Re-read from cache</dt><dd class="pixel">{short(claude.totals.cacheRead + (local?.cacheRead ?? 0))}</dd></div>
        <div><dt>Sessions</dt><dd class="pixel">{sessions}</dd></div>
        <div><dt>At API prices</dt><dd class="pixel">${Math.round(claude.totals.cost).toLocaleString('en-US')}</dd></div>
      </dl>
    </div>

    <div class="split">
      <p class="pixel cap">Where the tokens went</p>
      <ul role="list">
        {
          projects.map((p, i) => (
            <li style={`--w: ${Math.max(1.5, (p.total / max) * 100)}%; --c: ${colors[i % colors.length]}; --i: ${i}`}>
              <span class="name">{p.name}</span>
              <span class="track">
                <span class="fill" />
              </span>
              <span class="val pixel">{short(p.total)}</span>
            </li>
          ))
        }
      </ul>
      <p class="quip">Most of those tokens are Claude re-reading code it already wrote. Cache reads count. They also cost a tenth as much.</p>
    </div>
  </div>
</article>

<script>
  // Count the big number up the first time the card is on screen.
  const card = document.querySelector<HTMLElement>('[data-claude]');
  const big = card?.querySelector<HTMLElement>('[data-count]');
  if (card && big && 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const target = Number(big.dataset.count);
    const final = big.textContent;
    const io = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return;
      io.disconnect();
      const steps = 24;
      let i = 0;
      const tick = () => {
        i++;
        const v = (target * i) / steps;
        big.textContent = i >= steps ? final : `${(v / 1e9).toFixed(2)}B`;
        if (i < steps) setTimeout(tick, 45);
      };
      tick();
    });
    io.observe(card);
  }
</script>

<style>
  .claude {
    margin-top: var(--space-s);
    padding: clamp(1rem, 2vw, 1.4rem);
  }

  .head {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.3rem 0.6rem;
  }

  .head h3 {
    font-size: var(--step-2);
    line-height: 1;
  }

  .source {
    margin-left: auto;
    color: var(--ink-soft);
    font-size: 0.75rem;
  }

  .body {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: var(--space-m);
    margin-top: var(--space-s);
  }

  .big {
    color: var(--teal);
    font-size: clamp(2.5rem, 1.8rem + 2.4vw, 3.75rem);
    line-height: 0.9;
    font-size-adjust: cap-height 0.7;
    font-variant-numeric: tabular-nums;
  }

  .label {
    margin-top: var(--space-2xs);
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  .rows {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-xs) var(--space-s);
    margin-top: var(--space-s);
  }

  .rows dt {
    color: var(--ink-soft);
    font-size: 0.75rem;
  }

  .rows dd {
    font-size: var(--step-1);
    line-height: 1.1;
    font-size-adjust: cap-height 0.7;
  }

  .cap {
    color: var(--gold);
    font-size: var(--label);
  }

  .split ul {
    display: grid;
    gap: 8px;
    margin-top: 8px;
  }

  .split li {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr) 3.5rem;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--step--1);
  }

  .track {
    height: 14px;
    background: var(--bg);
    box-shadow: inset 0 0 0 2px var(--line);
  }

  .fill {
    display: block;
    width: var(--w);
    height: 100%;
    background: repeating-linear-gradient(90deg, var(--c) 0 6px, color-mix(in srgb, var(--c) 55%, transparent) 6px 8px);
  }

  .val {
    text-align: right;
  }

  .quip {
    margin-top: var(--space-s);
    padding-top: var(--space-xs);
    border-top: 2px dashed var(--line);
    color: var(--ink-soft);
    font-size: var(--step--1);
    font-style: italic;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.motion) .claude:not(:global(.risen)) .fill {
      width: 0;
    }

    .fill {
      transition: width 1s steps(14) calc(0.3s + var(--i) * 0.15s);
    }

    .head :global(svg) {
      animation: claude-think 1.2s steps(2) infinite;
    }
  }

  @keyframes claude-think {
    50% {
      transform: translateY(-2px);
      filter: brightness(1.3);
    }
  }

  @media (max-width: 759px) {
    .body {
      grid-template-columns: minmax(0, 1fr);
    }

    .split li {
      grid-template-columns: 6.5rem minmax(0, 1fr) 3rem;
    }
  }
</style>
