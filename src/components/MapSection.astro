---
// The world map: a pixel-art US (public/art/usmap.png, drawn by scripts/art/usmap.mjs)
// with an animated SVG overlay on the same grid. The main quest walks I-80 from
// Kearney to New York and flies out to San Francisco; every trip in the travel log
// (src/data/sidequests.ts) gets a pin, and the drives and flights get a car or a plane.
// Motion starts when the map scrolls into view and stays off for reduced motion.
import Logo from './Logo.astro';
import type { LogoName } from '../data/logos';
import { career, tripPins, map, mainRoute, roads, flights, pathOf, lengthOf, xy, point } from '../data/travel';
import { cats, catOrder, trips, tally, type Cat } from '../data/sidequests';

const { width: W, height: H } = map;
const GOLD = '#ffcd75';
const colorOf = (c: Cat | 'main') => (c === 'main' ? GOLD : cats[c].color[0]);

const main = { d: pathOf(mainRoute), len: lengthOf(mainRoute) };
const drives = roads.map((r) => {
  const a = point(...r.pts[0]);
  const b = point(...r.pts.at(-1)!);
  return { ...r, d: pathOf(r.pts), len: lengthOf(r.pts), west: b.x < a.x };
});

// When each route draws itself on, and when its vehicle starts: after the route is drawn.
const MAIN_REVEAL = { delay: 0.2, dur: 3 };
const routes = [
  ...flights.filter((f) => f.cat === 'main').map((f) => ({ ...f, kind: 'flight' as const })),
  ...drives.map((r) => ({ ...r, kind: 'drive' as const })),
  ...flights.filter((f) => f.cat !== 'main').map((f) => ({ ...f, kind: 'flight' as const })),
].map((r, i) => ({ ...r, reveal: { delay: +(1.2 + i * 0.32).toFixed(2), dur: r.kind === 'flight' ? 1.2 : 1.6 } }));

// One-way loops: fade in at the start pin, travel at a steady speed, park at the end pin,
// fade out, wait offstage, then begin again from the start. Nothing jumps while visible.
const loop = (len: number, speed: number, begin: number, i: number) => {
  const hold = 0.5;
  const travel = Math.max(3, len / speed);
  const park = 1.4;
  const fade = 0.6;
  const gap = 1.2 + (i % 4) * 0.8;
  const T = hold + travel + park + fade + gap;
  const k = (s: number) => (s / T).toFixed(4);
  return {
    dur: `${T.toFixed(2)}s`,
    begin: `mapgo.begin+${begin.toFixed(2)}s`,
    motion: { keyPoints: '0;0;1;1', keyTimes: `0;${k(hold)};${k(hold + travel)};1` },
    fade: { values: '0;1;1;0;0', keyTimes: `0;${k(hold)};${k(hold + travel + park)};${k(hold + travel + park + fade)};1` },
  };
};

// Sprites as rows of palette keys, one map pixel each.
const rects = (rows: string[], pal: Record<string, string>, ox = 0, oy = 0) =>
  rows.flatMap((row, y) => [...row].flatMap((k, x) => (k === '.' ? [] : [{ x: x + ox, y: y + oy, fill: pal[k] }])));
const carRows = ['....KKKKKKK...', '...KWWKWWWWK..', '..KWWWKWWWWWK.', '.KhhhhhhhhhhhK', 'KCCCCCCCCCCCCK', 'KCCCCCCCCCCCYK', 'KcKKKccccKKKcK', '.KgggK..KgggK.', '..KKK....KKK..'];
const carPal = { C: '#e43b44', c: '#a8304e', h: '#ff8e8e', W: '#bdeeff', K: '#0c0a18', Y: '#ffcd75', g: '#9aa3c7' };
const skiPal = { ...carPal, C: '#5cb8ff', c: '#3b5dc9', h: '#d0ecff', R: '#e43b44' };
const car = rects(carRows, carPal, -7, -7);
const skiCar = rects(['.RRRRRRRRRRRR.', '....KK..KK....', ...carRows], skiPal, -7, -9);
const plane = rects(
  ['......KK......', '......KWK.....', '.KK...KWWK....', '.KRK..KWWWK...', '.KWWKKKWWWWKK.', 'KWWWWWWWWWWWBK', '.KwwKKKwwwwKK.', '.KwK..KwwwK...', '.KK...KwwK....', '......KwK.....', '......KK......'],
  { W: '#fdf6e3', w: '#bdb3db', K: '#0c0a18', B: '#5cb8ff', R: '#e43b44' },
  -7,
  -5.5,
);
const walkerPal = { H: '#5c3a2e', S: '#f2c4a2', J: '#2b2350', T: '#fdf6e3', L: '#1b1533', B: '#0c0a18' };
const walker = [
  rects(['.HHH.', 'HHSS.', '.SSS.', '.JTJ.', 'JJTJJ', '.JJJ.', '.L.L.', '.B.B.'], walkerPal, -2.5, -8),
  rects(['.HHH.', 'HHSS.', '.SSS.', '.JTJ.', 'JJTJJ', '.JJJ.', '..LL.', '.B..B'], walkerPal, -2.5, -8),
];

const movers = [
  ...routes.map((r, i) => ({
    id: r.id,
    href: `#p-${r.kind === 'flight' ? 'f-' : ''}${r.id}`,
    sprite: r.kind === 'flight' ? plane : r.cat === 'ski' ? skiCar : car,
    west: r.west,
    ...loop(r.len, r.kind === 'flight' ? 34 : 16, r.reveal.delay + r.reveal.dur, i),
  })),
];
const walk = loop(main.len, 9, MAIN_REVEAL.delay + 0.4, 0);

const cloudRows = ['..cccc.....', '.cccccc.cc.', 'ccccccccccc', '.ccccccccc.'];
const clouds = [
  { x: -40, y: 30, dur: 70, delay: 0 },
  { x: -40, y: 110, dur: 95, delay: -40 },
  { x: -40, y: 190, dur: 80, delay: -20 },
  { x: -40, y: 70, dur: 110, delay: -75 },
];

// Pins: career stops are gold (school blue); trip pins stripe their categories.
const kindColor = { home: GOLD, school: '#5cb8ff', work: GOLD };
const pins = [
  ...career.map((p) => ({ id: p.id, short: p.name.replace(/, [A-Z]{2}$/, ''), label: p.label, ...xy(p), fills: [kindColor[p.kind]], career: true })),
  ...tripPins.map((p) => ({ id: p.id, short: p.short ?? p.name.replace(/, [A-Z]{2}$/, ''), label: p.label, ...xy(p), fills: p.cats.map((c) => cats[c].color[0]), career: false })),
].map((p, i) => ({ ...p, order: i }));
const nyc = pins.find((p) => p.id === 'nyc')!;

// Label placement around a pin.
const label = (p: { x: number; y: number; label: string }) =>
  p.label === 'n' ? { x: p.x, y: p.y - 5, a: 'middle' } : p.label === 's' ? { x: p.x, y: p.y + 9.5, a: 'middle' } : p.label === 'e' ? { x: p.x + 5, y: p.y + 2, a: 'start' } : { x: p.x - 5, y: p.y + 2, a: 'end' };

const nebraska = point(-99.5, 41.5);
// An I-80 shield on the main route, somewhere in Illinois.
const shield = rects(['.BBBBB.', 'BRRRRRB', 'BBBBBBB', 'BWBWBWB', 'BBBBBBB', '.BBBBB.', '..BBB..'], { B: '#29366f', R: '#e43b44', W: '#fdf6e3' }, point(-89.2, 41.5).x - 3.5, point(-89.2, 41.5).y - 11);

// The side-quest summary under the map: each category with its places.
const summary = catOrder.map((c) => {
  const places: { name: string; n: number }[] = [];
  for (const t of trips.filter((t) => t.cat === c)) {
    const hit = places.find((p) => p.name === t.place);
    if (hit) hit.n++;
    else places.push({ name: t.place, n: 1 });
  }
  return { c, ...cats[c], count: tally.byCat[c], places };
});
// Who Charlie was with at each stop of the main quest.
const stopLogos: Record<string, LogoName[]> = {
  kearney: ['khs', 'cashwa', 'buckle'],
  lincoln: ['unl'],
  omaha: ['covisum'],
  sf: ['threebridge'],
  nyc: ['vantager', 'msci'],
};
---

<section id="map" class="section wrap" aria-labelledby="map-title" data-map>
  <header class="section-head">
    <span class="num">04</span>
    <h2 id="map-title">World map</h2>
    <p>Everywhere I've lived, worked or traveled. The main quest runs along I-80 with a summer detour to San Francisco; the side quests go everywhere else.</p>
  </header>

  <figure class="map panel">
    <ul class="legend" role="list">
      <li><i class="key" style={`--k: ${GOLD}`}></i>Main quest</li>
      {catOrder.map((c) => <li><i class="key" style={`--k: ${cats[c].color[0]}`}></i>{cats[c].label}</li>)}
      <li><i class="key dots"></i>Flight</li>
      <li><i class="key now"></i>Current save</li>
    </ul>
    <div class="frame" data-frame style={`--nx: ${(nebraska.x / W).toFixed(3)}`}>
      <div class="canvas">
        <img src="/art/usmap.png" width={W} height={H} alt="Pixel-art map of the United States with Charlie's route from Kearney, Nebraska to New York, a flight to San Francisco, and pins for his road trips, vacations, work trips, ski trips and Husker away games." loading="lazy" decoding="async" />
        <svg viewBox={`0 0 ${W} ${H}`} shape-rendering="crispEdges" aria-hidden="true" focusable="false">
          <defs>
            <mask id="m-main" maskUnits="userSpaceOnUse"><path class="reveal" d={main.d} pathLength="1" style={`--delay: ${MAIN_REVEAL.delay}s; --dur: ${MAIN_REVEAL.dur}s`} /></mask>
            {
              routes.map((r) => (
                <mask id={`m-${r.kind === 'flight' ? 'f-' : ''}${r.id}`} maskUnits="userSpaceOnUse">
                  <path class="reveal" d={r.d} pathLength="1" style={`--delay: ${r.reveal.delay}s; --dur: ${r.reveal.dur}s`} />
                </mask>
              ))
            }
            <path id="p-main" d={main.d} />
            {routes.map((r) => <path id={`p-${r.kind === 'flight' ? 'f-' : ''}${r.id}`} d={r.d} />)}
          </defs>
          <animate id="mapgo" attributeName="opacity" from="1" to="1" dur="0.1s" begin="indefinite" />

          <g class="routes" fill="none" stroke-linecap="square">
            {
              routes.map((r) => (
                <path d={r.d} mask={`url(#m-${r.kind === 'flight' ? 'f-' : ''}${r.id})`} class:list={['route', r.kind, { mainline: r.cat === 'main' }]} style={`--c: ${colorOf(r.cat)}`} />
              ))
            }
            <path d={main.d} mask="url(#m-main)" class="route mainline" style={`--c: ${GOLD}`} />
          </g>
          <g class="shield">{shield.map((c) => <rect x={c.x} y={c.y} width="1" height="1" fill={c.fill} />)}</g>

          <g class="pins">
            {
              pins.map((p) => {
                const l = label(p);
                const w = 3 / p.fills.length;
                return (
                  <g class="pin" style={`--d: ${(0.25 + p.order * 0.18).toFixed(2)}s; transform-origin: ${p.x.toFixed(1)}px ${p.y.toFixed(1)}px`}>
                    <rect x={p.x - 2.5} y={p.y - 2.5} width="5" height="5" fill="#0c0a18" />
                    {p.fills.map((f, i) => (
                      <rect x={p.x - 1.5 + i * w} y={p.y - 1.5} width={w} height="3" fill={f} />
                    ))}
                    <text x={l.x} y={l.y} text-anchor={l.a} class:list={['lbl', { major: p.career }]}>
                      {p.short}
                    </text>
                  </g>
                );
              })
            }
            <rect class="pulse" x={nyc.x - 2.5} y={nyc.y - 2.5} width="5" height="5" fill="none" stroke="#ff6b7f" stroke-width="1" style={`transform-origin: ${nyc.x.toFixed(1)}px ${nyc.y.toFixed(1)}px`} />
          </g>

          <g class="movers">
            {
              movers.map((m) => (
                <g opacity="0">
                  <g transform={m.west ? 'scale(-1 1)' : undefined}>
                    {m.sprite.map((c) => (
                      <rect x={c.x} y={c.y} width="1" height="1" fill={c.fill} />
                    ))}
                  </g>
                  <animateMotion dur={m.dur} begin={m.begin} repeatCount="indefinite" calcMode="linear" keyPoints={m.motion.keyPoints} keyTimes={m.motion.keyTimes}>
                    <mpath href={m.href} />
                  </animateMotion>
                  <animate attributeName="opacity" dur={m.dur} begin={m.begin} repeatCount="indefinite" calcMode="linear" values={m.fade.values} keyTimes={m.fade.keyTimes} />
                </g>
              ))
            }
            <g opacity="0">
              <g class="walk" transform="scale(1.4)">
                {walker.map((frame, i) => (
                  <g class={`wf wf-${i}`}>
                    {frame.map((c) => (
                      <rect x={c.x} y={c.y} width="1" height="1" fill={c.fill} />
                    ))}
                  </g>
                ))}
              </g>
              <animateMotion dur={walk.dur} begin={walk.begin} repeatCount="indefinite" calcMode="linear" keyPoints={walk.motion.keyPoints} keyTimes={walk.motion.keyTimes}>
                <mpath href="#p-main" />
              </animateMotion>
              <animate attributeName="opacity" dur={walk.dur} begin={walk.begin} repeatCount="indefinite" calcMode="linear" values={walk.fade.values} keyTimes={walk.fade.keyTimes} />
            </g>
          </g>

          <g class="clouds">
            {
              clouds.map((c) => (
                <g class="cloud" style={`--dur: ${c.dur}s; --delay: ${c.delay}s`}>
                  {rects(cloudRows, { c: '#0c0a18' }, c.x + 5, c.y + 9).map((r) => (
                    <rect x={r.x} y={r.y} width="1" height="1" fill={r.fill} opacity="0.22" />
                  ))}
                  {rects(cloudRows, { c: '#f2ecf7' }, c.x, c.y).map((r) => (
                    <rect x={r.x} y={r.y} width="1" height="1" fill={r.fill} opacity="0.9" />
                  ))}
                </g>
              ))
            }
          </g>
        </svg>
      </div>
    </div>
    <figcaption class="hint">Swipe to explore the map.</figcaption>
  </figure>

  <div class="lists">
    <section aria-labelledby="mq-title">
      <h3 id="mq-title" class="pixel">Main quest</h3>
      <ol role="list">
        {
          career.map((p, i) => (
            <li>
              <span class="n pixel">{i + 1}</span>
              <div>
                <p class="place">
                  <strong>{p.name}</strong> <span class="when">{p.when}</span>
                </p>
                {stopLogos[p.id] && (
                  <div class="stop-logos">
                    {stopLogos[p.id].map((l) => (
                      <Logo name={l} scale={1.5} caption />
                    ))}
                  </div>
                )}
                <p class="note">{p.note}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>
    <section aria-labelledby="sq-title">
      <h3 id="sq-title" class="pixel">Side quests</h3>
      <ul role="list">
        {
          summary.map((s) => (
            <li>
              <i class="key" style={`--k: ${s.color[0]}`} />
              <div>
                <p class="place">
                  <strong>{s.plural}</strong> <span class="when">{s.count}</span>
                </p>
                <p class="note">{s.places.map((p) => (p.n > 1 ? `${p.name} ×${p.n}` : p.name)).join(' · ')}</p>
              </div>
            </li>
          ))
        }
      </ul>
      <p class="more">
        <a href="#side-quests">Every trip is stamped in the travel log ↓</a>
      </p>
    </section>
  </div>
</section>

<script>
  // Start the map's animation when it scrolls into view; pause it when it leaves.
  const root = document.querySelector<HTMLElement>('[data-map]');
  const svg = root?.querySelector('svg');
  const frame = root?.querySelector<HTMLElement>('[data-frame]');
  if (frame && frame.scrollWidth > frame.clientWidth) {
    const nx = parseFloat(getComputedStyle(frame).getPropertyValue('--nx')) || 0.5;
    frame.scrollLeft = nx * frame.scrollWidth - frame.clientWidth / 2;
  }
  if (root && svg && !matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    root.classList.add('armed');
    let started = false;
    new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting) {
          root.classList.add('play');
          root.classList.remove('paused');
          if (!started) (svg.querySelector('#mapgo') as SVGAnimationElement | null)?.beginElement();
          else svg.unpauseAnimations();
          started = true;
        } else if (started) {
          root.classList.add('paused');
          svg.pauseAnimations();
        }
      },
      { threshold: 0.25 },
    ).observe(root);
  }
</script>

<style>
  .stop-logos {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 6px;
  }

  .map {
    padding: var(--space-s);
    background: #1e2557;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.1rem;
    margin-bottom: var(--space-s);
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  .key {
    display: inline-block;
    flex: none;
    width: 0.8em;
    height: 0.8em;
    margin-right: 0.45em;
    vertical-align: -0.05em;
    background: var(--k);
    box-shadow: inset 0 0 0 2px #0c0a18;
  }

  .key.dots {
    width: 1.4em;
    background: repeating-linear-gradient(90deg, var(--ink-soft) 0 2px, transparent 2px 5px) center / 100% 2px no-repeat;
    box-shadow: none;
  }

  .key.now {
    background: transparent;
    box-shadow: inset 0 0 0 2px var(--red);
  }

  .frame {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
  }

  .canvas {
    position: relative;
    aspect-ratio: 400 / 267;
    min-width: 640px;
  }

  .canvas img,
  .canvas svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
  }

  .hint {
    display: none;
    margin-top: var(--space-xs);
    color: var(--ink-soft);
    font-size: var(--step--1);
    text-align: center;
  }

  @media (max-width: 700px) {
    .hint {
      display: block;
    }
  }

  /* Routes: pixel-dotted lines; flights are sparser dots. */
  .route {
    stroke: var(--c);
    stroke-width: 1.2;
    stroke-dasharray: 2 1.4;
  }

  .route.flight {
    stroke-dasharray: 0.8 2.4;
  }

  .route.mainline {
    stroke-width: 1.6;
    stroke-dasharray: 2.4 1.2;
  }

  .route.flight.mainline {
    stroke-dasharray: 1.2 2;
  }

  /* Draw-on: the mask paths reveal each route. Without JS everything is drawn. */
  .reveal {
    fill: none;
    stroke: #fff;
    stroke-width: 6;
    stroke-dasharray: 1 1;
    stroke-dashoffset: 0;
  }

  .armed .reveal {
    stroke-dashoffset: 1;
  }

  .play .reveal {
    animation: map-draw var(--dur) steps(36) var(--delay) forwards;
  }

  .lbl {
    fill: var(--ink-soft);
    font-family: var(--font-pixel);
    font-size: 6px;
    paint-order: stroke;
    stroke: #0c0a18;
    stroke-width: 1.6px;
    stroke-linejoin: round;
    shape-rendering: auto;
  }

  .lbl.major {
    fill: var(--ink);
    font-size: 6.5px;
  }

  .pin {
    transform-box: view-box;
  }

  .armed .pin {
    opacity: 0;
  }

  .play .pin {
    animation: map-pop 0.3s steps(3) var(--d) forwards;
  }

  .movers {
    opacity: 0;
  }

  .play .movers {
    opacity: 1;
  }

  .wf-1 {
    opacity: 0;
  }

  .pulse {
    transform-box: view-box;
    opacity: 0;
  }

  .play .pulse {
    animation: map-pulse 1.6s steps(4) 2s infinite;
  }

  .play .wf-0,
  .play .wf-1 {
    animation: map-walk 0.5s linear infinite;
  }

  .play .wf-1 {
    animation-delay: -0.25s;
  }

  .cloud {
    transform: translateX(var(--start, 120px));
  }

  @media (prefers-reduced-motion: no-preference) {
    .cloud {
      animation: map-drift var(--dur) linear var(--delay) infinite;
    }
  }

  .paused .cloud,
  .paused .wf-0,
  .paused .wf-1,
  .paused .pulse {
    animation-play-state: paused;
  }

  @keyframes map-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes map-pop {
    0% {
      opacity: 1;
      transform: scale(0);
    }
    70% {
      opacity: 1;
      transform: scale(1.6);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes map-pulse {
    0% {
      opacity: 1;
      transform: scale(1);
    }
    100% {
      opacity: 0;
      transform: scale(3);
    }
  }

  @keyframes map-walk {
    0%,
    49.9% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  @keyframes map-drift {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(480px);
    }
  }

  /* Lists under the map. */
  .lists {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-l);
    margin-top: var(--space-l);
  }

  .lists h3 {
    margin-bottom: var(--space-s);
    color: var(--gold);
    font-size: var(--step-1);
  }

  .lists ol,
  .lists ul {
    display: grid;
    gap: var(--space-s);
  }

  .lists li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.75rem;
    align-items: start;
  }

  .n {
    display: grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    background: var(--gold);
    color: var(--bg);
    font-size: var(--step-0);
    line-height: 1;
  }

  .lists .key {
    margin: 0.35em 0 0;
  }

  .place {
    font-size: var(--step-0);
    line-height: 1.35;
  }

  .when {
    color: var(--teal);
    font-size: var(--step--1);
  }

  .note {
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  .more {
    margin-top: var(--space-s);
    font-size: var(--step--1);
  }

  @media (max-width: 759px) {
    .lists {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
