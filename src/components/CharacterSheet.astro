---
import { Image } from 'astro:assets';
import photo from '../assets/photo/source.jpg';
import { character, stats } from '../data/profile';

const SEGMENTS = 20;
---

<section id="character" class="section wrap" aria-labelledby="character-title">
  <header class="section-head">
    <span class="num">01</span>
    <h2 id="character-title">Character</h2>
  </header>

  <div class="sheet">
    <figure class="photo panel">
      <Image src={photo} alt="Charlie Brockmeier" width={420} height={560} widths={[320, 420, 640]} sizes="(max-width: 759px) 70vw, 300px" />
      <figcaption class="pixel">Real-world render</figcaption>
    </figure>

    <div class="bio">
      {character.bio.map((p) => <p>{p}</p>)}
      <dl class="facts">
        <div><dt class="pixel">Class</dt><dd>{character.className}</dd></div>
        <div><dt class="pixel">Guild</dt><dd>{character.guild}</dd></div>
        <div><dt class="pixel">Origin</dt><dd>{character.origin}</dd></div>
        <div><dt class="pixel">Base</dt><dd>{character.base}</dd></div>
      </dl>
    </div>

    <div class="attrs panel">
      <h3 class="pixel">Attributes</h3>
      <ul role="list">
        {
          stats.map((s) => (
            <li>
              <p class="attr-head">
                <span class="pixel">{s.name}</span>
                <span class="pixel value">{s.value}</span>
              </p>
              <div class="bar" role="meter" aria-valuemin="0" aria-valuemax="100" aria-valuenow={s.value} aria-label={s.name}>
                {Array.from({ length: SEGMENTS }, (_, i) => (
                  <span class:list={{ on: i < Math.round((s.value / 100) * SEGMENTS) }} style={`--i: ${i}`} />
                ))}
              </div>
              <p class="note">{s.note}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

</section>

<style>
  .sheet {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 5fr) minmax(0, 4fr);
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: start;
  }

  .photo {
    padding: 10px;
    background: var(--panel-2);
  }

  .photo :global(img) {
    width: 100%;
    height: auto;
  }

  figcaption {
    padding-top: 8px;
    color: var(--ink-soft);
    font-size: var(--label);
    text-align: center;
  }

  .bio {
    display: grid;
    gap: var(--space-s);
    font-size: var(--step-0);
  }

  .bio p:first-child {
    font-size: var(--step-1);
    line-height: 1.45;
  }

  .facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-s);
    margin-top: var(--space-xs);
  }

  .facts dt {
    color: var(--teal);
    font-size: var(--label);
  }

  .attrs {
    padding: var(--space-m);
  }

  .attrs h3,

  .attrs ul {
    display: grid;
    gap: var(--space-s);
  }

  .attr-head {
    display: flex;
    justify-content: space-between;
  }

  .value {
    color: var(--gold);
  }

  .bar {
    display: grid;
    grid-template-columns: repeat(20, 1fr);
    gap: 2px;
    height: 12px;
    margin-block: 4px 2px;
  }

  .bar span {
    background: var(--line);
  }

  .bar span.on {
    background: var(--teal);
    box-shadow: inset 0 -3px 0 color-mix(in srgb, #000 25%, transparent);
  }

  .note {
    color: var(--ink-soft);
    font-size: var(--step--1);
    line-height: 1.4;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .bar span.on {
        animation: fill linear both;
        animation-timeline: view();
        animation-range: entry calc(var(--i) * 2%) entry calc(30% + var(--i) * 2%);
      }
    }
  }

  @keyframes fill {
    from {
      background: var(--line);
    }
  }






  @media (max-width: 999px) {
    .sheet {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    }

    .attrs {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 639px) {
    .sheet {
      grid-template-columns: minmax(0, 1fr);
    }

    .photo {
      max-width: 280px;
    }
  }
</style>
