---
import { Image } from 'astro:assets';
import photo from '../assets/photo/source.jpg';
import Icon from './Icon.astro';
import SkillTree from './SkillTree.astro';
import { character, stats } from '../data/profile';

const SEGMENTS = 20;

// Radar chart: one axis per attribute, on a 100×100 grid centered at 50,50.
const R = 40;
const point = (i: number, v: number) => {
  const a = -Math.PI / 2 + (i * 2 * Math.PI) / stats.length;
  return [50 + Math.cos(a) * R * v, 50 + Math.sin(a) * R * v].map((n) => n.toFixed(1)).join(',');
};
const ring = (v: number) => stats.map((_, i) => point(i, v)).join(' ');
const shape = stats.map((s, i) => point(i, s.value / 100)).join(' ');
const colorVar: Record<string, string> = { gold: '--gold', teal: '--teal', violet: '--violet', coral: '--coral', blue: '--blue', green: '--green', red: '--red' };
---

<section id="character" class="section wrap" aria-labelledby="character-title">
  <header class="section-head">
    <span class="num">01</span>
    <h2 id="character-title">Character</h2>
  </header>

  <div class="sheet">
    <figure class="photo panel">
      <Image src={photo} alt="Charlie Brockmeier" width={420} height={560} widths={[320, 420, 640]} sizes="(max-width: 759px) 70vw, 300px" />
      <figcaption class="pixel">Real-world render</figcaption>
    </figure>

    <div class="bio">
      {character.bio.map((p) => <p>{p}</p>)}
      <dl class="facts">
        <div><dt class="pixel">Class</dt><dd>{character.className}, subclass {character.subclass}</dd></div>
        <div><dt class="pixel">Guild</dt><dd>{character.guild}</dd></div>
        <div><dt class="pixel">School</dt><dd>{character.school}</dd></div>
        <div><dt class="pixel">Origin</dt><dd>{character.origin}</dd></div>
        <div><dt class="pixel">Base</dt><dd>{character.base}</dd></div>
      </dl>
    </div>

    <div class="attrs panel">
      <div class="attrs-head">
        <h3 class="pixel">Attributes</h3>
        <svg class="radar" viewBox="0 0 100 100" role="img" aria-label={stats.map((s) => `${s.name} ${s.value}`).join(', ')}>
          {[0.25, 0.5, 0.75, 1].map((v) => <polygon points={ring(v)} fill="none" stroke="var(--line)" stroke-width="0.8" />)}
          {stats.map((_, i) => <line x1="50" y1="50" x2={point(i, 1).split(',')[0]} y2={point(i, 1).split(',')[1]} stroke="var(--line)" stroke-width="0.6" />)}
          <polygon class="shape" points={shape} fill="color-mix(in srgb, var(--gold) 30%, transparent)" stroke="var(--gold)" stroke-width="1.4" stroke-linejoin="bevel" />
          {stats.map((s, i) => <rect x={Number(point(i, s.value / 100).split(',')[0]) - 1.6} y={Number(point(i, s.value / 100).split(',')[1]) - 1.6} width="3.2" height="3.2" fill={`var(${colorVar[s.color]})`} />)}
        </svg>
      </div>
      <ul role="list">
        {
          stats.map((s) => (
            <li style={`--c: var(${colorVar[s.color]})`}>
              <p class="attr-head">
                <Icon name={s.icon} color={s.color} scale={1.5} />
                <span class="pixel">{s.name}</span>
                <span class="pixel value">{s.value}</span>
              </p>
              <div class="bar" role="meter" aria-valuemin="0" aria-valuemax="100" aria-valuenow={s.value} aria-label={s.name}>
                {Array.from({ length: SEGMENTS }, (_, i) => (
                  <span class:list={{ on: i < Math.round((s.value / 100) * SEGMENTS) }} style={`--i: ${i}`} />
                ))}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <SkillTree />
</section>

<style>
  .sheet {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 5fr) minmax(0, 4fr);
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: start;
  }

  .photo {
    padding: 10px;
    background: var(--panel-2);
  }

  .photo :global(img) {
    width: 100%;
    height: auto;
  }

  figcaption {
    padding-top: 8px;
    color: var(--ink-soft);
    font-size: var(--label);
    text-align: center;
  }

  .bio {
    display: grid;
    gap: var(--space-s);
    font-size: var(--step-0);
  }

  .bio p:first-child {
    font-size: var(--step-1);
    line-height: 1.45;
  }

  .facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-s);
    margin-top: var(--space-xs);
  }

  .facts dt {
    color: var(--teal);
    font-size: var(--label);
  }

  .attrs {
    padding: var(--space-m);
  }

  .attrs-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    margin-bottom: var(--space-s);
  }

  .attrs h3 {
    color: var(--gold);
    font-size: var(--step-1);
  }

  .radar {
    width: 120px;
    height: 120px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .radar .shape {
      transform-origin: 50px 50px;
      animation: char-grow 1.2s steps(8) both;
    }
  }

  @keyframes char-grow {
    from {
      transform: scale(0.1);
    }
  }

  .attrs ul {
    display: grid;
    gap: var(--space-xs);
  }

  .attr-head {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--step-0);
  }

  .value {
    margin-left: auto;
    color: var(--c);
  }

  .bar {
    display: grid;
    grid-template-columns: repeat(20, 1fr);
    gap: 2px;
    height: 9px;
    margin-block: 4px 2px;
  }

  .bar span {
    background: var(--line);
  }

  .bar span.on {
    background: var(--c);
    box-shadow: inset 0 -3px 0 color-mix(in srgb, #000 25%, transparent);
  }

  .note {
    color: var(--ink-soft);
    font-size: var(--step--1);
    line-height: 1.4;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .bar span.on {
        animation: char-fill linear both;
        animation-timeline: view();
        animation-range: entry calc(var(--i) * 2%) entry calc(30% + var(--i) * 2%);
      }
    }
  }

  @keyframes char-fill {
    from {
      background: var(--line);
    }
  }

  @media (max-width: 999px) {
    .sheet {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    }

    .attrs {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 639px) {
    .sheet {
      grid-template-columns: minmax(0, 1fr);
    }

    .photo {
      max-width: 280px;
    }
  }
</style>
