---
// "Stats nobody asked for": chess up top (live from chess.com at build), then a
// card for everything else.
import Chess from './Chess.astro';
import Icon from './Icon.astro';
import { statBlocks } from '../data/profile';

const cards = statBlocks.filter((b) => b.id !== 'chess');
---

<section id="stats" class="section wrap" aria-labelledby="stats-title">
  <header class="section-head">
    <span class="num">05</span>
    <h2 id="stats-title">Stats</h2>
    <p>Stats nobody asked for, pulled from chess.com and my apps' own recap emails.</p>
  </header>

  <Chess />
  <slot />

  <div class="cards">
    {
      cards.map((b) => (
        <article class="card panel" aria-labelledby={`stat-${b.id}`}>
          <header class="card-head">
            <Icon name={b.icon} color={b.color} scale={2.5} />
            <h3 id={`stat-${b.id}`} class="pixel">
              {b.title}
            </h3>
            <p class="source">{b.source}</p>
          </header>
          <p class:list={['big pixel', b.color]}>{b.big.value}</p>
          <p class="big-label">{b.big.label}</p>
          {b.bars && (
            <ul class="bars" role="list">
              {b.bars.map((bar) => (
                <li>
                  <span class="pixel">{bar.label}</span>
                  <span class="track">
                    <span class="fill" style={`--w: ${Math.max(1.5, (bar.value / Math.max(...b.bars!.map((x) => x.value))) * 100)}%`} />
                  </span>
                  <span class="val">{bar.display}</span>
                </li>
              ))}
            </ul>
          )}
          <dl class="rows">
            {b.rows.map(([k, v]) => (
              <div>
                <dt>{k}</dt>
                <dd class="pixel">{v}</dd>
              </div>
            ))}
          </dl>
          {b.quip && <p class="quip">{b.quip}</p>}
        </article>
      ))
    }
  </div>
</section>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-s);
    margin-top: var(--space-s);
  }

  .card {
    display: flex;
    flex-direction: column;
    padding: clamp(1rem, 2vw, 1.4rem);
  }

  .card-head {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.3rem 0.6rem;
  }

  .card-head h3 {
    font-size: var(--step-2);
    line-height: 1;
  }

  .source {
    margin-left: auto;
    color: var(--ink-soft);
    font-size: 0.75rem;
  }

  .big {
    margin-top: var(--space-s);
    color: var(--gold);
    font-size: clamp(2rem, 1.5rem + 1.6vw, 2.75rem);
    line-height: 0.9;
    font-size-adjust: cap-height 0.7;
  }

  .big.teal {
    color: var(--teal);
  }

  .big.red {
    color: var(--red);
  }

  .big.blue {
    color: var(--blue);
  }

  .big.violet {
    color: var(--violet);
  }

  .big.green {
    color: var(--green);
  }

  .big-label {
    margin-top: var(--space-2xs);
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  .bars {
    display: grid;
    gap: 0.35rem;
    margin-top: var(--space-s);
  }

  .bars li {
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
  }

  .track {
    height: 10px;
    background: var(--bg);
    box-shadow: inset 0 0 0 2px var(--line);
  }

  .fill {
    display: block;
    width: var(--w);
    height: 100%;
    background: repeating-linear-gradient(90deg, var(--teal) 0 6px, transparent 6px 8px);
  }

  .val {
    color: var(--ink-soft);
  }

  /* Label ........ value rows */
  .rows {
    display: grid;
    gap: 0.3rem;
    margin-block: var(--space-s);
  }

  .rows div {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .rows dt {
    display: flex;
    flex: 1;
    align-items: baseline;
    gap: 0.5rem;
    min-width: 0;
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  .rows dt::after {
    content: '';
    flex: 1;
    min-width: 0.75rem;
    border-bottom: 2px dotted var(--line);
  }

  .rows dd {
    font-size: var(--step-0);
    line-height: 1.1;
    text-align: right;
    font-size-adjust: cap-height 0.7;
  }

  .quip {
    margin-top: auto;
    padding-top: var(--space-s);
    border-top: 2px dashed var(--line);
    color: var(--ink-soft);
    font-size: var(--step--1);
    font-style: italic;
  }

  @media (max-width: 999px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 639px) {
    .cards {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
