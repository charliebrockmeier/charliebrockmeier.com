---
// "Stats nobody asked for": chess up top (the streak as a calendar, September as a
// waffle of every game), then smaller cards for everything else.
import Icon from './Icon.astro';
import { chess, statBlocks } from '../data/profile';

const [chessBlock, ...cards] = statBlocks;

// Streak calendar: one square per day, weeks as columns, ending on streakAsOf.
const DAY = 86_400_000;
const end = new Date(`${chess.streakAsOf}T12:00:00Z`);
const start = new Date(end.getTime() - (chess.streakDays - 1) * DAY);
const offset = start.getUTCDay();
const weeks = Math.ceil((offset + chess.streakDays) / 7);
const columns = Array.from({ length: weeks }, (_, c) => {
  const first = Math.max(0, c * 7 - offset);
  const last = Math.min(chess.streakDays - 1, c * 7 + 6 - offset);
  return { x: c, y: (offset + first) % 7, h: last - first + 1 };
});
// Label every other month; add the year to the first label and when it changes.
const months: { col: number; label: string }[] = [];
let lastYear = 0;
for (let i = 0, n = 0; i < chess.streakDays; i++) {
  const d = new Date(start.getTime() + i * DAY);
  if (d.getUTCDate() !== 1 && i !== 0) continue;
  if (n++ % 2) continue;
  const month = d.toLocaleString('en-US', { month: 'short', timeZone: 'UTC' });
  const year = d.getUTCFullYear();
  months.push({ col: Math.floor((offset + i) / 7), label: year !== lastYear ? `${month} ’${String(year).slice(2)}` : month });
  lastYear = year;
}
const lastCol = Math.floor((offset + chess.streakDays - 1) / 7);
const lastRow = (offset + chess.streakDays - 1) % 7;
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

// September waffle: 25 × 11 = 275 games, wins first.
const COLS = 25;
const winRows = Math.floor(chess.wins / COLS);
const winRem = chess.wins % COLS;
const rows = Math.ceil(chess.games / COLS);
---

<section id="stats" class="section wrap" aria-labelledby="stats-title">
  <header class="section-head">
    <span class="num">02</span>
    <h2 id="stats-title">Stats</h2>
    <p>Stats nobody asked for, pulled from my apps' own recap emails.</p>
  </header>

  <article class="feature panel" aria-labelledby="chess-title">
    <header class="card-head">
      <Icon name={chessBlock.icon} color={chessBlock.color} scale={3} />
      <h3 id="chess-title" class="pixel">{chessBlock.title}</h3>
      <p class="source">{chessBlock.source}</p>
    </header>

    <div class="feature-grid">
      <div class="streak">
        <p class="big pixel"><Icon name="fire" color="coral" scale={4} class="flame" />{chess.streak}</p>
        <p class="big-label">{chessBlock.big.label}</p>
        <figure class="calendar">
          <div class="months" aria-hidden="true">
            {months.map((m) => <span style={`left: ${(m.col / weeks) * 100}%`}>{m.label}</span>)}
          </div>
          <svg viewBox={`0 0 ${weeks} 7`} shape-rendering="crispEdges" role="img" aria-label={`${chess.streakDays} days in a row, from ${fmt(start)} to ${fmt(end)}`}>
            <defs>
              <pattern id="day" width="1" height="1" patternUnits="userSpaceOnUse">
                <rect width="0.78" height="0.78" fill="var(--gold)" />
              </pattern>
            </defs>
            {columns.map((c) => <rect x={c.x} y={c.y} width="1" height={c.h} fill="url(#day)" />)}
            <rect class="today" x={lastCol - 0.12} y={lastRow - 0.12} width="1.02" height="1.02" fill="none" stroke="var(--ink)" stroke-width="0.14" />
          </svg>
          <figcaption>One square per day. {fmt(start)} to {fmt(end)}, no gaps.</figcaption>
        </figure>
      </div>

      <div class="month">
        <figure class="waffle">
          <figcaption class="pixel">{chess.month}: every game</figcaption>
          <svg viewBox={`0 0 ${COLS} ${rows}`} shape-rendering="crispEdges" role="img" aria-label={`${chess.games} games: ${chess.wins} wins, ${chess.games - chess.wins} losses or draws`}>
            <defs>
              <pattern id="win" width="1" height="1" patternUnits="userSpaceOnUse">
                <rect width="0.8" height="0.8" fill="var(--teal)" />
              </pattern>
              <pattern id="other" width="1" height="1" patternUnits="userSpaceOnUse">
                <rect width="0.8" height="0.8" fill="var(--line)" />
              </pattern>
            </defs>
            <rect width={COLS} height={winRows} fill="url(#win)" />
            <rect y={winRows} width={winRem} height="1" fill="url(#win)" />
            <rect x={winRem} y={winRows} width={COLS - winRem} height="1" fill="url(#other)" />
            <rect y={winRows + 1} width={COLS} height={rows - winRows - 1} fill="url(#other)" />
          </svg>
          <p class="legend">
            <span><i class="sw win"></i>{chess.wins} wins</span>
            <span><i class="sw other"></i>{chess.games - chess.wins} losses or draws</span>
          </p>
        </figure>
      </div>
    </div>
    <dl class="tiles">
      {
        chessBlock.rows.map(([k, v]) => (
          <div>
            <dd class="pixel">{v}</dd>
            <dt>{k}</dt>
          </div>
        ))
      }
    </dl>
    {chessBlock.quip && <p class="quip">{chessBlock.quip}</p>}
  </article>

  <div class="cards">
    {
      cards.map((b) => (
        <article class="card panel" aria-labelledby={`stat-${b.id}`}>
          <header class="card-head">
            <Icon name={b.icon} color={b.color} scale={2.5} />
            <h3 id={`stat-${b.id}`} class="pixel">
              {b.title}
            </h3>
            <p class="source">{b.source}</p>
          </header>
          <p class:list={['big pixel', b.color]}>{b.big.value}</p>
          <p class="big-label">{b.big.label}</p>
          {b.bars && (
            <ul class="bars" role="list">
              {b.bars.map((bar) => (
                <li>
                  <span class="pixel">{bar.label}</span>
                  <span class="track">
                    <span class="fill" style={`--w: ${Math.max(1.5, (bar.value / Math.max(...b.bars!.map((x) => x.value))) * 100)}%`} />
                  </span>
                  <span class="val">{bar.display}</span>
                </li>
              ))}
            </ul>
          )}
          <dl class="rows">
            {b.rows.map(([k, v]) => (
              <div>
                <dt>{k}</dt>
                <dd class="pixel">{v}</dd>
              </div>
            ))}
          </dl>
          {b.quip && <p class="quip">{b.quip}</p>}
        </article>
      ))
    }
  </div>
</section>

<style>
  .panel {
    padding: clamp(1.1rem, 2.5vw, 1.75rem);
  }

  .card-head {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem 0.75rem;
  }

  .card-head h3 {
    font-size: var(--step-2);
    line-height: 1;
  }

  .source {
    margin-left: auto;
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  .big {
    display: flex;
    align-items: center;
    gap: 0.25em;
    margin-top: var(--space-s);
    color: var(--gold);
    font-size: clamp(2.75rem, 1.8rem + 3vw, 4.5rem);
    line-height: 0.9;
    font-size-adjust: cap-height 0.7;
  }

  .big.teal {
    color: var(--teal);
  }

  .big.red {
    color: var(--red);
  }

  .big.blue {
    color: var(--blue);
  }

  .big.violet {
    color: var(--violet);
  }

  .big.green {
    color: var(--green);
  }

  .big-label {
    margin-top: var(--space-2xs);
    color: var(--ink-soft);
  }

  /* Chess feature */
  .feature {
    background: linear-gradient(160deg, #2b2350, var(--panel) 55%);
  }

  .feature-grid {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    align-items: end;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    margin-top: var(--space-xs);
  }

  .feature .big {
    font-size: clamp(4rem, 2.5rem + 6vw, 7.5rem);
  }

  .big :global(.flame) {
    width: 0.62em;
    height: auto;
  }

  @media (prefers-reduced-motion: no-preference) {
    .big :global(.flame) {
      animation: flicker 0.9s steps(2) infinite;
    }

    .today {
      animation: pulse 1.2s steps(2) infinite;
    }
  }

  .calendar {
    margin-top: var(--space-m);
  }

  .months {
    position: relative;
    height: 1.4em;
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  .months span {
    position: absolute;
    top: 0;
    white-space: nowrap;
  }

  /* Only the year markers fit on narrow screens. */
  @media (max-width: 759px) {
    .months span:not(:first-child) {
      display: none;
    }
  }

  .calendar svg,
  .waffle svg {
    width: 100%;
    height: auto;
  }

  .calendar figcaption {
    margin-top: var(--space-xs);
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  .waffle figcaption {
    margin-bottom: var(--space-xs);
    color: var(--teal);
    font-size: var(--step-1);
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin-top: var(--space-xs);
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  .sw {
    display: inline-block;
    width: 0.7em;
    height: 0.7em;
    margin-right: 0.4em;
    vertical-align: -0.05em;
  }

  .sw.win {
    background: var(--teal);
  }

  .sw.other {
    background: var(--line);
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-xs);
    margin-top: var(--space-l);
  }

  .tiles div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    padding: 0.7rem 0.9rem;
    background: color-mix(in srgb, var(--bg) 55%, transparent);
    box-shadow: inset 0 0 0 2px var(--line);
  }

  .tiles dd {
    color: var(--ink);
    font-size: var(--step-2);
    line-height: 1;
    font-size-adjust: cap-height 0.7;
  }

  .tiles dt {
    margin-bottom: 0.3rem;
    color: var(--ink-soft);
    font-size: var(--step--1);
    line-height: 1.3;
  }

  /* Label ........ value rows */
  .rows {
    display: grid;
    gap: 0.35rem;
    margin-top: var(--space-m);
  }

  .rows div {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .rows dt {
    display: flex;
    flex: 1;
    align-items: baseline;
    gap: 0.5rem;
    min-width: 0;
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  .rows dt::after {
    content: '';
    flex: 1;
    min-width: 1rem;
    border-bottom: 2px dotted var(--line);
  }

  .rows dd {
    font-size: var(--step-1);
    line-height: 1.1;
    text-align: right;
    font-size-adjust: cap-height 0.7;
  }

  .quip {
    margin-top: var(--space-m);
    padding-top: var(--space-s);
    border-top: 2px dashed var(--line);
    color: var(--ink-soft);
    font-size: var(--step--1);
    font-style: italic;
  }

  /* Small cards */
  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-m);
    margin-top: var(--space-m);
  }

  .card {
    display: flex;
    flex-direction: column;
  }

  .card .quip {
    margin-top: auto;
  }

  .card .rows {
    margin-bottom: var(--space-s);
  }

  .bars {
    display: grid;
    gap: 0.4rem;
    margin-top: var(--space-s);
  }

  .bars li {
    display: grid;
    grid-template-columns: 2.6rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--step--1);
  }

  .track {
    height: 12px;
    background: var(--bg);
    box-shadow: inset 0 0 0 2px var(--line);
  }

  .fill {
    display: block;
    width: var(--w);
    height: 100%;
    background: repeating-linear-gradient(90deg, var(--teal) 0 6px, transparent 6px 8px);
  }

  .val {
    color: var(--ink-soft);
  }

  @keyframes flicker {
    50% {
      transform: translateY(-2px) scaleX(-1);
    }
  }

  @keyframes pulse {
    50% {
      opacity: 0;
    }
  }

  @media (max-width: 999px) {
    .feature-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 639px) {
    .cards {
      grid-template-columns: minmax(0, 1fr);
    }

    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
