---
import { party } from '../data/profile';
---

<section id="party" class="band" aria-labelledby="party-title">
  <div class="wrap section">
    <header class="section-head">
      <span class="num">04</span>
      <h2 id="party-title">Party</h2>
      <p>The AI agents I actually run. Each one has a single job, a schedule, and a human who signs off.</p>
    </header>
    <ul class="party" role="list">
      {
        party.map((m) => (
          <li class="member panel">
            <p class="cls pixel">
              {m.cls} · {m.cadence}
            </p>
            <h3 class="pixel">{m.name}</h3>
            <p class="job">{m.job}</p>
            <p class="does">{m.does}</p>
            <p class="human">
              <span class="pixel">Human in the loop</span> {m.human}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .band {
    margin-top: clamp(4rem, 9vw, 7rem);
    padding-bottom: clamp(4rem, 9vw, 7rem);
    background:
      repeating-linear-gradient(0deg, transparent 0 3px, rgb(0 0 0 / 0.12) 3px 4px),
      linear-gradient(160deg, #173a48, #1c2148);
    border-block: 2px solid #2b5a6a;
  }

  .band .section-head .num {
    color: var(--teal);
  }

  .band .section-head p {
    color: #b9d8d3;
  }

  .party {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-m);
  }

  .member {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-m);
    background: #141a36;
    box-shadow:
      inset 0 0 0 var(--px) #22605a,
      var(--px) var(--px) 0 0 var(--shadow);
  }

  .cls {
    color: var(--teal);
    font-size: var(--label);
  }

  h3 {
    font-size: var(--step-2);
    font-weight: 700;
  }

  .job {
    color: var(--gold);
    font-weight: 600;
  }

  .does {
    flex: 1;
    color: #d5e4e2;
  }

  .human {
    padding-top: var(--space-xs);
    border-top: 2px dashed #2b5a6a;
    color: #b9d8d3;
    font-size: var(--step--1);
  }

  .human .pixel {
    display: block;
    color: var(--teal);
  }

  @media (max-width: 999px) {
    .party {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 559px) {
    .party {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
