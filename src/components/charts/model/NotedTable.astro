---
// A numbered table whose rows can carry a line of explanation underneath, spanning the
// full width, and can be grouped under headings. Used for the model's matrix, where
// each portfolio comes with the reason it differs from its neighbors. Same frame as
// the paper's other tables; scrolls inside its own container on a phone.
import { cite } from '../lib';

interface Row {
  cells: string[];
  /** Explanation shown under the row. */
  why?: string;
  /** Start a group with this heading above the row. */
  group?: string;
}

interface Props {
  id: string;
  n?: number | string;
  title: string;
  subtitle?: string;
  source: string;
  note?: string;
  columns: { label: string; align?: 'left' | 'right' }[];
  rows: Row[];
  minWidth?: number;
}

const { id, n, title, subtitle, source, note, columns, rows, minWidth = 560 } = Astro.props;
---

<figure class="chart data-table noted" id={id} aria-labelledby={`${id}-t`}>
  <figcaption class="chart-head">
    <p class="chart-title" id={`${id}-t`}>
      {n !== undefined && <span class="chart-n">Table {n}.</span>}
      {title}
    </p>
    {subtitle && <p class="chart-sub">{subtitle}</p>}
  </figcaption>
  <div class="table-scroll" tabindex="0" role="region" aria-label={title}>
    <table style={`min-width:${minWidth}px`}>
      <thead>
        <tr>
          {columns.map((c) => <th scope="col" class={c.align === 'right' ? 'num' : undefined}>{c.label}</th>)}
        </tr>
      </thead>
      <tbody>
        {
          rows.map((r) => (
            <>
              {r.group && (
                <tr class="group">
                  <th scope="colgroup" colspan={columns.length}>
                    {r.group}
                  </th>
                </tr>
              )}
              <tr class:list={{ 'has-why': r.why }}>
                {r.cells.map((cell, i) =>
                  i === 0 ? <th scope="row" set:html={cite(cell)} /> : <td class={columns[i]?.align === 'right' ? 'num' : undefined} set:html={cite(cell)} />,
                )}
              </tr>
              {r.why && (
                <tr class="why">
                  <td colspan={columns.length}>
                    <div class="why-text" set:html={cite(r.why)} />
                  </td>
                </tr>
              )}
            </>
          ))
        }
      </tbody>
    </table>
  </div>
  {note && <p class="chart-note" set:html={cite(note)} />}
  <p class="chart-source" set:html={cite(`Source: ${source}`)} />
</figure>

<style>
  table {
    width: 100%;
    margin-top: 0.75rem;
    border-collapse: collapse;
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  th,
  td {
    padding: 0.4rem 0.6rem 0.4rem 0;
    border-bottom: 1px solid var(--rule, #e2dccd);
    text-align: left;
    vertical-align: top;
  }

  thead th {
    border-bottom: 1px solid var(--ink, #1b1533);
    color: var(--ink-soft, #4f4868);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    vertical-align: bottom;
  }

  tbody th {
    font-weight: 600;
  }

  .num {
    text-align: right;
    font-variant-numeric: lining-nums;
  }

  td.num {
    white-space: nowrap;
  }

  tr.group th {
    padding-top: 0.9rem;
    border-bottom: 1px solid var(--ink, #1b1533);
    color: var(--accent, #7a3460);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  tr.has-why th,
  tr.has-why td {
    padding-bottom: 0.1rem;
    border-bottom: 0;
  }

  tr.why td {
    padding-top: 0;
    padding-bottom: 0.45rem;
    color: var(--ink-soft, #4f4868);
    font-size: 0.75rem;
    line-height: 1.4;
  }

  /* On a phone the table scrolls sideways; the explanation stays put and wraps to the screen. */
  .noted .table-scroll {
    container-type: inline-size;
  }

  .why-text {
    position: sticky;
    left: 0;
    width: 100cqw;
    max-width: 100%;
  }

  @media print {
    .table-scroll {
      overflow: visible;
    }

    table {
      min-width: 0 !important;
      font-size: 8pt;
    }

    tr.why td {
      font-size: 7pt;
    }
  }
</style>
