---
// The career as a progression, oldest chapter first. A skill tree up top shows four
// tracks leveling up chapter by chapter (finance and AI meet at Vantager); each card
// lists what leveled up there and where it paid off later.
import Logo from './Logo.astro';
import { quests, type Track } from '../data/profile';

const TRACKS: { key: Track; label: string; color: string }[] = [
  { key: 'finance', label: 'Finance', color: 'var(--gold)' },
  { key: 'code', label: 'Code', color: 'var(--blue)' },
  { key: 'ai', label: 'AI', color: 'var(--teal)' },
  { key: 'lead', label: 'Leadership', color: 'var(--coral)' },
];
const MAX = 10;
const trackColor = Object.fromEntries(TRACKS.map((t) => [t.key, t.color]));

// Chart geometry: one column per chapter plus one for the chapter that hasn't
// happened yet, levels 0–10 bottom to top.
const W = 640;
const H = 196;
const x = (i: number) => 60 + i * ((W - 104) / quests.length);
const NEXT = quests.length;
const y = (level: number) => 160 - level * 13;
// Each track runs a few pixels off the others, like lines on a transit map, so two
// tracks at the same level sit side by side instead of hiding one another.
const off = (k: number) => (k - 1.5) * 5;
// Stepped lines read as pixel art: across to the midpoint, up, across.
const path = (key: Track, k: number) =>
  quests
    .map((q, i) => {
      const lv = y(q.levels[key]) + off(k);
      if (i === 0) return `M ${x(0)} ${lv}`;
      const mid = (x(i - 1) + x(i)) / 2 + off(k);
      return `H ${mid} V ${lv} H ${x(i)}`;
    })
    .join(' ');
const meet = quests.findIndex((q) => q.title === 'Vantager');
const short = (chapter: string) => (chapter === 'Prologue' ? 'Start' : chapter.replace('Chapter ', 'Ch '));
const final = quests.at(-1)!.levels;
// Where each track heads next: a dashed line out to the open column.
const ahead = (key: Track, k: number) => `M ${x(NEXT - 1)} ${y(final[key]) + off(k)} H ${x(NEXT) - 10}`;
---

<section id="quests" class="section wrap" aria-labelledby="quests-title">
  <header class="section-head">
    <span class="num">03</span>
    <h2 id="quests-title">Quest log</h2>
    <p>Each chapter and what it added. Finance first, then code, then AI, which came together at Vantager.</p>
  </header>

  <figure class="tree panel" data-reveal>
    <figcaption>
      <span class="pixel">Skill tree</span>
      <span class="hint">Levels after each chapter, out of 10. The last column is still open.</span>
    </figcaption>
    <svg
      viewBox={`0 0 ${W} ${H}`}
      role="img"
      aria-label={TRACKS.map((t) => `${t.label}: ${quests.map((q) => q.levels[t.key]).join(', ')}`).join('; ')}
    >
      {[0, 2, 4, 6, 8, 10].map((lv) => <line x1="44" x2={W - 28} y1={y(lv)} y2={y(lv)} class="grid" />)}
      {quests.map((_, i) => <line x1={x(i)} x2={x(i)} y1={y(0)} y2={y(MAX)} class="grid col" />)}
      <g class="next-col">
        <rect x={x(NEXT) - 14} y={y(MAX) - 4} width="28" height={y(0) - y(MAX) + 8} />
        <text x={x(NEXT)} y={y(5) + 6} text-anchor="middle">?</text>
      </g>
      {TRACKS.map((t, k) => <path d={ahead(t.key, k)} class="ahead" style={`--c: ${t.color}`} />)}
      {meet > -1 && (
        <g class="meet">
          <rect x={x(meet) - 24} y={y(9.7)} width="48" height={y(5.6) - y(9.7)} />
          <text x={x(meet)} y={y(10.2)} text-anchor="middle">Finance × AI</text>
        </g>
      )}
      {TRACKS.map((t, k) => <path d={path(t.key, k)} class="line" style={`--c: ${t.color}; --d: ${k * 0.25}s`} pathLength="1" />)}
      {TRACKS.map((t, k) =>
        quests.map((q, i) => (
          <rect
            class="pt"
            x={x(i) - 4}
            y={y(q.levels[t.key]) + off(k) - 4}
            width="8"
            height="8"
            style={`--c: ${t.color}; --d: ${0.5 + k * 0.25 + i * 0.12}s`}
          />
        )),
      )}
      {quests.map((q, i) => (
        <text class="tick" x={x(i)} y={H - 8} text-anchor="middle">
          {short(q.chapter)}
        </text>
      ))}
      <text class="tick next" x={x(NEXT)} y={H - 8} text-anchor="middle">
        Next
      </text>
      {[0, 5, 10].map((lv) => (
        <text class="tick lv" x="34" y={y(lv) + 4} text-anchor="end">
          {lv}
        </text>
      ))}
    </svg>
    <ul class="legend" role="list">
      {TRACKS.map((t) => (
        <li style={`--c: ${t.color}`}>
          <i />
          {t.label} <b class="pixel">Lv {final[t.key]} so far</b>
        </li>
      ))}
    </ul>
  </figure>

  <ol class="path" role="list">
    {
      quests.map((q, i) => {
        const prev = quests[i - 1]?.levels ?? { finance: 0, code: 0, ai: 0, lead: 0 };
        return (
          <li class:list={['stop', q.status]} data-reveal>
            <span class="node" aria-hidden="true" />
            <article class="quest panel">
              <figure class="scene">
                <img src={q.scene.src} width="192" height="64" alt={q.scene.alt} loading="lazy" decoding="async" />
                <figcaption class="pixel">{q.scene.place}</figcaption>
              </figure>
              <div class="body">
                <p class="meta pixel">
                  <span>{q.chapter}</span>
                  <span class="chip">{q.status === 'active' ? 'Active' : 'Complete'}</span>
                  <span class="when">{q.when}</span>
                </p>
                <div class="title">
                  <h3>{q.title}</h3>
                  <span class="emblems">
                    {q.emblems.map((name) => (
                      <Logo name={name} scale={2} caption class="emblem" />
                    ))}
                  </span>
                </div>
                <p class="sub">
                  {q.role} · {q.where}
                </p>
                <p class="summary">{q.summary}</p>
                <ul class="objectives" role="list">
                  {q.objectives.map((o, j) => (
                    <li class:list={{ open: q.status === 'active' && j === q.objectives.length - 1 }}>{o}</li>
                  ))}
                </ul>

                <div class="ups">
                  <p class="label pixel">Level ups</p>
                  <ul role="list">
                    {q.levelUps.map((u, j) => (
                      <li style={`--c: ${trackColor[u.track]}; --d: ${j * 0.12}s`}>
                        <span class="delta pixel">{u.up === 'new' ? 'NEW' : `+${u.up}`}</span>
                        <span class="skill">{u.skill}</span>
                        {u.carries && <span class="carries">→ {u.carries}</span>}
                      </li>
                    ))}
                  </ul>
                </div>

                {q.extras && (
                  <details class="extras" open>
                    <summary class="label pixel">Also in college · {q.extras.length} side quests</summary>
                    <ul role="list">
                      {q.extras.map((e, j) => (
                        <li style={`--d: ${j * 0.05}s`}>
                          <strong>{e.name}</strong>
                          <span>{e.note}</span>
                        </li>
                      ))}
                    </ul>
                  </details>
                )}

                <div class="progress">
                  <dl class="levels">
                    {TRACKS.map((t) => (
                      <div style={`--c: ${t.color}`}>
                        <dt class="pixel">{t.label}</dt>
                        <dd aria-label={`${t.label} level ${q.levels[t.key]} of ${MAX}`}>
                          {Array.from({ length: MAX }, (_, k) => (
                            <i
                              class:list={{ on: k < q.levels[t.key], new: k >= prev[t.key] && k < q.levels[t.key] }}
                              style={`--d: ${k * 0.05}s`}
                            />
                          ))}
                        </dd>
                      </div>
                    ))}
                  </dl>
                  <p class="loot pixel">
                    <span>Unlocked: {q.unlocked}</span>
                    <span>Reward: {q.reward}</span>
                  </p>
                  {q.link && (
                    <a class="paper-link pixel" href={q.link.url}>
                      {q.link.label} →
                    </a>
                  )}
                </div>
              </div>
            </article>
          </li>
        );
      })
    }
    <li class="stop upcoming" data-reveal>
      <span class="node" aria-hidden="true" />
      <article class="quest panel next-quest">
        <div class="next-art" aria-hidden="true">
          <span class="pixel">?</span>
        </div>
        <div class="body">
          <p class="meta pixel">
            <span>Chapter {quests.length}</span>
            <span class="chip">Not started</span>
            <span class="when">Someday</span>
          </p>
          <h3>To be continued</h3>
          <p class="summary">
            7 World Trade is where I am now, not where this ends. The world keeps turning and this log keeps going: new chapters, new
            skills and new side quests get added as they happen.
          </p>
          <p class="loot pixel">
            <span>Unlocked: ???</span>
            <span class="loading">Loading next chapter</span>
          </p>
        </div>
      </article>
    </li>
  </ol>
</section>

<script>
  // Reveal the chart and each card as they scroll into view. Without JS, or with
  // reduced motion, everything is simply shown.
  const section = document.getElementById('quests');
  if (section && 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    section.classList.add('animate');
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.classList.add('seen');
          io.unobserve(e.target);
        }
      },
      { rootMargin: '0px 0px -10% 0px' },
    );
    section.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
  }
</script>

<style>
  /* Skill tree */
  .tree {
    margin-bottom: var(--space-s);
    padding: var(--space-s) clamp(0.75rem, 2vw, 1.4rem) var(--space-xs);
  }

  .tree figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem var(--space-xs);
  }

  .tree figcaption .pixel {
    color: var(--gold);
    font-size: var(--step-1);
  }

  .hint {
    color: var(--ink-soft);
    font-size: 0.75rem;
  }

  .tree svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .grid {
    stroke: var(--line);
    stroke-width: 1;
    stroke-dasharray: 2 4;
  }

  .grid.col {
    stroke-dasharray: 1 5;
  }

  .next-col rect {
    fill: color-mix(in srgb, var(--ink) 4%, transparent);
    stroke: var(--line);
    stroke-width: 1.5;
    stroke-dasharray: 3 3;
  }

  .next-col text {
    fill: var(--ink-soft);
    font-family: var(--font-pixel);
    font-size: 22px;
  }

  .ahead {
    fill: none;
    stroke: var(--c);
    stroke-width: 3;
    stroke-dasharray: 4 5;
    opacity: 0.55;
  }

  .tick.next {
    fill: var(--ink-soft);
  }

  .next-quest {
    grid-template-columns: minmax(0, 260px) minmax(0, 1fr);
    opacity: 0.85;
  }

  .next-art {
    display: grid;
    place-items: center;
    aspect-ratio: 3;
    background: repeating-linear-gradient(45deg, var(--panel-2) 0 8px, var(--panel) 8px 16px);
    box-shadow: inset 0 0 0 2px var(--line);
  }

  .next-art span {
    color: var(--ink-soft);
    font-size: 2.5rem;
  }

  .upcoming .node {
    background: transparent;
    box-shadow:
      inset 0 0 0 3px var(--line),
      0 0 0 3px var(--bg);
  }

  .loading::after {
    content: '...';
    display: inline-block;
    width: 1.5em;
    overflow: hidden;
    vertical-align: bottom;
  }

  @media (prefers-reduced-motion: no-preference) {
    .ahead {
      animation: quest-march 1.2s steps(4) infinite;
    }

    .next-col text {
      animation: quest-glow 1.6s steps(2) infinite;
    }

    .loading::after {
      animation: quest-dots 1.6s steps(4) infinite;
    }
  }

  @keyframes quest-march {
    to {
      stroke-dashoffset: -9;
    }
  }

  @keyframes quest-dots {
    from {
      width: 0;
    }
    to {
      width: 1.5em;
    }
  }

  .line {
    fill: none;
    stroke: var(--c);
    stroke-width: 3.5;
    shape-rendering: crispEdges;
  }

  .pt {
    fill: var(--c);
    stroke: var(--panel, var(--bg));
    stroke-width: 2;
  }

  .meet rect {
    fill: color-mix(in srgb, var(--teal) 10%, transparent);
    stroke: var(--teal);
    stroke-width: 1.5;
    stroke-dasharray: 3 3;
  }

  .meet text,
  .tick {
    fill: var(--ink-soft);
    font-family: var(--font-pixel);
    font-size: 13px;
  }

  .meet text {
    fill: var(--teal);
  }

  .tick.lv {
    font-size: 11px;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem var(--space-m);
    margin-top: 0.25rem;
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  .legend i {
    display: inline-block;
    width: 10px;
    height: 10px;
    margin-right: 0.35rem;
    background: var(--c);
  }

  .legend b {
    color: var(--c);
    font-weight: 400;
  }

  /* Timeline of chapters */
  .path {
    position: relative;
    display: grid;
    gap: var(--space-s);
    padding-left: 28px;
  }

  .path::before {
    content: '';
    position: absolute;
    top: 12px;
    bottom: 12px;
    left: 9px;
    width: 4px;
    background: repeating-linear-gradient(var(--line) 0 8px, transparent 8px 14px);
  }

  .stop {
    position: relative;
  }

  .node {
    position: absolute;
    top: 22px;
    left: -26px;
    width: 14px;
    height: 14px;
    background: var(--line);
    box-shadow: 0 0 0 3px var(--bg);
  }

  .active .node {
    background: var(--gold);
  }

  .quest {
    display: grid;
    grid-template-columns: minmax(0, 260px) minmax(0, 1fr);
    gap: var(--space-m);
    padding: var(--space-s);
  }

  .scene {
    position: relative;
    align-self: start;
    overflow: hidden;
  }

  .scene img {
    display: block;
    width: 100%;
    height: auto;
    image-rendering: pixelated;
    box-shadow: inset 0 0 0 2px var(--line);
  }

  .scene figcaption {
    position: absolute;
    right: 6px;
    bottom: 6px;
    padding: 0 0.4em;
    background: color-mix(in srgb, var(--shadow) 80%, transparent);
    font-size: 0.75rem;
  }

  .meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.25rem var(--space-xs);
    color: var(--ink-soft);
    font-size: var(--label);
  }

  .chip {
    padding: 0 0.45em;
    background: var(--line);
    color: var(--ink);
  }

  .active .chip {
    background: var(--gold);
    color: var(--bg);
  }

  .when {
    margin-left: auto;
  }

  .title {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem 0.75rem;
    margin-top: 0.15rem;
  }

  h3 {
    font-size: var(--step-2);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .emblems {
    display: flex;
    align-items: start;
    gap: 8px;
  }

  .sub {
    color: var(--teal);
    font-size: var(--step--1);
  }

  .summary {
    margin-top: var(--space-xs);
    font-size: var(--step--1);
  }

  .objectives {
    display: grid;
    gap: 2px;
    margin-top: var(--space-xs);
  }

  .objectives li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  .objectives li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.35em;
    width: 0.8em;
    height: 0.8em;
    background:
      linear-gradient(var(--teal), var(--teal)) center / 45% 45% no-repeat,
      var(--bg);
    box-shadow: inset 0 0 0 2px var(--teal);
  }

  .objectives li.open::before {
    background: var(--bg);
    box-shadow: inset 0 0 0 2px var(--gold);
  }

  .label {
    color: var(--gold);
    font-size: var(--label);
  }

  /* Level ups: each chip says what grew and where it paid off later */
  .ups {
    margin-top: var(--space-s);
  }

  .ups ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 4px;
  }

  .ups li {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.4rem;
    max-width: 100%;
    padding: 0.2rem 0.55rem 0.25rem;
    background: color-mix(in srgb, var(--c) 9%, var(--bg));
    box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--c) 55%, transparent);
    font-size: 0.8125rem;
  }

  .delta {
    color: var(--c);
    font-size: var(--label);
  }

  .carries {
    color: var(--ink-soft);
    font-size: 0.75rem;
  }

  /* College side quests */
  .extras {
    margin-top: var(--space-s);
  }

  .extras summary {
    cursor: pointer;
  }

  .extras ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr));
    gap: 6px;
    margin-top: 6px;
  }

  .extras li {
    display: grid;
    align-content: start;
    padding: 0.4rem 0.6rem;
    background: color-mix(in srgb, var(--bg) 60%, transparent);
    box-shadow: inset 0 0 0 2px var(--line);
    font-size: 0.8125rem;
  }

  .extras span {
    color: var(--ink-soft);
    font-size: 0.75rem;
  }

  /* Level pips */
  .progress {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-m);
    margin-top: var(--space-s);
    padding-top: var(--space-xs);
    border-top: 2px dashed var(--line);
  }

  .levels {
    display: grid;
    grid-template-columns: repeat(2, auto);
    gap: 0.35rem var(--space-m);
  }

  .levels div {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .levels dt {
    min-width: 5.4rem;
    color: var(--ink-soft);
    font-size: var(--label);
  }

  .levels dd {
    display: flex;
    gap: 2px;
  }

  .levels i {
    width: 8px;
    height: 10px;
    background: var(--bg);
    box-shadow: inset 0 0 0 2px var(--line);
  }

  .levels i.on {
    background: var(--c);
    box-shadow: none;
  }

  .levels i.new {
    outline: 2px solid color-mix(in srgb, var(--c) 45%, transparent);
  }

  .paper-link {
    flex-basis: 100%;
    color: var(--teal);
    font-size: var(--label);
  }

  .loot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem var(--space-s);
    color: var(--gold);
    font-size: var(--label);
  }

  /* Motion: only once the script opted in (.animate), which it skips for reduced motion. */
  .animate .tree .line {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  .animate .tree .pt,
  .animate .tree .meet {
    opacity: 0;
  }

  .animate .tree.seen .line {
    animation: quest-draw 1.8s steps(28) var(--d) forwards;
  }

  .animate .tree.seen .pt {
    animation: quest-fade 0.3s steps(2) var(--d) forwards;
  }

  .animate .tree.seen .meet {
    animation:
      quest-fade 0.4s steps(2) 1.6s forwards,
      quest-glow 1.6s steps(2) 2.2s infinite;
  }

  .animate .stop:not(.seen) .quest,
  .animate .stop:not(.seen) .node {
    opacity: 0;
  }

  .animate .stop.seen .quest {
    animation: quest-rise 0.5s steps(5) both;
  }

  .animate .stop.seen .node {
    animation: quest-fade 0.3s steps(2) both;
  }

  .animate .stop.seen .scene img {
    animation: quest-pan 0.9s steps(6) both;
  }

  .animate .stop.seen .ups li {
    animation: quest-pop 0.3s steps(3) calc(0.4s + var(--d)) both;
  }

  .animate .stop.seen .extras li {
    animation: quest-fade 0.3s steps(2) calc(0.5s + var(--d)) both;
  }

  .animate .stop.seen .levels i.on {
    animation: quest-fade 0.2s steps(2) calc(0.5s + var(--d)) both;
  }

  .animate .stop.seen .levels i.new {
    animation:
      quest-fade 0.2s steps(2) calc(0.5s + var(--d)) both,
      quest-glow 1.4s steps(2) 1.4s infinite;
  }

  .animate .stop.seen .emblems :global(.emblem) {
    animation: quest-hop 0.6s steps(3) 0.35s both;
  }

  .animate .stop.seen.active .node {
    animation: quest-glow 1s steps(2) infinite;
  }

  @keyframes quest-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes quest-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes quest-pop {
    from {
      opacity: 0;
      transform: scale(0.7);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes quest-rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes quest-pan {
    from {
      transform: scale(1.12);
    }
    to {
      transform: none;
    }
  }

  @keyframes quest-hop {
    50% {
      transform: translateY(-6px);
    }
  }

  @keyframes quest-glow {
    50% {
      opacity: 0.45;
    }
  }

  @media (max-width: 759px) {
    .quest {
      grid-template-columns: minmax(0, 1fr);
    }

    .path {
      padding-left: 22px;
    }

