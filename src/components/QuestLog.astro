---
import WorldMap from './WorldMap.astro';
import { quests } from '../data/profile';
---

<section id="quests" class="section wrap" aria-labelledby="quests-title">
  <header class="section-head">
    <span class="num">03</span>
    <h2 id="quests-title">Quest log</h2>
    <p>The main storyline so far, newest chapter first.</p>
  </header>

  <div class="layout">
    <ol class="quests" role="list">
      {
        quests.map((q) => (
          <li class:list={['quest panel', q.status]}>
            <figure class="scene">
              <img src={q.scene.src} width="192" height="64" alt={q.scene.alt} loading="lazy" decoding="async" />
              <figcaption class="pixel">{q.scene.place}</figcaption>
            </figure>
            <p class="meta pixel">
              <span>{q.chapter}</span>
              <span class="chip">{q.status === 'active' ? 'Active' : 'Complete'}</span>
            </p>
            <h3>{q.title}</h3>
            <p class="sub">
              {q.role} · {q.when} · {q.where}
            </p>
            <p class="summary">{q.summary}</p>
            <ul class="objectives" role="list">
              {q.objectives.map((o, i) => (
                <li class:list={{ open: q.status === 'active' && i === q.objectives.length - 1 }}>{o}</li>
              ))}
            </ul>
            <p class="reward pixel">
              Reward: <span>{q.reward}</span>
            </p>
          </li>
        ))
      }
    </ol>
    <aside class="side">
      <h3 class="pixel">World map</h3>
      <WorldMap />
    </aside>
  </div>
</section>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: start;
  }

  .quests {
    display: grid;
    gap: var(--space-m);
  }

  .quest {
    padding: var(--space-m) var(--space-m) var(--space-m) calc(var(--space-m) + 6px);
  }

  .scene {
    position: relative;
    margin: calc(var(--space-m) * -1) calc(var(--space-m) * -1) var(--space-m) calc((var(--space-m) + 6px) * -1);
    border-bottom: var(--px) solid var(--line);
  }

  .scene img {
    width: 100%;
    height: auto;
    image-rendering: pixelated;
  }

  .scene figcaption {
    position: absolute;
    right: 10px;
    bottom: 6px;
    padding: 0.1em 0.5em;
    background: color-mix(in srgb, var(--shadow) 80%, transparent);
    color: var(--ink);
    font-size: var(--label);
  }

  .quest::before {
    content: '';
    position: absolute;
    inset: var(--px) auto var(--px) var(--px);
    z-index: 1;
    width: 6px;
    background: var(--line);
  }

  .quest.active::before {
    background: var(--gold);
  }

  .meta {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    color: var(--ink-soft);
    font-size: var(--label);
  }

  .chip {
    padding: 0 0.5em;
    background: var(--line);
    color: var(--ink);
  }

  .active .chip {
    background: var(--gold);
    color: var(--bg);
  }

  @media (prefers-reduced-motion: no-preference) {
    .active .chip {
      animation: glow 1.2s steps(2) infinite;
    }
  }

  @keyframes glow {
    50% {
      background: color-mix(in srgb, var(--gold) 60%, var(--bg));
    }
  }

  h3 {
    margin-top: var(--space-2xs);
    font-size: var(--step-2);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .sub {
    color: var(--teal);
    font-size: var(--label);
  }

  .summary {
    margin-top: var(--space-xs);
  }

  .objectives {
    display: grid;
    gap: 4px;
    margin-top: var(--space-s);
  }

  .objectives li {
    position: relative;
    padding-left: 1.75rem;
    color: var(--ink-soft);
  }

  .objectives li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.3em;
    width: 0.95em;
    height: 0.95em;
    background:
      linear-gradient(var(--teal), var(--teal)) center / 45% 45% no-repeat,
      var(--bg);
    box-shadow: inset 0 0 0 2px var(--teal);
  }

  .objectives li.open::before {
    background: var(--bg);
    box-shadow: inset 0 0 0 2px var(--gold);
  }

  .reward {
    margin-top: var(--space-s);
    color: var(--ink-soft);
    font-size: var(--label);
  }

  .reward span {
    color: var(--gold);
  }

  .side {
    position: sticky;
    top: 84px;
  }

  .side h3 {
    margin-bottom: var(--space-s);
    color: var(--gold);
    font-size: var(--step-1);
  }

  @media (max-width: 899px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .side {
      position: static;
      order: -1;
    }
  }
</style>
