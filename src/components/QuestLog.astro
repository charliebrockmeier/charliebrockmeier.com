---
// The career as a progression, oldest chapter first. Each card shows where the three
// skill tracks stand afterwards, with that chapter's gains lit up.
import PixelArt from './PixelArt.astro';
import { logos } from '../data/logos';
import { quests } from '../data/profile';

const TRACKS = [
  { key: 'finance', label: 'Finance', color: 'var(--gold)' },
  { key: 'code', label: 'Code', color: 'var(--blue)' },
  { key: 'ai', label: 'AI', color: 'var(--teal)' },
] as const;
const MAX = 5;
---

<section id="quests" class="section wrap" aria-labelledby="quests-title">
  <header class="section-head">
    <span class="num">03</span>
    <h2 id="quests-title">Quest log</h2>
    <p>Finance at the core, then code, then AI. Every chapter moved me closer to where they meet.</p>
  </header>

  <ol class="path" role="list">
    {
      quests.map((q, i) => {
        const prev = quests[i - 1]?.level ?? { finance: 0, code: 0, ai: 0 };
        return (
          <li class:list={['stop', q.status]}>
            <span class="node" aria-hidden="true" />
            <article class="quest panel">
            <figure class="scene">
              <img src={q.scene.src} width="192" height="64" alt={q.scene.alt} loading="lazy" decoding="async" />
              <figcaption class="pixel">{q.scene.place}</figcaption>
            </figure>
            <div class="body">
              <p class="meta pixel">
                <span>{q.chapter}</span>
                <span class="chip">{q.status === 'active' ? 'Active' : 'Complete'}</span>
                <span class="when">{q.when}</span>
              </p>
              <div class="title">
                <h3>{q.title}</h3>
                <span class="emblems">
                  {q.emblems.map((name) => (
                    <PixelArt art={logos[name]} scale={2} label={logos[name].label} class="emblem" />
                  ))}
                </span>
              </div>
              <p class="sub">
                {q.role} · {q.where}
              </p>
              <p class="summary">{q.summary}</p>
              <ul class="objectives" role="list">
                {q.objectives.map((o, j) => (
                  <li class:list={{ open: q.status === 'active' && j === q.objectives.length - 1 }}>{o}</li>
                ))}
              </ul>
              <div class="progress">
                <dl class="levels">
                  {TRACKS.map((t) => (
                    <div style={`--c: ${t.color}`}>
                      <dt class="pixel">{t.label}</dt>
                      <dd aria-label={`${t.label} level ${q.level[t.key]} of ${MAX}`}>
                        {Array.from({ length: MAX }, (_, k) => (
                          <i class:list={{ on: k < q.level[t.key], new: k >= prev[t.key] && k < q.level[t.key] }} />
                        ))}
                      </dd>
                    </div>
                  ))}
                </dl>
                <p class="loot pixel">
                  <span>Unlocked: {q.unlocked}</span>
                  <span>Reward: {q.reward}</span>
                </p>
              </div>
            </div>
            </article>
          </li>
        );
      })
    }
  </ol>
</section>

<style>
  .path {
    position: relative;
    display: grid;
    gap: var(--space-s);
    padding-left: 28px;
  }

  /* The trail between chapters. */
  .path::before {
    content: '';
    position: absolute;
    top: 12px;
    bottom: 12px;
    left: 9px;
    width: 4px;
    background: repeating-linear-gradient(var(--line) 0 8px, transparent 8px 14px);
  }

  .quest {
    display: grid;
    grid-template-columns: minmax(0, 300px) minmax(0, 1fr);
    gap: var(--space-m);
    padding: var(--space-s);
  }

  .stop {
    position: relative;
  }

  /* A node on the trail for each chapter. */
  .node {
    position: absolute;
    top: 22px;
    left: -26px;
    width: 14px;
    height: 14px;
    background: var(--line);
    box-shadow: 0 0 0 3px var(--bg);
  }

  .active .node {
    background: var(--gold);
  }

  @media (prefers-reduced-motion: no-preference) {
    .active .node {
      animation: quest-blink 1s steps(2) infinite;
    }
  }

  .scene {
    position: relative;
    align-self: start;
  }

  .scene img {
    width: 100%;
    height: auto;
    image-rendering: pixelated;
    box-shadow: 0 0 0 2px var(--line);
  }

  .scene figcaption {
    position: absolute;
    right: 6px;
    bottom: 6px;
    padding: 0 0.4em;
    background: color-mix(in srgb, var(--shadow) 80%, transparent);
    font-size: 0.75rem;
  }

  .meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.25rem var(--space-xs);
    color: var(--ink-soft);
    font-size: var(--label);
  }

  .chip {
    padding: 0 0.45em;
    background: var(--line);
    color: var(--ink);
  }

  .active .chip {
    background: var(--gold);
    color: var(--bg);
  }

  .when {
    margin-left: auto;
  }

  .title {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem 0.75rem;
    margin-top: 0.15rem;
  }

  h3 {
    font-size: var(--step-2);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .emblems {
    display: flex;
    gap: 6px;
  }

  .emblems :global(.emblem) {
    width: 40px;
    height: auto;
  }

  .sub {
    color: var(--teal);
    font-size: var(--step--1);
  }

  .summary {
    margin-top: var(--space-xs);
    font-size: var(--step--1);
  }

  .objectives {
    display: grid;
    gap: 2px;
    margin-top: var(--space-xs);
  }

  .objectives li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  .objectives li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.35em;
    width: 0.8em;
    height: 0.8em;
    background:
      linear-gradient(var(--teal), var(--teal)) center / 45% 45% no-repeat,
      var(--bg);
    box-shadow: inset 0 0 0 2px var(--teal);
  }

  .objectives li.open::before {
    background: var(--bg);
    box-shadow: inset 0 0 0 2px var(--gold);
  }

  .progress {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-m);
    margin-top: var(--space-s);
    padding-top: var(--space-xs);
    border-top: 2px dashed var(--line);
  }

  .levels {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem var(--space-m);
  }

  .levels div {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .levels dt {
    color: var(--ink-soft);
    font-size: var(--label);
  }

  .levels dd {
    display: flex;
    gap: 2px;
  }

  .levels i {
    width: 10px;
    height: 10px;
    background: var(--bg);
    box-shadow: inset 0 0 0 2px var(--line);
  }

  .levels i.on {
    background: var(--c);
    box-shadow: none;
  }

  /* This chapter's gains glow. */
  .levels i.new {
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--c) 45%, transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .levels i.new {
      animation: quest-blink 1.4s steps(2) infinite;
    }
  }

  .loot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem var(--space-s);
    color: var(--gold);
    font-size: var(--label);
  }

  @keyframes quest-blink {
    50% {
      opacity: 0.45;
    }
  }

  @media (max-width: 759px) {
    .quest {
      grid-template-columns: minmax(0, 1fr);
    }

    .path {
      padding-left: 22px;
    }

    .path::before {
      left: 6px;
    }

    .node {
      left: -22px;
      width: 12px;
      height: 12px;
    }
  }
</style>
