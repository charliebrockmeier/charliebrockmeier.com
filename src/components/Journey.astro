---
// "The road so far": scroll to walk from a Kearney front yard to 7 World Trade.
// The scene is PNG layers drawn in code (scripts/art/journey*.mjs): a near layer,
// a far layer at half speed, three cloud bands, a walker and a vehicle sheet. An
// SVG overlay carries everything that moves in place. Vehicles are placed by the
// script in world space and only ever appear or vanish off-screen. Arriving at
// 7 WTC plays a finale. Without JS, or with reduced motion, it's a static strip.
import Icon from './Icon.astro';
import { camera, journeyArt, regions, stops, timeKeys, vehicles } from '../data/journey';

const { nearWidth: NW, farWidth: FW, height: H, feet, farSpeed, farAlignView } = journeyArt;
const config = { ...camera, h: H, farSpeed, farOffset: (farAlignView / 2) * (1 - farSpeed), keys: timeKeys, regions, vehicles };

// Pixel discs for the sun and moon, one rect per run.
const disc = (r: number, bite = false) =>
  Array.from({ length: 2 * r }, (_, y) => {
    const on = Array.from({ length: 2 * r }, (_, x) => {
      const [dx, dy] = [x - r + 0.5, y - r + 0.5];
      return dx * dx + dy * dy <= r * r && !(bite && (dx + r * 0.55) ** 2 + (dy - r * 0.2) ** 2 <= (r * 0.8) ** 2);
    });
    const runs: { x: number; y: number; w: number }[] = [];
    on.forEach((v, x) => v && (on[x - 1] ? runs[runs.length - 1].w++ : runs.push({ x, y, w: 1 })));
    return runs;
  }).flat();
const sun = disc(9);
const moon = disc(7, true);

let seed = 41;
const rand = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
const stars = Array.from({ length: 80 }, () => ({ x: rand() * 100, y: rand() * 55, big: rand() > 0.9, tw: rand() > 0.6, d: rand() * 3 }));

// Cloud layers: band in the sheet, height in the sky, parallax and wind.
const cloudLayers = [
  { band: 0, top: 4, speed: 0.06, wind: 2 },
  { band: 1, top: 13, speed: 0.12, wind: 4 },
  { band: 2, top: 24, speed: 0.22, wind: 7 },
];

// Fireworks for the finale: bursts placed around the sky.
const bursts = [
  { x: 18, y: 16, c: '#ffcd75', d: 0 },
  { x: 80, y: 12, c: '#73eff7', d: 0.5 },
  { x: 62, y: 30, c: '#ff6b7f', d: 1.1 },
  { x: 34, y: 28, c: '#a7f070', d: 1.6 },
  { x: 90, y: 34, c: '#b99cff', d: 2.1 },
];

// Overlay sprites, in near-layer art pixels.
const px = (rows: string[], pal: Record<string, string>) =>
  rows.flatMap((row, y) => [...row].flatMap((k, x) => (pal[k] ? [{ x, y, fill: pal[k] }] : [])));
const cableCar = px(['..RRRRRRRRRR..', '.RCCCCCCCCCCR.', 'RRWWBWWBWWBWRR', 'RRWWBWWBWWBWRR', 'RRRRRRRRRRRRRR', 'CCCCCCCCCCCCCC', '.KK........KK.'], {
  R: '#9a2f2a',
  C: '#f4ecdc',
  W: '#ffe9a8',
  B: '#29366f',
  K: '#141026',
});
const balloon = px(
  ['...RRYRR...', '..RRYYYRR..', '.RRYYYYYRR.', '.RRYYYYYRR.', '.RRYYYYYRR.', '..RRYYYRR..', '...RRYRR...', '....R.R....', '....KKK....', '....KKK....'],
  { R: '#e43b44', Y: '#ffcd75', K: '#8a5a3c' },
);
const hiker = px(['.H.', 'SSS', 'BBB', 'BBB', 'L.L', 'L.L'], { H: '#5c3a2e', S: '#f2c4a2', B: '#e43b44', L: '#24305a' });
const train = [0, 1, 2].flatMap((car) =>
  px(['SSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSS.', 'SWWWSWWWSWWWDSWWWSWWWSWWWSDWWWSWWWSWWS.', 'SWWWSWWWSWWWDSWWWSWWWSWWWSDWWWSWWWSWWS.', 'SSSSSSSSSSSSDSSSSSSSSSSSSSDSSSSSSSSSSS.', 'SPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPS.', '.KK..............................KK...'], {
    S: '#c9cfe0',
    W: '#ffe9a8',
    D: '#94a0c2',
    P: '#7a2a3a',
    K: '#141026',
  }).map((p) => ({ ...p, x: p.x + car * 38 })),
);
const craneFlock = [0, 9, 18, 5, 14, 24].map((dx, i) => ({ x: 120 + dx * 3, y: 56 + [0, 4, 1, 9, 6, 3][i] }));
const balloons = Array.from({ length: 18 }, (_, i) => ({ x: 1304 + ((i * 37) % 136), d: (i * 0.53) % 6, c: i % 4 ? '#e43b44' : '#fdf6e3' }));
const fog = [
  { x: 2254, y: 136, w: 40 },
  { x: 2298, y: 141, w: 54 },
  { x: 2358, y: 134, w: 46 },
  { x: 2408, y: 140, w: 60 },
  { x: 2466, y: 135, w: 44 },
  { x: 2312, y: 112, w: 34 },
];
const twinkle = (n: number, x0: number, x1: number, y0: number, y1: number, k: number) =>
  Array.from({ length: n }, (_, i) => ({ x: x0 + ((i * 53 + k) % (x1 - x0)), y: y0 + ((i * 29 + k) % (y1 - y0)), d: ((i * 0.37 + k) % 3).toFixed(2) }));
const shimmer = [...twinkle(10, 1510, 1760, 126, 150, 3), ...twinkle(10, 2270, 2508, 186, 194, 7)];
const officeLights = Array.from({ length: 12 }, (_, i) => ({ x: 3281 + ((i * 4) % 10) * 9, y: 66 + ((i * 3) % 5) * 10, d: (i * 0.7) % 5 }));
const walkupWindows = [
  [3658, 102],
  [3700, 102],
  [3672, 114],
  [3714, 114],
  [3686, 126],
  [3658, 138],
  [3714, 138],
];
const floors = Array.from({ length: 26 }, (_, i) => ({ y: 130 - i * 4, i }));
const steam = [0, 1, 2, 3];
const neon = [...'OPEN'].flatMap((ch, i) =>
  ({ O: ['111', '101', '101', '101', '111'], P: ['111', '101', '111', '100', '100'], E: ['111', '100', '110', '100', '111'], N: ['101', '111', '111', '111', '101'] })[ch]!.flatMap((row, y) =>
    [...row].flatMap((b, x) => (b === '1' ? [{ x: 3789 + i * 4 + x, y: 141 + y }] : [])),
  ),
);
const pct = (x: number) => ((x - camera.start) / (camera.end - camera.start)) * 100;
---

<section id="journey" class="journey section" aria-labelledby="journey-title" data-journey data-config={JSON.stringify(config)}>
  <header class="wrap section-head">
    <span class="num">02</span>
    <h2 id="journey-title">The road so far</h2>
    <p>From a Kearney front yard to 7 World Trade Center, one street at a time.</p>
  </header>

  <div class="track" data-track>
    <div class="stage" data-stage style={`--nw:${NW};--fw:${FW};--h:${H};--feet:${feet}`}>
      <div class="sky" aria-hidden="true">
        <div class="sky-layer morning"></div>
        <div class="sky-layer day" data-sky></div>
        <div class="sky-layer golden" data-sky></div>
        <div class="sky-layer night" data-sky></div>
        <div class="stars">
          {stars.map((s) => <i class:list={{ big: s.big, tw: s.tw }} style={`left:${s.x.toFixed(1)}%;top:${s.y.toFixed(1)}%;animation-delay:${-s.d.toFixed(2)}s`} />)}
        </div>
        <div class="rays" data-rays></div>
        <svg class="sun" data-sun viewBox="0 0 18 18" shape-rendering="crispEdges">
          {sun.map((p) => <rect x={p.x} y={p.y} width={p.w} height="1" />)}
        </svg>
        <svg class="moon" data-moon viewBox="0 0 14 14" shape-rendering="crispEdges">
          {moon.map((p) => <rect x={p.x} y={p.y} width={p.w} height="1" />)}
        </svg>
        {
          cloudLayers.map((c) => (
            <>
              <div class="clouds" data-cloud data-speed={c.speed} data-wind={c.wind} style={`top:${c.top}%;--band:${c.band}`} />
              <div class="clouds dusk" data-cloud data-speed={c.speed} data-wind={c.wind} style={`top:${c.top}%;--band:${c.band + 3}`} />
            </>
          ))
        }
        <div class="flock f1">{[0, 1, 2, 3, 4].map((i) => <i style={`--i:${i}`} />)}</div>
        <div class="flock f2">{[0, 1, 2].map((i) => <i style={`--i:${i}`} />)}</div>
        <div class="plane"><i class="trail"></i><i class="jet"></i></div>
        <div class="fireworks">
          {
            bursts.map((b) => (
              <div class="burst" style={`left:${b.x}%;top:${b.y}%;--c:${b.c}`}>
                {Array.from({ length: 12 }, (_, i) => (
                  <i style={`--a:${i * 30}deg;animation-delay:${b.d}s`} />
                ))}
              </div>
            ))
          }
        </div>
      </div>

      <div
        class="viewport"
        role="img"
        aria-label="A pixel-art street from Kearney, Nebraska, under the Archway, through Lincoln and Omaha, across San Francisco and the Golden Gate to Pebble Beach, then New York: Union Square, the Flatiron, a walk-up, and 7 World Trade Center."
      >
        <div class="layer far" data-far>
          <img src="/art/journey-far.png" width={FW} height={H} alt="" loading="lazy" decoding="async" />
        </div>
        <div class="layer near" data-near>
          <img src="/art/journey-near.png" width={NW} height={H} alt="" loading="lazy" decoding="async" />
          <svg class="fx" viewBox={`0 0 ${NW} ${H}`} shape-rendering="crispEdges" aria-hidden="true">
            <defs>
              <clipPath id="road-stands"><rect x="1284" y="0" width="176" height="100" /></clipPath>
              <clipPath id="road-tunnel"><rect x="3060" y="182" width="1320" height="14" /></clipPath>
            </defs>
            <!-- Kearney: a balloon, cranes over the Platte, the windmill, the KHS flag. -->
            <g class="balloon">{balloon.map((p) => <rect x={p.x + 470} y={p.y + 30} width="1" height="1" fill={p.fill} />)}</g>
            <g class="cranes">
              {
                craneFlock.map((b) => (
                  <g transform={`translate(${b.x} ${b.y})`} fill="#4a5a72">
                    <g class="wing-up">
                      <rect x="0" y="0" width="2" height="1" />
                      <rect x="2" y="1" width="2" height="1" />
                      <rect x="4" y="0" width="2" height="1" />
                    </g>
                    <g class="wing-down">
                      <rect x="0" y="2" width="2" height="1" />
                      <rect x="2" y="1" width="2" height="1" />
                      <rect x="4" y="2" width="2" height="1" />
                    </g>
                  </g>
                ))
              }
            </g>
            <g class="blades">
              {[0, 45, 90, 135].map((deg) => <rect x="245" y="85.4" width="22" height="1.2" fill="#3d4a62" transform={`rotate(${deg} 256 86)`} />)}
              <rect x="255" y="85" width="2" height="2" fill="#94a0c2" />
            </g>
            <g class="flag-a">
              <rect x="623" y="70" width="12" height="8" fill="#e43b44" />
              {[71, 73, 75, 77].map((y) => <rect x="623" y={y} width="12" height="1" fill="#fdf6e3" />)}
              <rect x="623" y="70" width="5" height="4" fill="#29366f" />
            </g>
            <g class="flag-b">
              <rect x="623" y="71" width="11" height="8" fill="#e43b44" />
              {[72, 74, 76, 78].map((y) => <rect x="623" y={y} width="11" height="1" fill="#fdf6e3" />)}
              <rect x="623" y="71" width="5" height="4" fill="#29366f" />
            </g>

            <!-- Lincoln on game day: lights, and red balloons after the first score. -->
            <rect class="lamp" x="1282" y="51" width="10" height="5" fill="#fff3c4" />
            <rect class="lamp" x="1452" y="51" width="10" height="5" fill="#fff3c4" />
            <g clip-path="url(#road-stands)">
              {balloons.map((b) => <rect class="red-balloon" x={b.x} y="100" width="2" height="3" fill={b.c} style={`animation-delay:${-b.d}s`} />)}
            </g>
            {Array.from({ length: 18 }, (_, i) => <rect class="bulb" x={1194 + i * 4} y="100" width="1" height="1" fill="#ffe9a8" style={`animation-delay:${-(i % 5) * 0.3}s`} />)}

            <!-- Omaha and the Golden Gate: water catching the light. -->
            {shimmer.map((s) => <rect class="shimmer" x={s.x} y={s.y} width="2" height="1" fill="#ffe9a8" style={`animation-delay:-${s.d}s`} />)}
            {Array.from({ length: 13 }, (_, i) => <rect class="runway" x={1752 + i * 10} y="150" width="2" height="2" fill="#c6fff5" style={`animation-delay:${i * 0.08}s`} />)}
            {Array.from({ length: 13 }, (_, i) => <rect class="runway" x={2910 + i * 10} y="150" width="2" height="2" fill="#c6fff5" style={`animation-delay:${i * 0.08}s`} />)}

            <!-- San Francisco: the cable car, pickleball, a hiker, fog, the flag on the green. -->
            <g class="cable-car">{cableCar.map((p) => <rect x={p.x} y={p.y} width="1" height="1" fill={p.fill} />)}</g>
            <rect class="ball" x="0" y="0" width="1" height="1" fill="#e9ff70" />
            <g class="hiker">{hiker.map((p) => <rect x={p.x - 1} y={p.y - 6} width="1" height="1" fill={p.fill} />)}</g>
            <g class="fog">
              {
                fog.map((f, i) => (
                  <g class={`puff p${i % 3}`} transform={`translate(${f.x} ${f.y})`} fill={i % 2 ? '#e2d4ec' : '#efe4f4'}>
                    <rect x="5" y="0" width={f.w - 12} height="1" />
                    <rect x="2" y="1" width={f.w - 5} height="1" />
                    <rect x="0" y="2" width={f.w} height="2" />
                    <rect x="3" y="4" width={f.w - 7} height="1" />
                  </g>
                ))
              }
            </g>
            <rect class="beacon" x="2323" y="29" width="1" height="1" fill="#ff3b4f" />
            <rect class="beacon" x="2449" y="29" width="1" height="1" fill="#ff3b4f" />
            <g class="surf">
              {[2736, 2748, 2762, 2776].map((x, i) => <rect x={x} y="147" width="8" height="1" fill="#ffffff" style={`animation-delay:${-i * 0.4}s`} />)}
              {Array.from({ length: 12 }, (_, i) => <rect x={2676 + i * 20} y={189 + (i % 3) * 2} width="10" height="1" fill="#ffffff" style={`animation-delay:${-i * 0.3}s`} />)}
            </g>
            <g class="pin-a"><polygon points="2863,120 2872,123 2863,126" fill="#ffcd75" /></g>
            <g class="pin-b"><polygon points="2863,121 2871,122 2863,126" fill="#ffcd75" /></g>

            <!-- New York: market lights, office windows, the subway, steam, neon, windows. -->
            {Array.from({ length: 22 }, (_, i) => <rect class="bulb" x={3186 + i * 4} y="127" width="1" height="1" fill="#ffe9a8" style={`animation-delay:${-(i % 5) * 0.3}s`} />)}
            {officeLights.map((o) => <rect class="glass" x={o.x} y={o.y} width="7" height="7" fill="#1b1a33" style={`animation-delay:-${o.d}s`} />)}
            <g clip-path="url(#road-tunnel)">
              <g class="train">{train.map((p) => <rect x={p.x} y={p.y + 184} width="1" height="1" fill={p.fill} />)}</g>
            </g>
            <rect x="3060" y="182" width="16" height="14" fill="#0c0a18" />
            <rect x="4364" y="182" width="16" height="14" fill="#0c0a18" />
            {
              steam.map((i) => (
                <>
                  <rect class="steam" x="3604" y="150" width="5" height="3" fill="#e9edf7" style={`animation-delay:${-i * 0.9}s`} />
                  <rect class="steam small" x="3574" y="136" width="3" height="2" fill="#e9edf7" style={`animation-delay:${-i * 0.9 - 0.4}s`} />
                </>
              ))
            }
            <g class="neon">{neon.map((p) => <rect x={p.x} y={p.y} width="1" height="1" fill="#ff6b9d" />)}</g>
            {walkupWindows.map(([x, y], i) => <rect class="win" x={x} y={y} width="7" height="8" fill="#1b1533" style={`animation-delay:${-i * 1.3}s`} />)}
            <g class="floors">{floors.map((f) => <rect x="3990" y={f.y} width="100" height="2" fill="#c6fff5" style={`transition-delay:${f.i * 45}ms`} />)}</g>
            <rect class="lobby" x="3990" y="136" width="100" height="16" fill="#ffffff" />
            <rect class="lobby" x="4202" y="140" width="60" height="8" fill="#ffffff" />
            <rect class="beacon" x="4142" y="0" width="1" height="1" fill="#ff3b4f" />
          </svg>
          <div class="cars" data-cars></div>
        </div>
      </div>

      <div class="walker-box" data-walker aria-hidden="true">
        <i class="shadow"></i>
        <div class="walker" data-body></div>
      </div>

      <div class="progress" aria-hidden="true">
        <div class="bar"><span class="fill" data-fill></span></div>
        {stops.map((s, i) => <button type="button" class="mark" tabindex="-1" style={`left:${pct(s.x)}%`} data-goto={i} title={s.place} />)}
      </div>
      <button type="button" class="skip" data-skip>Skip the walk ↓</button>

      <ol class="stops" role="list">
        {
          stops.map((s) => (
            <li class="stop" data-stop data-x={s.x}>
              <p class="chapter pixel">{s.chapter}</p>
              <h3>{s.place}</h3>
              <p class="meta">
                {s.role} · {s.when}
              </p>
              <p class="line">{s.line}</p>
            </li>
          ))
        }
      </ol>

      <div class="banner" aria-hidden="true">
        <p class="save pixel">Current save</p>
        <p class="where pixel">7 World Trade Center</p>
        <p class="who">MSCI Private Assets · New York</p>
        <p class="next">Keep scrolling ↓</p>
      </div>
      <div class="toast" aria-hidden="true">
        <Icon name="trophy" color="gold" scale={2.5} />
        <div>
          <p class="pixel">Achievement unlocked</p>
          <p>Arrived: Kearney to 7 World Trade</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // One loop drives everything while the section is on screen: the camera follows
  // the scroll with a little easing, the layers pan, the walker steps, the sky moves
  // through the day, clouds drift, and vehicles drive in world space, entering and
  // leaving only off-screen. Reaching the end plays the finale.
  const root = document.querySelector<HTMLElement>('[data-journey]');
  if (root && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    const cfg = JSON.parse(root.dataset.config!);
    const q = <T extends Element = HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const all = (s: string) => [...root.querySelectorAll<HTMLElement>(s)];
    const [track, stage, near, far, walker, body, fill, sun, rays, moon, cars] = ['track', 'stage', 'near', 'far', 'walker', 'body', 'fill', 'sun', 'rays', 'moon', 'cars'].map((n) => q(`[data-${n}]`));
    const skies = all('[data-sky]');
    const clouds = all('[data-cloud]');
    const cards = all('[data-stop]');
    const span = cfg.end - cfg.start;
    const clamp = (v: number) => Math.min(1, Math.max(0, v));
    const timeAt = (x: number) => {
      const k = cfg.keys as [number, number][];
      let i = 1;
      while (i < k.length - 1 && x > k[i][0]) i++;
      return k[i - 1][1] + (k[i][1] - k[i - 1][1]) * clamp((x - k[i - 1][0]) / (k[i][0] - k[i - 1][0]));
    };
    // Scroll progress (before the dwell) to camera: linear, then easing to a stop.
    const ease = (u: number) => (u < 0.84 ? (u / 0.84) * 0.92 : 0.92 + 0.08 * ((u - 0.84) / 0.16) * (2 - (u - 0.84) / 0.16));
    const unease = (f: number) => (f <= 0.92 ? (f / 0.92) * 0.84 : 0.84 + 0.16 * (1 - Math.sqrt(1 - (f - 0.92) / 0.08)));

    let s = 2;
    let vw = 0;
    let W = 0;
    let Hs = 0;
    let top = 0;
    let total = 1;
    let cam = cfg.start;
    let vel = 0;
    let dist = 0;
    let still = 0;
    let then = 0;
    let active = -1;
    let running = false;
    let snap = true;

    type Car = { el: HTMLElement; x: number; dir: number; w: number; v: number; type: string; wait: number };
    const fleet: Car[] = Array.from({ length: 8 }, (_, i) => {
      const el = document.createElement('i');
      el.className = 'car';
      cars.append(el);
      return { el, x: 0, dir: i % 2 ? -1 : 1, w: 0, v: 0, type: '', wait: 0 };
    });
    const style = (c: Car) => {
      const v = cfg.vehicles[c.type];
      Object.assign(c.el.style, { width: `${v.w * s}px`, height: `${v.h * s}px`, backgroundPosition: `${-v.x * s}px ${-(16 - v.h) * s}px` });
      c.el.dataset.lane = c.dir > 0 ? 'far' : 'near';
    };
    // Place a car at x (or just off the edge it will drive in from) with a type for that region.
    const spawn = (c: Car, L: number, x?: number) => {
      const list: string[] = cfg.regions.findLast((r: { from: number }) => r.from <= Math.max(0, x ?? L)).vehicles;
      let type = list[Math.floor(Math.random() * list.length)];
      if (c.dir > 0 && cfg.vehicles[type].h > 12) type = 'sedan';
      const v = cfg.vehicles[type];
      Object.assign(c, { type, w: v.w, v: v.speed * (0.85 + Math.random() * 0.3), wait: Math.random() * 3 });
      const fromLeft = x === undefined && c.dir * c.v > vel;
      c.x = x ?? (fromLeft ? L - c.w - 8 : L + vw + 8);
      // Never on top of another car in the lane: step past it, away from the screen.
      const clash = () => fleet.find((o) => o !== c && o.dir === c.dir && o.type && c.x < o.x + o.w + 12 && o.x < c.x + c.w + 12);
      for (let o; (o = clash()); ) c.x = fromLeft ? o.x - c.w - 14 : o.x + o.w + 14;
      style(c);
    };

    const tick = (now: number) => {
      const dt = Math.min(0.05, (now - (then || now)) / 1000);
      then = now;
      const p = clamp((top - track.getBoundingClientRect().top) / total);
      const target = cfg.start + span * ease(clamp(p / (1 - cfg.dwell)));
      const prev = cam;
      cam = snap ? target : cam + (target - cam) * Math.min(1, dt * 8);
      if (Math.abs(target - cam) < 0.05) cam = target;
      const d = cam - prev;
      if (dt) vel += (d / dt - vel) * Math.min(1, dt * 4);
      // The view stops at the left edge of the art; the walker steps off center there.
      const L = Math.max(0, cam - vw / 2);
      near.style.transform = `translate3d(${-Math.round(L * s)}px,0,0)`;
      far.style.transform = `translate3d(${-Math.round(((L + vw / 2) * cfg.farSpeed + cfg.farOffset - vw / 2) * s)}px,0,0)`;
      walker.style.transform = `translate3d(${Math.round((cam - L - vw / 2) * s)}px,0,0)`;

      // A step per 3 art px walked; breathing when still; facing the way it walks.
      if (Math.abs(d) > 0.02) {
        dist += Math.abs(d);
        still = now;
        body.classList.toggle('back', d < 0);
        body.style.backgroundPosition = `${-(Math.floor(dist / 3) % 8) * 16 * s}px 0`;
      }
      body.classList.toggle('idle', now - still > 220);

      // Sky: layered crossfades, the sun's arc and rays, moon, stars, clouds.
      const t = timeAt(cam);
      skies.forEach((el, i) => (el.style.opacity = String(clamp(t - i))));
      root.style.setProperty('--night', clamp(t - 2).toFixed(3));
      root.style.setProperty('--dusk', clamp(1 - Math.abs(t - 2.05) / 0.7).toFixed(3));
      const arc = clamp(t / 2.6);
      sun.style.transform = rays.style.transform = `translate(${(0.1 + arc * 0.75) * W}px,${(0.62 - Math.sin(arc * Math.PI) * 0.5) * Hs}px)`;
      sun.style.opacity = String(clamp((2.8 - t) * 3));
      rays.style.opacity = String(clamp(1 - Math.abs(t - 2.05) / 0.45) * 0.5);
      moon.style.opacity = String(clamp((t - 2.5) * 2));
      clouds.forEach((el) => (el.style.backgroundPositionX = `${-((cam * +el.dataset.speed! + (now / 1000) * +el.dataset.wind!) * s) % (480 * s)}px`));

      // Vehicles drive in world space, follow the car ahead, and wait off-screen to re-enter.
      for (const c of fleet) {
        if (snap) spawn(c, L, L - 120 + Math.random() * (vw + 240));
        for (const o of fleet) {
          const gap = (o.x - c.x) * c.dir;
          if (o !== c && o.dir === c.dir && gap > 0 && gap < (c.dir > 0 ? c.w : o.w) + 10) c.v = Math.min(c.v, o.v);
        }
        c.x += c.dir * c.v * dt;
        if ((c.x > L + vw + 40 || c.x + c.w < L - 40) && (c.wait -= dt) < 0) spawn(c, L);
        c.el.style.transform = `translate3d(${Math.round(c.x * s)}px,0,0)${c.dir < 0 ? ' scaleX(-1)' : ''}`;
      }
      snap = false;

      // Zones, captions, progress, and the finale.
      root.classList.toggle('game-on', cam > 1180 && cam < 1560);
      root.classList.toggle('fly', Math.abs(cam - 1812) < 170 || Math.abs(cam - 2960) < 170);
      root.classList.toggle('arrived', p > 1 - cfg.dwell * 0.9 && cfg.end - cam < 3);
      let best = Infinity;
      let next = 0;
      cards.forEach((el, i) => {
        const dd = Math.abs(cam - +el.dataset.x!);
        if (dd < best) [best, next] = [dd, i];
      });
      if (next !== active) {
        cards[active]?.classList.remove('on');
        cards[next].classList.add('on');
        active = next;
      }
      fill.style.transform = `scaleX(${((cam - cfg.start) / span).toFixed(4)})`;
      if (running) requestAnimationFrame(tick);
    };

    const layout = () => {
      W = stage.clientWidth;
      Hs = stage.clientHeight;
      top = parseFloat(getComputedStyle(stage).top) || 0;
      s = Math.max(2, Math.floor(Math.min((Hs * 0.82) / cfg.h, W / 150)));
      vw = W / s;
      root.style.setProperty('--s', String(s));
      total = (span * s * cfg.pace) / (1 - cfg.dwell);
      track.style.height = `${Hs + total}px`;
      fleet.forEach((c) => c.type && style(c));
    };

    const scrollToX = (x: number, end = false) => {
      const base = track.getBoundingClientRect().top + scrollY - top;
      scrollTo({ top: base + (end ? total + 2 : unease(clamp((x - cfg.start) / span)) * (1 - cfg.dwell) * total), behavior: 'smooth' });
    };
    q('.progress').addEventListener('click', (e) => {
      const i = (e.target as HTMLElement).dataset.goto;
      if (i) scrollToX(+cards[+i].dataset.x!);
    });
    q('[data-skip]').addEventListener('click', () => scrollToX(0, true));

    root.classList.add('live');
    addEventListener('resize', layout);
    layout();
    new IntersectionObserver(
      ([e]) => {
        const was = running;
        running = e.isIntersecting;
        if (running && !was) {
          then = 0;
          snap = true;
          requestAnimationFrame(tick);
        }
      },
      { rootMargin: '200px 0px' },
    ).observe(track);
  }
</script>

