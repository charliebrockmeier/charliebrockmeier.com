---
// "The road so far": scroll to walk from a Kearney front yard to 7 World Trade.
// The scene is PNG layers drawn in code (scripts/art/journey*.mjs): a near layer,
// a far layer at half speed, three cloud bands, a walker and a vehicle sheet. An
// SVG overlay carries everything that moves in place, grouped by zone so only the
// zone on screen animates. Vehicles are placed by the script in world space and
// only ever appear or vanish off-screen. 7 WTC is a checkpoint, not the end: a
// save, fireworks, and a sign pointing on down the road. Without JS, or with
// reduced motion, it's a static strip.
import Icon from './Icon.astro';
import { FONT } from '../../scripts/art/journey-kit.mjs';
import { FAST_TRAVEL_SF } from '../../scripts/art/journey-west.mjs';
import { camera, journeyArt, regions, stops, timeKeys, vehicles, vehicleSheet } from '../data/journey';

const { nearWidth: NW, farWidth: FW, height: H, ground: G, feet, farSpeed, farAlignView, walker: WK, lanes } = journeyArt;
const config = {
  ...camera,
  h: H,
  farSpeed,
  farOffset: (farAlignView / 2) * (1 - farSpeed),
  keys: timeKeys,
  regions,
  vehicles,
  sheetH: vehicleSheet.h,
  farMax: lanes.farMax,
  ww: WK.w,
};

// Pixel discs for the sun and moon, one rect per run.
const disc = (r: number, bite = false) =>
  Array.from({ length: 2 * r }, (_, y) => {
    const on = Array.from({ length: 2 * r }, (_, x) => {
      const [dx, dy] = [x - r + 0.5, y - r + 0.5];
      return dx * dx + dy * dy <= r * r && !(bite && (dx + r * 0.55) ** 2 + (dy - r * 0.2) ** 2 <= (r * 0.8) ** 2);
    });
    const runs: { x: number; y: number; w: number }[] = [];
    on.forEach((v, x) => v && (on[x - 1] ? runs[runs.length - 1].w++ : runs.push({ x, y, w: 1 })));
    return runs;
  }).flat();
const sun = disc(9);
const moon = disc(7, true);

let seed = 41;
const rand = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
const stars = Array.from({ length: 80 }, () => ({ x: rand() * 100, y: rand() * 55, big: rand() > 0.9, tw: rand() > 0.6, d: rand() * 3 }));

// Cloud layers: band in the sheet, height in the sky, parallax and wind.
const cloudLayers = [
  { band: 0, top: 4, speed: 0.06, wind: 2 },
  { band: 1, top: 13, speed: 0.12, wind: 4 },
  { band: 2, top: 24, speed: 0.22, wind: 7 },
];

// Fireworks for the checkpoint: bursts placed around the sky.
const bursts = [
  { x: 18, y: 16, c: '#ffcd75', d: 0 },
  { x: 80, y: 12, c: '#73eff7', d: 0.5 },
  { x: 62, y: 30, c: '#ff6b7f', d: 1.1 },
  { x: 34, y: 28, c: '#a7f070', d: 1.6 },
  { x: 90, y: 34, c: '#b99cff', d: 2.1 },
];

// Overlay sprites, in near-layer art pixels: rows of palette keys, merged into runs.
type Run = { x: number; y: number; w: number; fill: string };
const px = (rows: string[], pal: Record<string, string>, ox = 0, oy = 0): Run[] =>
  rows.flatMap((row, y) => {
    const runs: Run[] = [];
    [...row].forEach((k, x) => {
      const fill = pal[k];
      if (!fill) return;
      const last = runs[runs.length - 1];
      if (last && last.fill === fill && last.x + last.w === ox + x) last.w++;
      else runs.push({ x: ox + x, y: oy + y, w: 1, fill });
    });
    return runs;
  });
/** Pixel text in the art's 3×5 font (W is wider), one pixel between glyphs. */
const label = (str: string, fill: string, ox: number, oy: number) => {
  let x = ox;
  return [...str].flatMap((ch) => {
    const glyph = (FONT as Record<string, string[]>)[ch];
    const runs = px(glyph.map((r) => r.replace(/1/g, '#').replace(/0/g, '.')), { '#': fill }, x, oy);
    x += glyph[0].length + 1;
    return runs;
  });
};

const cableCar = px(['..RRRRRRRRRR..', '.RCCCCCCCCCCR.', 'RRWWBWWBWWBWRR', 'RRWWBWWBWWBWRR', 'RRRRRRRRRRRRRR', 'CCCCCCCCCCCCCC', '.KK........KK.'], {
  R: '#9a2f2a',
  C: '#f4ecdc',
  W: '#ffe9a8',
  B: '#29366f',
  K: '#141026',
});
const bell = px(['.Y.', 'YYY'], { Y: '#ffcd75' }, 6, -2);
const hotAir = px(
  ['...RRYRR...', '..RRYYYRR..', '.RRYYYYYRR.', '.RRYYYYYRR.', '.RRYYYYYRR.', '..RRYYYRR..', '...RRYRR...', '....R.R....', '....KKK....', '....KKK....'],
  { R: '#e43b44', Y: '#ffcd75', K: '#8a5a3c' },
);
// Game-day balloons: big enough to read, each on a string.
const balloon = px(['.RRR.', 'RRWRR', 'RRRWR', 'RRRRR', 'RRRRR', '.RRR.', '..R..', '..S..', '...S.', '..S..'], { R: '#e43b44', W: '#ff9aa2', S: '#e9e0f0' });
const balloons = Array.from({ length: 16 }, (_, i) => ({ x: 1290 + ((i * 41) % 104), d: ((i * 0.61) % 6).toFixed(2), y: 92 + ((i * 5) % 9) }));
// A hiker with a hat, a pack and two strides.
const hikerTop = px(['.HHH..', 'HHHHH.', '.SSS..', '.SSSP.', 'RRRRPP', 'RRRRPP', 'SRRRP.', '.RRR..', '.LLL..'], { H: '#c9a26b', S: '#f2c4a2', R: '#e43b44', P: '#3b5dc9', L: '#24305a' });
const hikerA = px(['.L.L..', 'L...L.', 'B...B.'], { L: '#24305a', B: '#3d2a28' }, 0, 9);
const hikerB = px(['.LL...', '.LL...', '.BB...'], { L: '#24305a', B: '#3d2a28' }, 0, 9);
// Pickleball players, paddle up and paddle down.
const player = (shirt: string) => {
  const pal = { H: '#5c3a2e', S: '#f2c4a2', T: shirt, W: '#f4ecdc', P: '#3d2f4a', B: '#e9e0f0', L: '#d39a78' };
  const body = px(['..HHH....', '.HHHHS...', '.HSSSS...', '..SSS....', '.TTTTT...', 'TTTTTT...', 'TTTTTT...', '.TTTTT...', '.WWWWW...', '.WW.WW...', '.LL..LL..', '.LL..LL..', '.SS..SS..', '.SS..SS..', 'BBB..BBB.'], pal);
  const up = px(['.......PP', '......PPP', '.....SPP.', '....SS...'], pal, 0, 3);
  const down = px(['.....SS..', '......SP.', '......PPP', '.......PP'], pal, 0, 6);
  return { body, up, down };
};
const players = [
  { x: 2520, ...player('#e43b44'), flip: false },
  { x: 2553, ...player('#ffcd75'), flip: true },
];
// Sandhill cranes over the Platte: long necks out, legs trailing.
const craneUp = px(['.....GG......', '....GG.......', 'RGGGGGGGGGLLL'], { G: '#566c86', R: '#e43b44', L: '#3d4a62' });
const craneDown = px(['.............', '.............', 'RGGGGGGGGGLLL', '....GG.......', '.....GG......'], { G: '#566c86', R: '#e43b44', L: '#3d4a62' });
const craneFlock = [0, 14, 28, 7, 21, 35].map((dx, i) => ({ x: 96 + dx * 2, y: 52 + [0, 5, 1, 10, 7, 3][i] }));
// Gulls over Carmel Bay, and a peregrine falcon circling the Capitol.
const gullUp = px(['W.....W', '.W...W.', '..WGW..'], { W: '#f4ecdc', G: '#94a0c2' });
const gullDown = px(['.......', '..WGW..', 'WW...WW'], { W: '#f4ecdc', G: '#94a0c2' });
const gulls = [
  { x: 2724, y: 98, t: 11 },
  { x: 2810, y: 92, t: 14 },
  { x: 2856, y: 104, t: 9 },
];
const falconUp = px(['K...K', '.KKK.'], { K: '#3d2f4a' });
const falconDown = px(['.....', 'KKKKK'], { K: '#3d2f4a' });
// A cyclist on the Bob Kerrey bridge.
const cyclist = px(['....H....', '...HS....', '...CC....', '..CCCS...', '...CPPKK.', '.KK.P.KK.', 'K..KPK..K', '.KK...KK.'], { H: '#ffcd75', S: '#f2c4a2', C: '#38b764', P: '#24305a', K: '#141026' });
// New Yorkers out walking: a top half and two leg frames each, facing right.
const walkerPal = (hair: string, coat: string, pants: string) => ({ H: hair, S: '#f2c4a2', s: '#c88a6a', C: coat, P: pants, B: '#141026', R: '#e43b44', Y: '#ffe9a8' });
const person = (pal: Record<string, string>, extra: Record<number, string> = {}) => ({
  top: px(
    ['..HHH..', '.HHHHS.', '.HSSSS.', '..SSSS.', '..SSS..', '.CCCCC.', 'CCCCCCC', 'CCCCCCC', 'SCCCCCS', '.CCCCC.', '.CCCCC.', '.PPPPP.'].map((r, i) => extra[i] ?? r),
    pal,
  ),
  a: px(['.PP.PP.', '.PP..PP', 'PP...PP', 'PP....P', 'P.....P', 'BB....B'], pal, 0, 12),
  b: px(['..PPP..', '..PPP..', '..PP...', '..PP...', '..PP...', '.BBB...'], pal, 0, 12),
});
const people = [
  { from: 3064, to: 3176, t: 15, ...person(walkerPal('#3d2a28', '#29366f', '#3d3858')) },
  { from: 3192, to: 3372, t: 19, ...person(walkerPal('#8a5a3c', '#b8405e', '#24305a'), { 8: 'SCCCCCR', 9: '.CCCCRR', 10: '.CCCCRR' }) },
  { from: 3442, to: 3640, t: 17, ...person(walkerPal('#141026', '#2f8a5a', '#566c86'), { 7: 'CCCCCCY', 8: 'SCCCCCY' }) },
  { from: 3744, to: 3962, t: 21, ...person(walkerPal('#e0c088', '#c9bfd9', '#3d2f66')) },
];
const dog = { a: px(['K.....', 'KKKKKK', '.K..K.'], { K: '#8a5a3c' }, 10, 15), b: px(['K.....', 'KKKKKK', 'K....K'], { K: '#8a5a3c' }, 10, 15) };
const pigeonUp = px(['.GG.', 'GGGG', '.KK.'], { G: '#94a0c2', K: '#566c86' });
const pigeonDown = px(['....', 'GGGG', 'GKK.'], { G: '#94a0c2', K: '#566c86' });
const train = [0, 1, 2].flatMap((car) =>
  px(['SSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSS.', 'SWWWSWWWSWWWDSWWWSWWWSWWWSDWWWSWWWSWWS.', 'SWWWSWWWSWWWDSWWWSWWWSWWWSDWWWSWWWSWWS.', 'SSSSSSSSSSSSDSSSSSSSSSSSSSDSSSSSSSSSSS.', 'SPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPS.', '.KK..............................KK...'], {
    S: '#c9cfe0',
    W: '#ffe9a8',
    D: '#94a0c2',
    P: '#7a2a3a',
    K: '#141026',
  }).map((p) => ({ ...p, x: p.x + car * 38, y: p.y + G + 4 })),
);
// Waves rolling in to the beach at Pebble Beach.
const crest = px(['...WWW...', '.WWBBBWW.', 'WB.....BW'], { W: '#ffffff', B: '#94d4f7' });
const waves = [
  { x: 2704, d: 0 },
  { x: 2722, d: 1.4 },
  { x: 2738, d: 2.6 },
];
// The big red N, waving in two frames.
const nRows = ['NN....NN', '.NN...N.', '.NNN..N.', '.N.NN.N.', '.N..NNN.', '.N...NN.', 'NNN...N.'];
const nFlag = (k: number) =>
  Array.from({ length: 16 }, (_, c) => {
    const dy = Math.round(Math.sin(c / 2.6 + k * Math.PI) * (c / 16) * 1.6);
    const col = nRows.map((r) => r[c - 4] ?? '.');
    return [
      { x: 1469 + c, y: 97 + dy, w: 1, h: 12, fill: c % 5 === 4 ? '#c8303a' : '#e43b44' },
      ...col.flatMap((k2, j) => (k2 === 'N' ? [{ x: 1469 + c, y: 99 + dy + j, w: 1, h: 1, fill: '#fdf6e3' }] : [])),
    ];
  }).flat();
const bigN = px(['NNN....NNN', '.NNN....N.', '.NNNN...N.', '.N.NNN..N.', '.N..NNN.N.', '.N...NNNN.', '.N....NNN.', 'NNN....NN.'], { N: '#e43b44' }, 1314, 51);
const crowd = Array.from({ length: 46 }, (_, i) => {
  const y = 81 + ((i * 7) % 24);
  const x0 = Math.ceil(1288 + ((106 - y) * 14) / 26);
  return { x: x0 + ((i * 37) % (1394 - x0)), y, d: ((i * 0.43) % 2).toFixed(2), c: i % 3 ? '#fdf6e3' : '#ffcd75' };
});
const fog = [
  { x: 2254, y: 136, w: 40 },
  { x: 2298, y: 141, w: 54 },
  { x: 2358, y: 134, w: 46 },
  { x: 2408, y: 140, w: 60 },
  { x: 2466, y: 135, w: 44 },
  { x: 2312, y: 112, w: 34 },
  { x: 2380, y: 100, w: 42 },
  { x: 2440, y: 118, w: 30 },
  { x: 2272, y: 92, w: 26 },
];
const roadFog = [
  { x: 4286, y: 146, w: 56 },
  { x: 4318, y: 136, w: 70 },
  { x: 4340, y: 152, w: 60 },
  { x: 4300, y: 126, w: 44 },
];
const twinkle = (n: number, x0: number, x1: number, y0: number, y1: number, k: number) =>
  Array.from({ length: n }, (_, i) => ({ x: x0 + ((i * 53 + k) % (x1 - x0)), y: y0 + ((i * 29 + k) % (y1 - y0)), d: ((i * 0.37 + k) % 3).toFixed(2) }));
const glints = {
  platte: twinkle(12, 6, 150, 139, 151, 5),
  missouri: twinkle(10, 1540, 1730, 126, 150, 3),
  bay: twinkle(10, 2290, 2490, G + 6, G + 13, 7),
  pacific: twinkle(14, 2712, 2896, 115, 120, 2),
};
const officeLights = Array.from({ length: 12 }, (_, i) => ({ x: 3281 + ((i * 4) % 10) * 9, y: 66 + ((i * 3) % 5) * 10, d: (i * 0.7) % 5 }));
const walkupWindows = [
  [3658, 102],
  [3700, 102],
  [3672, 114],
  [3714, 114],
  [3686, 126],
  [3658, 138],
  [3714, 138],
];
// 7 WTC's floors light up at the checkpoint, from just above MSCI's sign over the lobby.
const floors = Array.from({ length: 21 }, (_, i) => ({ y: 110 - i * 4, i }));
const steam = [0, 1, 2, 3];
const neon = [...'OPEN'].flatMap((ch, i) =>
  ({ O: ['111', '101', '101', '101', '111'], P: ['111', '101', '111', '100', '100'], E: ['111', '100', '110', '100', '111'], N: ['101', '111', '111', '111', '101'] })[ch]!.flatMap((row, y) =>
    [...row].flatMap((b, x) => (b === '1' ? [{ x: 3789 + i * 4 + x, y: 141 + y }] : [])),
  ),
);
const pct = (x: number) => ((x - camera.start) / (camera.end - camera.start)) * 100;
---

<section id="journey" class="journey section" aria-labelledby="journey-title" data-journey data-config={JSON.stringify(config)}>
  <header class="wrap section-head">
    <span class="num">02</span>
    <h2 id="journey-title">The road so far</h2>
    <p>From a Kearney front yard to 7 World Trade Center, so far. One street at a time.</p>
  </header>

  <div class="track" data-track>
    <div
      class="stage"
      data-stage
      style={`--nw:${NW};--fw:${FW};--h:${H};--feet:${feet};--ww:${WK.w};--wh:${WK.h};--wf:${WK.frames};--vw:${vehicleSheet.w};--vh:${vehicleSheet.h};--lane-far:${lanes.far};--lane-near:${lanes.near}`}
    >
      <div class="sky" aria-hidden="true">
        <div class="sky-layer morning"></div>
        <div class="sky-layer day" data-sky></div>
        <div class="sky-layer golden" data-sky></div>
        <div class="sky-layer night" data-sky></div>
        <div class="stars">
          {stars.map((s) => <i class:list={{ big: s.big, tw: s.tw }} style={`left:${s.x.toFixed(1)}%;top:${s.y.toFixed(1)}%;animation-delay:${-s.d.toFixed(2)}s`} />)}
        </div>
        <div class="rays" data-rays></div>
        <svg class="sun" data-sun viewBox="0 0 18 18" shape-rendering="crispEdges">
          {sun.map((p) => <rect x={p.x} y={p.y} width={p.w} height="1" />)}
        </svg>
        <svg class="moon" data-moon viewBox="0 0 14 14" shape-rendering="crispEdges">
          {moon.map((p) => <rect x={p.x} y={p.y} width={p.w} height="1" />)}
        </svg>
        {
          cloudLayers.map((c) => (
            <>
              <div class="clouds" data-cloud data-speed={c.speed} data-wind={c.wind} style={`top:${c.top}%;--band:${c.band}`} />
              <div class="clouds dusk" data-cloud data-speed={c.speed} data-wind={c.wind} style={`top:${c.top}%;--band:${c.band + 3}`} />
            </>
          ))
        }
        <div class="flock f1">{[0, 1, 2, 3, 4].map((i) => <i style={`--i:${i}`} />)}</div>
        <div class="flock f2">{[0, 1, 2].map((i) => <i style={`--i:${i}`} />)}</div>
        <div class="plane"><i class="trail"></i><i class="jet"></i></div>
        <div class="fireworks">
          {
            bursts.map((b) => (
              <div class="burst" style={`left:${b.x}%;top:${b.y}%;--c:${b.c}`}>
                {Array.from({ length: 12 }, (_, i) => (
                  <i style={`--a:${i * 30}deg;animation-delay:${b.d}s`} />
                ))}
              </div>
            ))
          }
        </div>
      </div>

      <div
        class="viewport"
        role="img"
        aria-label="A pixel-art street from Kearney, Nebraska, past Kearney High, Cash-Wa and a Buckle store, under the Archway, through Lincoln and Omaha past Covisum, across San Francisco past Three Bridge and the Golden Gate to Pebble Beach, then New York: Union Square and the Vantager office, the Flatiron, a walk-up and 7 World Trade Center with MSCI's sign, where a sign points on down the road to the next chapter."
      >
        <div class="layer far" data-far>
          <img src="/art/journey-far.png" width={FW} height={H} alt="" loading="lazy" decoding="async" />
        </div>
        <div class="layer near" data-near>
          <img src="/art/journey-near.png" width={NW} height={H} alt="" loading="lazy" decoding="async" />
          <svg class="fx" viewBox={`0 0 ${NW} ${H}`} shape-rendering="crispEdges" aria-hidden="true">
            <defs>
              <clipPath id="road-sky-lincoln"><rect x="1284" y="0" width="176" height="104" /></clipPath>
              <clipPath id="road-bowl"><polygon points="1288,106 1302,80 1396,80 1396,106" /></clipPath>
              <clipPath id="road-tunnel"><rect x="3060" y={G + 2} width="1320" height={H - G - 2} /></clipPath>
              <g id="road-balloon">{balloon.map((r) => <rect x={r.x} y={r.y} width={r.w} height="1" fill={r.fill} />)}</g>
              <g id="road-gull-up">{gullUp.map((r) => <rect x={r.x} y={r.y} width={r.w} height="1" fill={r.fill} />)}</g>
              <g id="road-gull-down">{gullDown.map((r) => <rect x={r.x} y={r.y} width={r.w} height="1" fill={r.fill} />)}</g>
              <g id="road-crest">{crest.map((r) => <rect x={r.x} y={r.y} width={r.w} height="1" fill={r.fill} />)}</g>
            </defs>

            <!-- Kearney: a hot-air balloon, cranes over the Platte, the windmill, the KHS flag. -->
            <g class="zone" data-from="0" data-to="1000">
              <g class="hot-air">{hotAir.map((r) => <rect x={r.x + 470} y={r.y + 30} width={r.w} height="1" fill={r.fill} />)}</g>
              <g class="cranes">
                {
                  craneFlock.map((b) => (
                    <g transform={`translate(${b.x} ${b.y})`}>
                      <g class="frame-a">{craneUp.map((r) => <rect x={r.x} y={r.y} width={r.w} height="1" fill={r.fill} />)}</g>
                      <g class="frame-b">{craneDown.map((r) => <rect x={r.x} y={r.y} width={r.w} height="1" fill={r.fill} />)}</g>
                    </g>
                  ))
                }
              </g>
              {glints.platte.map((s) => <rect class="glint" x={s.x} y={s.y} width="3" height="1" fill="#fff3c4" style={`animation-delay:-${s.d}s`} />)}
              <g class="blades">
                {[0, 45, 90, 135].map((deg) => <rect x="245" y="85.4" width="22" height="1.2" fill="#3d4a62" transform={`rotate(${deg} 256 86)`} />)}
                <rect x="255" y="85" width="2" height="2" fill="#94a0c2" />
              </g>
              <g class="frame-a">
                <rect x="623" y="70" width="12" height="8" fill="#e43b44" />
                {[71, 73, 75, 77].map((y) => <rect x="623" y={y} width="12" height="1" fill="#fdf6e3" />)}
                <rect x="623" y="70" width="5" height="4" fill="#29366f" />
              </g>
              <g class="frame-b">
                <rect x="623" y="71" width="11" height="8" fill="#e43b44" />
                {[72, 74, 76, 78].map((y) => <rect x="623" y={y} width="11" height="1" fill="#fdf6e3" />)}
                <rect x="623" y="71" width="5" height="4" fill="#29366f" />
              </g>
              {[[797, 58], [797, 122], [975, 74], [975, 138]].map(([x, y], i) => <rect class="glint slow" x={x} y={y} width="6" height="4" fill="#fff3c4" style={`animation-delay:-${i * 0.8}s`} />)}
            </g>

            <!-- Lincoln on game day: a falcon over the Capitol, lights, the crowd, the board, the balloons. -->
            <g class="zone" data-from="1000" data-to="1500">
              <g class="falcon-x">
                <g class="falcon-y">
                  <g class="frame-a">{falconUp.map((r) => <rect x={r.x + 1130} y={r.y + 40} width={r.w} height="1" fill={r.fill} />)}</g>
                  <g class="frame-b">{falconDown.map((r) => <rect x={r.x + 1130} y={r.y + 40} width={r.w} height="1" fill={r.fill} />)}</g>
                </g>
              </g>
              {Array.from({ length: 18 }, (_, i) => <rect class="bulb" x={1194 + i * 4} y="100" width="1" height="1" fill="#ffe9a8" style={`animation-delay:${-(i % 5) * 0.3}s`} />)}
              {[[1282, 46, 10, 3], [1401, 45, 7, 3], [1423, 45, 7, 3], [1445, 45, 7, 3]].map(([x, y, w, h], i) => <rect class="lamp" x={x} y={y} width={w} height={h} fill="#fff3c4" style={`animation-delay:-${i * 0.15}s`} />)}
              {crowd.map((c) => <rect class="fan" x={c.x} y={c.y} width="1" height="1" fill={c.c} style={`animation-delay:-${c.d}s`} />)}
              <g clip-path="url(#road-bowl)">
                <g class="crowd-wave">
                  {Array.from({ length: 13 }, (_, i) => <rect x={i % 2} y={80 + i * 2} width="3" height="1" fill="#fdf6e3" />)}
