---
// Crafted items: each personal project with an illustrated screen of what it does,
// a link to its own page (/projects/<id>), and the GitHub repo wall underneath.
import BuildScreen from './BuildScreen.astro';
import GitHubWall from './GitHubWall.astro';
import Icon from './Icon.astro';
import { builds } from '../data/profile';

const host = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const repoUrl = (b: (typeof builds)[number]) => (b.repo?.visibility === 'public' ? `https://github.com/charliebrockmeier/${b.repo.name}` : null);
// Live sites only: a public repo is already shown next to them.
const siteLinks = (b: (typeof builds)[number]) => (b.links ?? []).filter((l) => l.url !== repoUrl(b));
---

<section id="builds" class="section wrap" aria-labelledby="builds-title">
  <header class="section-head">
    <span class="num">06</span>
    <h2 id="builds-title">Crafted items</h2>
    <p>Personal projects, built on nights and weekends.</p>
  </header>

  <ul class="grid" role="list">
    {
      builds.map((b) => (
        <li class="build panel">
          <a class="shot" href={`/projects/${b.id}`} tabindex="-1" aria-hidden="true">
            <BuildScreen id={b.id} />
          </a>

          <div class="info">
            <p class="meta">
              <span class="status pixel">{b.status}</span>
              {siteLinks(b).map((l) => (
                <a class="site-link" href={l.url}>
                  {host(l.url)} ↗
                </a>
              ))}
              {b.repo && (
                <span class="repo">
                  <Icon name={b.repo.visibility === 'public' ? 'github' : 'lock'} color="gray" scale={1.25} />
                  {b.repo.visibility === 'public' ? <a href={repoUrl(b)!}>{b.repo.name}</a> : <span>{b.repo.name} · private</span>}
                </span>
              )}
            </p>
            <h3 class="pixel">
              <a href={`/projects/${b.id}`}>{b.name}</a>
            </h3>
            <p class="line">{b.line}</p>
            {b.stats && (
              <dl class="stats">
                {b.stats.map(([k, v]) => (
                  <div>
                    <dd class="pixel">{v}</dd>
                    <dt>{k}</dt>
                  </div>
                ))}
              </dl>
            )}
            <details>
              <summary class="pixel">How it works</summary>
              <p>{b.detail}</p>
            </details>
            <a class="open pixel" href={`/projects/${b.id}`}>
              Open project page<span class="visually-hidden">: {b.name}</span> →
            </a>
          </div>
        </li>
      ))
    }
  </ul>

  <GitHubWall />
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-s);
  }

  .build {
    display: grid;
    grid-template-rows: auto 1fr;
    padding: var(--space-xs);
  }

  .shot {
    display: block;
    transition: filter 120ms steps(2);
  }

  .shot:hover {
    filter: brightness(1.12);
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: var(--space-s) var(--space-xs) var(--space-xs);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem 0.75rem;
    font-size: 0.75rem;
  }

  .status {
    padding: 0 0.45em;
    background: var(--panel-2);
    color: var(--teal);
    font-size: var(--label);
  }

  .site-link {
    color: var(--teal);
    font-size: 0.75rem;
  }

  .repo {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--ink-soft);
  }

  h3 {
    font-size: var(--step-2);
    line-height: 1;
  }

  h3 a {
    color: inherit;
  }

  .line {
    font-size: var(--step--1);
  }

  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    margin-block: 0.2rem;
  }

  .stats div {
    display: flex;
    flex-direction: column-reverse;
  }

  .stats dd {
    color: var(--gold);
    font-size: var(--step-2);
    line-height: 1;
    font-size-adjust: cap-height 0.7;
  }

  .stats dt {
    color: var(--ink-soft);
    font-size: 0.6875rem;
  }

  .stack {
    color: var(--ink-soft);
    font-size: 0.75rem;
  }

  summary {
    color: var(--gold);
    cursor: pointer;
    font-size: var(--label);
  }

  details p {
    margin-top: 0.3rem;
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  .open {
    align-self: flex-start;
    margin-top: auto;
    padding-top: 0.4rem;
    color: var(--teal);
    font-size: var(--step-1);
    font-size-adjust: cap-height 0.7;
  }

  @media (max-width: 899px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
